# make sure we have the required qore version
%requires qore >= 3.0
%requires(reexport) SftpPollerUtil
%requires(reexport) ssh2 >= 2.1

%modern

%allow-weak-references

%requires DataProvider >= 3.13

module SftpPoller {
    version = "1.6";
    desc = "SftpPoller module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the data provider factory
        DataProvider::registerFactory(new SftpPollerDataProviderFactory());

        # register the data provider application
        # NOTE: this application is also registed in the SftpPoller module
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": SftpPoller::AppName,
            "presentation_source_locale": "en",
            "display_name": "SFTP Server",
            "short_desc": "Generic SFTP server for exchanging files with SFTP",
            "desc": "Generic SFTP server for exchanging files with SFTP",
            "groups": (DataProvider::AppGroup::FileTransfer,),
            "scheme": "sftp",
            "logo": SftpWhiteLogo,
            "logo_file_name": "generic-sftp-logo.svg",
            "logo_mime_type": MimeTypeSvg,
        });

        # register all supported actions
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": SftpPoller::AppName,
            "path": "/",
            "action": "sftp-file-event",
            "display_name": "SFTP file received",
            "subtype": "sftppoller",
            "short_desc": "A file is uploaded to an SFTP server",
            "desc": "React to files uploaded to an SFTP server; the action configuration determines if the event "
                "contains the file data itself or a link to the location of the file on the local filesystem. In any "
                "case, the event indicates that the file data has already been downloaded and is available locally. "
                "Set remote_file_disposition to DELETE or MOVE to remove the remote file after processing. With NONE, "
                "the handler must move, rename or delete the file, or it will be delivered again on the next poll.",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_SFTP_FILE,
            "output_type": SftpPollerFileEventInfoDataType,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                SftpPollerDataProviderBase::ConstructorOptions{"mask",} - ("url"), {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                SftpPollerDataProviderBase::ConstructorOptions - ("mask", "url")
            ),
        });
    };
    # PROCESS_CONTROL: its init registers data provider factory (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage SftpPoller Module

    @section sftppollerintro SftpPoller Module Introduction

    The SftpPoller module implements an abstract class that will poll a remote directory with the SFTP protocol and return
    matching files.

    To use this class, subclass the @ref SftpPoller::SftpPoller "SftpPoller" class and implement the @ref SftpPoller::SftpPoller::singleFileEvent() and
    @ref SftpPoller::SftpPoller::postSingleFileEvent() methods.

    @section sftppollerexamples SftpPoller Module Examples

    This poller prints file metadata and requests a stop after processing a batch of matching files.
    Supply the connection URL through the first command-line argument.
    @code{.py}
%modern
%requires ssh2
%requires SftpPoller

class IncomingFilePoller inherits SftpPoller::SftpPoller {
    constructor(SSH2::SFTPClient client, hash<auto> options) : SftpPoller::SftpPoller(client, options) {
    }

    nothing singleFileEvent(hash<SftpPoller::SftpPollerFileEventInfo> file) {
        printf("Received %y\n", file - "data");
        stopNoWait();
    }

    nothing postSingleFileEvent(hash<SftpPoller::SftpPollerFileEventInfo> file) {
    }
}

SSH2::SFTPClient client(ARGV[0]);
IncomingFilePoller poller(client, {"path": "/incoming"});
poller.start();
poller.waitStop();
    @endcode

    Note that @ref SftpPoller::SftpPoller::stopNoWait() "SftpPoller::stopNoWait()" is called in the event thread because calling
    @ref SftpPoller::SftpPoller::stop() "SftpPoller::stop()" in the event thread would cause an exception to be thrown.

    A useful poller class would implement the @ref SftpPoller::SftpPoller::singleFileEvent() "SftpPoller::singleFileEvent()" method which process already-transferred files and the @ref SftpPoller::SftpPoller::postSingleFileEvent() "SftpPoller::postSingleFileEvent()" by deleting / moving / renaming the files so that they would not be acquired on the next poll.

    @section sftppollererrors SftpPoller Errors and Retries

    An @ref SftpPoller::SftpPoller "SftpPoller" handles errors while polling as follows:
    - an SFTP error while files are listed or transferred is logged, and the poll is retried after the
      \c "error_delay" option's delay (default: one minute)
    - an error raised while a polled file is handled, by
      @ref SftpPoller::SftpPoller::singleFileEvent() "SftpPoller::singleFileEvent()" or by an observer of an
      @ref SftpPoller::SftpPollerDataProvider "SftpPollerDataProvider" that refuses or fails to handle the file event,
      is logged, the remote file is kept, and the poll is retried after the \c "error_delay" option's delay, so the
      file is handled again
    - an error after a file was handled, in
      @ref SftpPoller::SftpPoller::postSingleFileEvent() "SftpPoller::postSingleFileEvent()" or while the remote file
      is deleted or moved, stops polling, as continuing could handle the file more than once

    @section sftpollersandbox SftpPoller Module in Sandboxed Programs

    The @ref SftpPoller::SftpPoller "SftpPoller" class includes support for running in sandboxed Program objects with the following parse options set:
    - \c PO_NO_THREAD_CONTROL: in this case the \c "start_thread" option is required in @ref SftpPoller::SftpPoller::constructor() "SftpPoller::constructor()"
    - \c PO_NO_PROCESS_CONTROL: in this case the \c "sleep" option is required in @ref SftpPoller::SftpPoller::constructor() "SftpPoller::constructor()" when the module is loaded by its path; the installed module declares the \c PROCESS_CONTROL functional domain (it registers data provider types and waits between polls), so a Program restricted like a Qorus interface does not need the option
    - \c PO_NO_FILESYSTEM: the local paths given in the \c "keyfile", \c "known_hosts" and \c "local_dir" options
      are refused with \c PERMISSION-DENIED, as is the local path of
      @ref SftpPoller::SftpPoller::getStoreFile() "getStoreFile()"; a poller that the host creates with its paths and
      lends to such code keeps them, but the local path given to @ref SftpPoller::SftpPoller::getStoreFile()
      "getStoreFile()" is refused for that code too

    @anchor sftppollerrelnotes

    @subpage sftppollerreleasenotes
*/

/** @page sftppollerreleasenotes SftpPoller Release Notes

    @section sftppollerv1_6 Version 1.6
    - the poller data providers report \c supports_refusal_redelivery in their provider info, as a file that an
      observer refuses stays on the server and is handled again
      (<a href="https://github.com/qoretechnologies/qore/issues/7563">qore issue 7563</a>)
    - the data providers' action, option and field names are in sentence case
      (<a href="https://github.com/qoretechnologies/qore/issues/7749">qore issue 7749</a>)
    - the \c keyfile option is refused with \c PERMISSION-DENIED when the code that creates the poller is restricted
      from the file system, and @ref SftpPoller::SftpPoller::getStoreFile() "getStoreFile()" refuses a local path
      given by such code, also by the code that a host-created poller was lent to
      (<a href="https://github.com/qoretechnologies/module-ssh2/issues/128">issue 128</a>)
    - Added opt-in verified acquisition from dedicated publication directories.
    - an error raised while a polled file is handled (ex: an observer that refuses the file event) is logged, the
      remote file is kept, and the poll is retried after the \c "error_delay" option's delay; previously polling
      stopped (see @ref sftppollererrors;
      <a href="https://github.com/qoretechnologies/qore/issues/6400">qore issue 6400</a>)
    - an SFTP error transferring a file after the first file of a poll is retried after the \c "error_delay"
      option's delay like any other SFTP error; it stopped polling
    - added the \c "error_delay" option for the delay before a poll is retried after an error (default: one minute,
      the previous fixed delay), and @ref SftpPoller::SftpPoller::stop() "stop()" and
      @ref SftpPoller::SftpPoller::stopNoWait() "stopNoWait()" end a wait between polls at once (without a
      \c "sleep" closure); a stop waited for the end of the wait
      (<a href="https://github.com/qoretechnologies/module-ssh2/issues/116">issue 116</a>)
    - added data provider and app action support
    - corrected the source-owned provider presentation catalog so it contains the SFTP poller action without
      duplicating actions contributed by the SFTP client module
    - requires Qore 3.0 (module domains)
    - an empty \c "regex_mask" option matches every file; it caused the constructor to throw an
      \c INVALID-MEMBER exception
      (<a href="https://github.com/qoretechnologies/qore/issues/3377">issue 3377</a>)

    @section sftppollerv1_4_1 Version 1.4.1
    - fixed a bug registering the sftp event type
      (<a href="https://github.com/qoretechnologies/qore/issues/4389">issue 4389</a>)

    @section sftppollerv1_3_0 Version 1.3.0
    - added support for data provider APIs

    @section sftppollerv1_0 Version 1.0
    - initial release
*/

#! main SftpPoller namespace
public namespace SftpPoller {
#! Generic SFTP server app name
public const AppName = "SFTP";

#! SFTP file event constant
public const EVENT_SFTP_FILE = "sftp-file-event";

#! SftpPoller client class implementation
/** See the @ref constructor options for information on how to configure this object; note that either
    - \c delete_remote_file or
    - \c move_remote_file
    must be set, or SFTP files polled will remain where they are in the remote SFTP server, unless they are removed or
    moved during polling processing.

    Only one of these options may be set at one time; setting both will result in an error
*/
public class SftpPoller {
    public {
        #! ascending sort order
        const OrderAsc = 0;
        #! descending sort order
        const OrderDesc = 1;

        #! no sorting
        const SortNone = 0;
        #! sort by name
        const SortName = 1;
        #const SortDate = 2;

        #! minimum required keys for all constructors
        const RequiredKeys = (
%ifdef PO_NO_PROCESS_CONTROL
            "sleep",
%endif
%ifdef PO_NO_THREAD_CONTROL
            "start_thread",
%endif
        );

        #! RequiredKeys for the constructor(hash) without an @ref Qore::SSH2::SFTPClient argument
        const RequiredKeysWithHost = RequiredKeys + "host";

        #! default values for constructor hash argument
        const Defaults = {
            "port": 22,
            "mask": "*",
            "poll_interval": 10,
            "reopts": 0,
            "timeout": 30s,
            "binary": False,
            "writable": False,
            "check_file": "qore-sftp-check-file",
            "tempfile_template": ".tmp.%s.part",
            "atomic_transfer": False,
            "error_delay": ErrorDelaySeconds,
        };

        #! optional constructor hash keys
        const OptionalKeys = (
            "path", "user", "pass", "keyfile", "regex_mask", "minage", "encoding", "log_info", "log_detail",
            "known_hosts", "host_key_policy", "verify_host_key", "use_agent", "keepalive_interval",
            "log_debug", "binary", "delete_remote_file", "move_remote_file",
%ifndef PO_NO_PROCESS_CONTROL
            "sleep",
%endif
%ifndef PO_NO_THREAD_CONTROL
            "start_thread",
%endif
            "skip_file_content_retrieval", "commit_profile", "host_key_sha256",
        );

        #! all keys
        const AllKeys = RequiredKeysWithHost + Defaults.keys() + OptionalKeys;

        #! the default delay before a poll is retried after an error (see the \c "error_delay" option)
        const ErrorDelay = 1m;

        #! the default delay in seconds before a poll is retried after an error (see the \c "error_delay" option)
        const ErrorDelaySeconds = 60;
    }

    private {
        #! host or address name
        string host;

        #! port
        int port;

        #! user
        string user;

        #! url
        string url;

        #! password; one of \c "pass" or \c "keyfile" *must* be set
        *string pass;

        #! path to the ssh private key in PEM format; one of \c "pass" or \c "keyfile" *must* be set
        *string keyfile;

        #! path to an OpenSSH known_hosts file for host key verification
        *string known_hosts;

        #! the policy for unknown host keys (\c "reject", \c "tofu" or \c "tofu-session")
        *string host_key_policy;

        #! enables host key verification against the known_hosts file
        *bool verify_host_key;

        #! enables SSH agent authentication
        *bool use_agent;

        #! keepalive interval in seconds; 0 disables keepalive
        *int keepalive_interval;

        #! path(s) to poll
        softlist<string> path = ".";

        #! path after connect to SFTP server
        string rootSftpPath;

        #! file glob name mask (ignored if \c "regex_mask" also set)
        *string mask;

        #! poll interval in seconds
        int poll_interval;

        #! the delay in seconds before a poll is retried after an error (see @ref sftppollererrors)
        int error_delay = ErrorDelaySeconds;

        #! sleep mutex for the condition-based wait between polls
        Qore::Thread::Mutex sleep_m();

        #! sleep condition, signaled when polling is stopped
        Qore::Thread::Condition sleep_cond();

        #! Local directory to transfer file
        string local_dir;
        *string commit_profile;
        *string host_key_sha256;

        #! The temporary filename template when \c local_dir is set
        string tempfile_template;

        #! Atomic transfer flag for use with \c local_dir
        bool atomic_transfer;

        #! Delete file on remote SFTP server after processing?
        /** This cannot be True while move_remote_file is set
        */
        bool delete_remote_file;

        #! Remote target directory for moving the file on the remote SFTP server after processing
        /** This cannot be True while delete_remote_file is set
        */
        *string move_remote_file;

        #! run flag
        bool runflag = False;

        #! internal "get files" flag
        bool get_files;

        #! internal flag: True while singleFileEvent() handles a file (see @ref sftppollererrors)
        bool in_event;

        #! internal fatal error flag
        bool fatal = False;

        #! internal poll counter
        int pollcnt = 0;

        #! start mutex
        Mutex m();

        #! polling tid
        int tid;

        #! timeout in ms
        timeout timeout;

        #! stop counter
        Counter sc();

        #! SFTPClient object
        Qore::SSH2::SFTPClient sftp;

        #! file matching regex options
        int reopts = 0;

        #! minimum file age
        *softint minage;

        #! file encoding for text files
        *string encoding;

        #! optional info log closure
        *code log_info;

        #! optional detail log closure
        *code log_detail;

        #! optional debug log closure
        *code log_debug;

        #! optional start thread closure
        *code start_thread;

        #! optional sleep closure
        *code sleep;

        #! binary transfer flag (for singleFileEvent())
        bool binary;

        #! chech if path is writable for others in constructor
        bool writable;

        #! name of check writable file
        string check_file;

        #! whether or not to skip the file content retrieval in runOnce()
        *bool skip_file_content_retrieval;

        #! For when the client gets updating during polling
        SFTPClient new_sftp;
    }

    #! creates the SftpPoller object from the @ref Qore::SSH2::SFTPClient "SFTPClient" argument and configuration hash argument passed
    /** @param sftp the new @ref Qore::SSH2::SFTPClient "SFTPClient" object
        @param nconf a hash with the following optional keys:
        - \c commit_profile: opt in to hosted-immutable or openssh-sha256-name. Configure one absolute committed
          directory in path and an existing local_dir. Each callback receives a verified receipt.
        - \c host_key_sha256: lowercase SHA-256 fingerprint of the qualified host key, required for hosted-immutable
        - \c atomic_transfer: if @ref True and \c local_dir is set, then \c tempfile_template is used to write SFTP
          files to a temporary filename during transfer
        - \c binary: if set to @ref Qore::True "True" then files are transferred in binary mode by default (with
          singleFileEvent() usage only), otherwise file data is returned in text format
        - \c check_file: name of a check file. The file will be created and deleted in the path to test if path is
          writable. If the file alrady exists, it will be deleted. (default: \c "qore-sftp-check-file")
        - \c delete_remote_file: if @ref True then the remote file is deleted on the SFTP server after processing.
          Cannot be set if \c move_remote_file is also set
        - \c encoding: the encoding for any text files received
        - \c local_dir: a local directory to use to transfer remote files so large file data does not appear in events
        - \c log_info: a @ref closure "closure" or @ref call_reference "call reference" for logging important
          information; must accept a single string giving the log message
        - \c log_detail: a @ref closure "closure" or @ref call_reference "call reference" for logging detailed
          information; must accept a single string giving the log message
        - \c log_debug: a @ref closure "closure" or @ref call_reference "call reference" for logging verbose
          debgugging information; must accept a single string giving the log message
        - \c error_delay: the delay in seconds before the poll is retried after an SFTP error or an error handling
          a polled file (see @ref sftppollererrors; default: 60 seconds; must be > 0 if given)
        - \c poll_interval: the integer polling interval in seconds (default: 10 seconds; must be > 0 if given)
        - \c mask: the file glob mask to use (default: \c "*", ignored if \c "regex_mask" is also present)
        - \c minage: the minimum file age in seconds before a file will be acquired (default: 0)
        - \c move_remote_file: the remote target directory on the SFTP server where files will be moved to after
          processing; cannot be set if \c delete_remote_file is also set
        - \c path: the remote path(s) for retrieving the files; if a list of strings is given then each path will be
          polled for matching files according to the \c "mask" or \c "regex_mask" option
        - \c regex_mask: a regular expression to use as a mask (overrides any \c "mask" value); an empty string
          matches every file
        - \c reopts: regular expression match options (ex RE_Caseless for case-insensitive matches)
        - \c skip_file_content_retrieval: if True then @ref SftpPoller::SftpPoller::singleFileEvent and
          @ref SftpPoller::SftpPoller::postSingleFileEvent methods won't get 'data' member of the input hash, i.e. the
          file content won't be read by the SftpPoller class, opening a space for child classes to implement their own
          file retrieval in @ref SftpPoller::SftpPoller::singleFileEvent or
          @ref SftpPoller::SftpPoller::postSingleFileEvent (default: False); (since ssh2 1.1)
        - \c start_thread: (required when imported into a context where @ref Qore::PO_NO_THREAD_CONTROL is set) a
          @ref closure "closure" or @ref call_reference "call reference" for starting threads; must return the integer
          thread ID (if not set then @ref background will be used)
        - \c sleep: (required when the module is loaded by its path into a context where @ref Qore::PO_NO_PROCESS_CONTROL is set; the installed module declares \c PROCESS_CONTROL) a
          @ref closure "closure" or @ref call_reference "call reference" to use instead of @ref Qore::sleep() (if not
          set then a wait that a stop ends at once is used); it is called with 1 (second) at a time until the wait
          ends or polling is stopped, so it must really sleep (since SftpPoller 1.5)
        - \c timeout: connection timeout (default \c 30s)
        - \c writable: check if path(s) is/are writable  (default: False see also the \c "check_file" option)
        - \c tempfile_template: (used when \c local_dir and \c atomic_transfer are set) the temporary filename prefix
          to use when transferring files to the local directory specified by \c local_dir; use \c "%s" as the
          placeholder for the target filename

        @note Either \c delete_remote_file or \c move_remote_file must be set, or SFTP files polled will remain where
        they are in the remote SFTP server, unless they are removed or moved during polling processing. Only one of
        these options may be set at one time; setting both will result in an error

        @throw PERMISSION-DENIED a \c keyfile, \c known_hosts or \c local_dir path is given and the creating code is
        restricted from the \c FILESYSTEM functional domain
        @throw SFTPPOLLER-CONSTRUCTOR-ARG-ERROR missing required key, invalid port, poll_interval or error_delay
        given
        @throw SFTPCLIENT-PARAMETER-ERROR empty hostname passed
        @throw SOCKET-CONNECT-ERROR error establishing socket connection (no listener, port blocked, etc); timeout
        establishing socket connection
        @throw SSH2CLIENT-CONNECT-ERROR no user name set; ssh2 or libssh2 error
        @throw SSH2-ERROR error initializing or establishing ssh2 session
        @throw SSH2CLIENT-AUTH-ERROR no proper authentication method found
        @throw SFTPCLIENT-CONNECT-ERROR error initializing sftp session or getting remote path
    */
    constructor(Qore::SSH2::SFTPClient sftp, hash<auto> nconf) {
        # create hash of keys with only valid options in argument hash
        hash<auto> conf = Defaults + nconf{AllKeys};
        # the local paths are the creator's: refused before they are used or anything is transferred
        SftpPoller::checkCreatorPaths(nconf);
        if (exists conf.commit_profile) {
            conf.local_dir = nconf.local_dir;
            validateCommitOptions(conf);
        }

        foreach string k in (RequiredKeys) {
            if (!exists conf{k})
                throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("required key %y missing from constructor hash "
                    "argument)", k);
        }

        if (exists conf.local_dir && (!is_dir(conf.local_dir) || !is_writable(conf.local_dir))) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("Invalid local directory %y; directory does not exist "
                "or cannot be written to", conf.local_dir);
        }

        conf.poll_interval = int(conf.poll_interval);

        if (conf.poll_interval <= 0) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("poll_interval cannot be <= 0 (val: %d)",
                conf.poll_interval);
        }

        conf.error_delay = int(conf.error_delay);
        if (conf.error_delay <= 0) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("error_delay cannot be <= 0 (val: %d)",
                conf.error_delay);
        }

        if (conf.delete_remote_file && conf.move_remote_file.val()) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("delete_remote_file is set along with move_remote_file "
                "(%y); only one of these can be set at one time", conf.move_remote_file);
        }

        bool re = False;
        # an empty regex_mask is a regex that matches every file; it must be removed from the options in any case
        if (conf.hasKey("regex_mask")) {
            *string regex_mask = remove conf.regex_mask;
            if (exists regex_mask) {
                mask = regex_mask;
                re = True;
                conf -= "mask";
            }
        }

        # set options
        self += conf;

        # set regex for mask if regex_mask was not already used
        if (!re) {
            setMask();
        }

        if (mask) {
            logDetail("%s: file regex mask: %s", url, mask);
        }

        if (conf.delete_remote_file) {
            logDetail("%s: remote files will be deleted after processing", url);
        } else if (conf.move_remote_file.val()) {
            logDetail("%s: remote files will be moved using %y after processing", url, conf.move_remote_file);
        }

        setup(sftp);
    }

    #! creates the SftpPoller object from the configuration hash argument passed
    /** @param nconf a hash with the following keys:
        - \c commit_profile: opt in to hosted-immutable or openssh-sha256-name. Configure one absolute committed
          directory in path and an existing local_dir. Each callback receives a verified receipt.
        - \c host_key_sha256: lowercase SHA-256 fingerprint of the qualified host key, required for hosted-immutable
        - \c atomic_transfer: if @ref True and \c local_dir is set, then \c tempfile_template is used to write SFTP
          files to a temporary filename during transfer
        - \c binary: if set to @ref Qore::True "True" then files are transferred in binary mode by default (with
          singleFileEvent() usage only), otherwise file data is returned in text format
        - \c check_file: name of a check file. The file will be created and deleted in the path to test if path is
          writable. If the file alrady exists, it will be deleted. (default: \c "qore-sftp-check-file")
        - \c delete_remote_file: if @ref True then the remote file is deleted on the SFTP server after processing.
          Cannot be set if \c move_remote_file is also set
        - \c encoding: the encoding for any text files received
        - \c host: (required) the hostname or address to connect to
        - \c host_key_policy: the policy for unknown host keys: \c "reject", \c "tofu" or \c "tofu-session" (see
          @ref applyClientOptions())
        - \c keepalive_interval: the keepalive interval in seconds; 0 disables keepalive
        - \c keyfile: the SSH key (file and path to it)
        - \c known_hosts: the path to an OpenSSH known_hosts file for host key verification
        - \c local_dir: a local directory to use to transfer remote files so large file data does not appear in events
        - \c log_info: a @ref closure "closure" or @ref call_reference "call reference" for logging important
          information; must accept a single string giving the log message
        - \c log_detail: a @ref closure "closure" or @ref call_reference "call reference" for logging detailed
          information; must accept a single string giving the log message
        - \c log_debug: a @ref closure "closure" or @ref call_reference "call reference" for logging verbose
          debgugging information; must accept a single string giving the log message
        - \c error_delay: the delay in seconds before the poll is retried after an SFTP error or an error handling
          a polled file (see @ref sftppollererrors; default: 60 seconds; must be > 0 if given)
        - \c poll_interval: the integer polling interval in seconds (default: 10 seconds; must be > 0 if given)
        - \c mask: the file glob mask to use (default: \c "*", ignored if \c "regex_mask" is also present)
        - \c minage: the minimum file age in seconds before a file will be acquired (default: 0)
        - \c move_remote_file: the remote target directory on the SFTP server where files will be moved to after
          processing; cannot be set if \c delete_remote_file is also set
        - \c pass: the password to use for the connection
        - \c path: the remote path(s) for retrieving the files; if a list of strings is given then each path will be
          polled for matching files according to the \c "mask" or \c "regex_mask" option
        - \c port: the integer port number to connect to (default 22; must be > 0 if given)
        - \c regex_mask: a regular expression to use as a mask (overrides any \c "mask" value); an empty string
          matches every file
        - \c reopts: regular expression match options (ex RE_Caseless for case-insensitive matches)
        - \c skip_file_content_retrieval: if True then @ref SftpPoller::SftpPoller::singleFileEvent and
          @ref SftpPoller::SftpPoller::postSingleFileEvent methods won't get 'data' member of the input hash, i.e. the
          file content won't be read by the SftpPoller class, opening a space for child classes to implement their own
          file retrieval in @ref SftpPoller::SftpPoller::singleFileEvent or
          @ref SftpPoller::SftpPoller::postSingleFileEvent (default: False); (since ssh2 1.1)
        - \c sleep: (required when the module is loaded by its path into a context where @ref Qore::PO_NO_PROCESS_CONTROL is set; the installed module declares \c PROCESS_CONTROL) a
          @ref closure "closure" or @ref call_reference "call reference" to use instead of @ref Qore::sleep() (if not
          set then a wait that a stop ends at once is used); it is called with 1 (second) at a time until the wait
          ends or polling is stopped, so it must really sleep (since SftpPoller 1.5)
        - \c start_thread: (required when imported into a context where @ref Qore::PO_NO_THREAD_CONTROL is set) a
          @ref closure "closure" or @ref call_reference "call reference" for starting threads; must return the integer
          thread ID (if not set then @ref background will be used)
        - \c timeout: connection timeout (default \c 30s)
        - \c use_agent: enables SSH agent authentication (see @ref applyClientOptions())
        - \c verify_host_key: enables host key verification against the known_hosts file (see
          @ref applyClientOptions())
        - \c user: the username to use for the connection
        - \c writable: check if path(s) is/are writable  (default: False see also the \c "check_file" option)
        - \c tempfile_template: (used when \c local_dir and \c atomic_transfer are set) the temporary filename prefix
          to use when transferring files to the local directory specified by \c local_dir; use \c "%s" as the
          placeholder for the target filename

        @throw PERMISSION-DENIED a \c keyfile, \c known_hosts or \c local_dir path is given and the creating code is
        restricted from the \c FILESYSTEM functional domain
        @throw SFTPPOLLER-CONSTRUCTOR-ARG-ERROR missing required key, invalid port, poll_interval or error_delay
        given
        @throw SFTPCLIENT-PARAMETER-ERROR empty hostname passed
        @throw SOCKET-CONNECT-ERROR error establishing socket connection (no listener, port blocked, etc); timeout
        establishing socket connection
        @throw SSH2CLIENT-CONNECT-ERROR no user name set; ssh2 or libssh2 error
        @throw SSH2-ERROR error initializing or establishing ssh2 session
        @throw SSH2CLIENT-AUTH-ERROR no proper authentication method found
        @throw SFTPCLIENT-CONNECT-ERROR error initializing sftp session or getting remote path
    */
    constructor(hash<auto> nconf) {
        # create hash of keys with only valid options in argument hash
        hash<auto> conf = Defaults + nconf{AllKeys};
        # the local paths are the creator's: refused before they are used or anything is transferred
        SftpPoller::checkCreatorPaths(nconf);
        if (exists conf.commit_profile) {
            conf.local_dir = nconf.local_dir;
            validateCommitOptions(conf);
        }

        foreach string k in (RequiredKeysWithHost) {
            if (!exists conf{k})
                throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("required key %y missing from constructor hash "
                    "argument)", k);
        }

        conf.poll_interval = int(conf.poll_interval);
        conf.port = int(conf.port);

        if (conf.poll_interval <= 0)
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("poll_interval cannot be <= 0 (val: %d)",
                conf.poll_interval);
        conf.error_delay = int(conf.error_delay);
        if (conf.error_delay <= 0) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("error_delay cannot be <= 0 (val: %d)",
                conf.error_delay);
        }
        if (conf.port <= 0)
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("port cannot be <= 0 (val: %d)", conf.port);

        if (conf.delete_remote_file && conf.move_remote_file.val()) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", sprintf("delete_remote_file is set along with move_remote_file "
                "(%y); only one of these can be set at one time", conf.move_remote_file);
        }

        bool re = False;
        # an empty regex_mask is a regex that matches every file; it must be removed from the options in any case
        if (conf.hasKey("regex_mask")) {
            *string regex_mask = remove conf.regex_mask;
            if (exists regex_mask) {
                mask = regex_mask;
                re = True;
                conf -= "mask";
            }
        }

        # set options
        self += conf;

        # set regex for mask if regex_mask was not already used
        if (!re) {
            setMask();
        }

        # create SFTPClient object
        SFTPClient sftp(host, port);
        if (user) {
            sftp.setUser(user);
        }
        if (pass) {
            sftp.setPassword(pass);
        }
        if (keyfile) {
            sftp.setKeys(keyfile);
        }
        applyClientOptions(sftp, conf);

        url = sprintf("%s@%s:%d", user ? user : "<none>", host, port);

        if (mask) {
            logDetail("%s: file regex mask: %s", url, mask);
        }

        if (conf.delete_remote_file) {
            logDetail("%s: remote files will be deleted after processing", url);
        } else if (conf.move_remote_file.val()) {
            logDetail("%s: remote files will be moved using %y after processing", url, conf.move_remote_file);
        }

        setup(sftp);
    }

    private static nothing validateCommitOptions(hash<auto> conf) {
        softlist<string> dirs = conf.path ?? ".";
        if ((conf.commit_profile != "hosted-immutable" && conf.commit_profile != "openssh-sha256-name")
                || dirs.size() != 1 || !dirs[0].startsWith("/") || dirs[0].find("//") >= 0
                || dirs[0].find("/../") >= 0 || dirs[0].find("/./") >= 0
                || dirs[0].endsWith("/..") || dirs[0].endsWith("/.")
                || (dirs[0] != "/" && dirs[0].endsWith("/"))
                || !conf.local_dir || !absolute_path(conf.local_dir)
                || !is_dir(conf.local_dir) || !is_writable(conf.local_dir)
                || conf.skip_file_content_retrieval || conf.delete_remote_file || conf.move_remote_file
                || conf.writable) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", "Strict polling requires one absolute committed directory, "
                "an absolute writable local directory and remote files retained after acquisition";
        }
        if (conf.commit_profile == "hosted-immutable" && (dirs[0] != "/inbound"
                || !conf.host_key_sha256 || conf.host_key_sha256 !~ /^[a-f0-9]{64}$/)) {
            throw "SFTPPOLLER-CONSTRUCTOR-ARG-ERROR", "Hosted immutable polling requires /inbound and a pinned host key";
        }
    }

    #! stops the polling operation if in progress and destroys the object
    destructor() {
        # if the object is being destroyed in the polling thread itself (for example because the last
        # object reference was held by an event or log callback), then we cannot wait for the polling
        # thread to terminate or we would deadlock; just signal the poll loop to exit in this case
        if (gettid() == tid) {
            stopNoWait();
            return;
        }
        stop();
    }

    #! applies the host key, agent and keepalive options to an SFTP client
    /** The options are the ones of the connection that the poller connects with: the client is configured as a
        client of an SFTP connection or of the SFTP client data provider is, so host keys are verified (or not) on the
        poller path as the connection says

        @param sftp the client to configure
        @param options a hash that can have the following keys (the others are ignored):
        - \c known_hosts: the path to an OpenSSH known_hosts file (environment variables can be prefixed with \c '$');
          an empty string configures no known_hosts file; if not set, the default of the \c ssh2 module applies
        - \c host_key_policy: the policy for unknown host keys: \c "reject", \c "tofu" or \c "tofu-session"
        - \c verify_host_key: enables host key verification against the known_hosts file
        - \c use_agent: enables SSH agent authentication
        - \c keepalive_interval: the keepalive interval in seconds; 0 disables keepalive

        @throw OPTION-VALUE-ERROR invalid \c host_key_policy value
    */
    static applyClientOptions(SFTPClient sftp, hash<auto> options) {
        if (options.known_hosts.val()) {
            SftpPoller::checkCreatorFileAccess("the 'known_hosts' option");
        }
        if (exists options.known_hosts) {
            sftp.setKnownHostsFile(substitute_env_vars(options.known_hosts));
        }
        if (exists options.host_key_policy) {
            sftp.setHostKeyPolicy(SftpPoller::getHostKeyPolicy(options.host_key_policy));
        }
        if (exists options.verify_host_key) {
            sftp.setVerifyHostKey(options.verify_host_key);
        }
        if (exists options.use_agent) {
            sftp.setUseAgent(options.use_agent);
        }
        if (exists options.keepalive_interval) {
            sftp.setKeepalive(options.keepalive_interval);
        }
    }

    #! refuses the local paths of the options if the code that creates the poller is restricted from the file system
    /** @throw PERMISSION-DENIED a \c local_dir, \c keyfile or \c known_hosts path is given and the creating code is
        restricted from the \c FILESYSTEM functional domain
    */
    private static checkCreatorPaths(hash<auto> conf) {
        foreach string opt in (("local_dir", "keyfile", "known_hosts")) {
            if (conf{opt}.val()) {
                SftpPoller::checkCreatorFileAccess(sprintf("the %y option", opt));
            }
        }
    }

    #! refuses a local path given when the poller is created if the creating code is restricted from the file system
    /** The creating code is judged as by @ref Qore::SandboxManager::isCallerRestricted()
        "SandboxManager::isCallerRestricted()", so a poller that a method of an object that the host lent creates with
        the paths that the host gave keeps working.  A sandbox's file-system policy applies when the path is opened.

        @throw PERMISSION-DENIED the creating code is restricted from the \c FILESYSTEM functional domain
    */
    private static checkCreatorFileAccess(string what) {
        if (SandboxManager::isCallerRestricted(DOM_FILESYSTEM)) {
            throw "PERMISSION-DENIED", sprintf("%s cannot be used: the calling code is restricted from the FILESYSTEM "
                "functional domain", what);
        }
    }

    #! returns the host key policy for the value of a \c host_key_policy option
    /** @throw OPTION-VALUE-ERROR invalid \c host_key_policy value
    */
    static enum<Ssh2HostKeyPolicy> getHostKeyPolicy(string policy) {
        switch (policy) {
            case "reject":
                return Ssh2HostKeyPolicy::Reject;
            case "tofu":
                return Ssh2HostKeyPolicy::TrustOnFirstUse;
            case "tofu-session":
                return Ssh2HostKeyPolicy::TrustOnFirstUseSession;
        }
        throw "OPTION-VALUE-ERROR", sprintf("invalid host_key_policy option value %y; expected one of %y", policy,
            ("reject", "tofu", "tofu-session"));
    }

    updateOptions(SFTPClient sftp) {
        hash<auto> info += sftp.info();

        string url = sprintf("sftp://%s", info.ssh2host);
        if (info.ssh2port) {
            url += sprintf(":%d", info.ssh2port);
        }
        if (!commit_profile) {
            logDetail("%s: logging in (timeout %y)", url, timeout);
            sftp.connect(timeout);
        }

        self.url = url;

        if (info.ssh2user.val()) {
            user = info.ssh2user;
        } else {
            remove user;
        }
        if ((*string pass = sftp.getPassword()).val()) {
            pass = info.password;
        } else {
            remove pass;
        }
        if (info.keyfile_priv) {
            keyfile = info.keyfile_priv;
        } else {
            remove keyfile;
        }

        new_sftp = sftp;
    }

    #! returns the current poll count
    int getPollCount() {
        return pollcnt;
    }

    #! calls the \c "log_info" @ref closure "closure" or @ref call_reference "call reference" with important information
    private logInfo(string fmt) {
        if (log_info)
            call_function(log_info, vsprintf(fmt, argv));
    }

    #! calls the \c "log_detail" @ref closure "closure" or @ref call_reference "call reference" with detail information
    private logDetail(string fmt) {
        if (log_detail)
            call_function(log_detail, vsprintf(fmt, argv));
    }

    #! calls the \c "log_debug" @ref closure "closure" or @ref call_reference "call reference" with verbose debugging information
    private logDebug(string fmt) {
        if (log_debug)
            call_function(log_debug, vsprintf(fmt, argv));
    }

    #! converts a glob mask into a regex
    private setMask() {
        if (mask == "*") {
            delete mask;
            return;
        }

        # replace . -> \.
        mask =~ s/\./\./g;
        # replace ? -> .
        mask =~ s/\?/./g;
        # replace * -> .*
        mask =~ s/\*/.*/g; #//; # previous comment needed only for broken emacs qore-mode syntax highlighting
        mask = sprintf("^%s$", mask); #");
    }

    #! retrieves a remote file and stores it to a local path
    /** @param remote_path the remote file path
        @param local_path the local file path
        @param n_timeout a timeout in milliseconds

        @return the number of bytes transferred

        @throw PERMISSION-DENIED the calling code (or the code that the poller was lent to) is restricted from the
        \c FILESYSTEM functional domain
    */
    int getStoreFile(string remote_path, string local_path, *timeout n_timeout) {
        # the path is the caller's input: refused before anything is written or transferred
        if (SandboxManager::isLentToRestricted(DOM_FILESYSTEM)) {
            throw "PERMISSION-DENIED", "the local_path argument cannot be used: the calling code is restricted from "
                "the FILESYSTEM functional domain";
        }
        return sftp.retrieveFile(remote_path, local_path, n_timeout ?? timeout);
    }

    #! retrieves a text file and returns the file's contents
    string getTextFile(string path, *timeout n_timeout, *string n_encoding) {
        return sftp.getTextFile(path, n_timeout ?? timeout, n_encoding ?? encoding);
    }

    #! retrieves a binary file and returns the file's contents
    binary getFile(string path, *timeout n_timeout) {
        return sftp.getFile(path, n_timeout ?? timeout);
    }

    #! renames a file on the server
    rename(string old, string nnew, *timeout n_timeout) {
        sftp.rename(old, nnew, n_timeout ?? timeout);
        logInfo("Renamed %y -> %y on the remote host", old, nnew);
    }

    #! deletes a file on the server
    removeFile(string fn, *timeout n_timeout) {
        sftp.removeFile(fn, n_timeout ?? timeout);
        logInfo("%y: deleted on the remote host", fn);
    }

    #! returns information about a remote file (see @ref Qore::SSH2::SFTPClient::stat() for a description of the return format)
    *hash<Qore::SSH2::Ssh2StatInfo> stat(string path, *timeout n_timeout) {
        return sftp.stat(path, n_timeout ?? timeout);
    }

    #! check if a remote path is writable
    /**
        @throw "REMOTE-DIR-ERROR" this exception is thrown if the remote path does not exist, is not a directory, or
        is not not writable
    */
    checkRemotePath(string path, bool write = False, *timeout n_timeout) {
        string apath = rootSftpPath + "/" + path;
        *hash h = stat(apath, n_timeout);
        if (!h)
            throw "REMOTE-DIR-ERROR", sprintf("%s: path does not exist", apath);
        string perms = h.permissions;
        if (perms[0] != "d")
            throw "REMOTE-DIR-ERROR", sprintf("%s: path is not a directory", apath);

        # don't check if the path is writable
        if (!write)
            return;

        try {
            string f = apath + "/" + check_file;
            if (!stat(f, n_timeout)) {
                string content = "This is a qore test file for checking whether the sftp path is writable. This file "
                    "can be deleted with no worries.";
                sftp.putFile(content, f, 0644, n_timeout);
            }
            sftp.removeFile(f, n_timeout);
        } catch (hash<ExceptionInfo> ex) {
            throw "REMOTE-DIR-ERROR", sprintf("%y: path is not writable. %s: %s", apath, ex.err, ex.desc);
        }
    }

    #! returns a list of regular file hashes matching any file name mask set for the object
    /** @param sort the sort option for the list returned
        @param order the ordering of sorted data returned

        @return a list of regular file hashes with the following keys in each list element:
        - \c name: the name of the file, link, or directory
        - \c size: the size of the file in bytes
        - \c uid: the UID of the owner of the file
        - \c gid: the GID of the owner of the file
        - \c mode: the permissions / mode of the file
        - \c atime: the last accessed date/time of the file
        - \c mtime: the last modified date/time of the file
        - \c type: the type of file is always \c "REGULAR"
        - \c perm: a string giving UNIX-style permissions for the file (ex: "-rwxr-xr-x")
    */
    list<hash<SftpPollerFileEventInfo>> getFiles(int sort = SftpPoller::SortNone, int order = SftpPoller::OrderAsc) {
        list<hash<SftpPollerFileEventInfo>> l =
            map cast<hash<SftpPollerFileEventInfo>>($1),
                (commit_profile ? sftp.listExchangeDirectory(path[0], commit_profile == "hosted-immutable"
                    ? "hosted-immutable" : "openssh-posix", host_key_sha256, timeout) : sftp.listFull(NOTHING, timeout)),
                $1.type == "REGULAR";

        if (commit_profile) {
            l = select l, eligibleCommittedName($1.name);
        }

        # remove all files that don't fit the mask
        if (mask) {
            list<hash<SftpPollerFileEventInfo>> n = ();
            foreach hash<SftpPollerFileEventInfo> h in (l) {
                if (regex(h.name, mask, reopts)) {
                    n += h;
                }
            }
            l = n;
        }

        # remove all files that aren't old enough
        if (minage) {
            date now = Qore::now();
            list<hash<SftpPollerFileEventInfo>> n = ();
            foreach hash<SftpPollerFileEventInfo> h in (l) {
                if ((now - h.mtime).durationSeconds() < minage) {
                    logDebug("file %y is not old enough (minage: %d, current age: %d)", h.name, minage, (now - h.mtime).durationSeconds());
                    continue;
                }
                n += h;
            }
            l = n;
        }

        # return list of files
        switch (sort) {
            case SftpPoller::SortNone: {
                break;
            }

            # sort by file name
            case SftpPoller::SortName: {
                # sort closure
                code sort_func = int sub (hash<SftpPollerFileEventInfo> l, hash<SftpPollerFileEventInfo> r) {
                    return l.name <=> r.name;
                };
                l = (order == SftpPoller::OrderAsc ? Qore::sort(l, sort_func) : Qore::sort_descending(l, sort_func));
                break;
            }

            # it *never* should get here
            default: throw "SFTPPOLLER-GETFILES", sprintf("Unknown sort mode %y", sort);
        }

        logDetail("%s: polled %d matching file%s", url, l.size(), l.size() == 1 ? "" : "s");
        return l;
    }

    #! starts polling in the background; returns the thread ID of the polling thread
    /** if polling had already been started, then the thread ID of the polling thread is
        returned immediately
    */
    int start() {
        m.lock();
        on_exit m.unlock();

        if (runflag)
            return tid;

        sc.waitForZero();

        runflag = True;
        sc.inc();

%ifdef PO_NO_THREAD_CONTROL
        return tid = call_function(start_thread, \run());
%else
        return tid = (start_thread ? call_function(start_thread, \run()) : background run());
%endif
    }

    #! stops the polling operation, returns immediately
    /** @see stop()
    */
    stopNoWait() {
        m.lock();
        on_exit m.unlock();

        stopIntern();
    }

    #! stops the polling operation, returns when the polling operation has been stopped
    /** if polling was not in progress then this method returns immediately

        @throw THREAD-ERROR this exception is thrown if this method is called from the event thread since it would result in a deadlock

        @see stopNoWait()
    */
    stop() {
        if (gettid() == tid && sc.getCount())
            throw "THREAD-ERROR", sprintf("cannot call SftpPoller::stop() from the event thread (%d)", tid);
        m.lock();
        on_exit m.unlock();

        stopIntern();

        sc.waitForZero();
    }

    #! clears the run flag and wakes the polling thread from a wait between polls
    private stopIntern() {
        AutoLock al(sleep_m);
        runflag = False;
        sleep_cond.broadcast();
    }

    #! waits indefinitely for the polling operation to stop; if polling was not in progress then this method returns immediately
    /**
        @throw THREAD-ERROR this exception is thrown if this method is called from the event thread since it would result in a deadlock
    */
    waitStop() {
        if (gettid() == tid)
            throw "THREAD-ERROR", sprintf("cannot call SftpPoller::waitStop() from the event thread (%d)", tid);
        sc.waitForZero();
    }

    #! starts the polling operation inline (not in a background thread)
    /**
        @throw SFTPPOLLER-ERROR this exception is thrown if polling is already in progress
    */
    startInline() {
        {
            m.lock();
            on_exit m.unlock();

            if (runflag)
                throw "SFTPPOLLER-ERROR", sprintf("the polling thread is already running in TID %d", tid);

            runflag = True;
            tid = gettid();
        }
        sc.inc();
        run();
    }

    #! runs a single poll (useful for checking for errors inline before starting a background thread)
    bool runOnce() {
        ++pollcnt;
        if (commit_profile) {
            return pollCommitted();
        }
        bool ret = False;
        foreach string subdir in (path) {
            get_files = True;
            in_event = False;
            if (path.size() != 1) {
                sftp.chdir(rootSftpPath);
                sftp.chdir(subdir);
                logInfo("Current SFTPClient path is %s", sftp.path());
            }
            list<hash<SftpPollerFileEventInfo>> files = getFiles();

            if (files) {
                logDetail("got new files in %y: %y", path, files);

                if (fileEvent(files)) {
                    foreach hash<SftpPollerFileEventInfo> fh in (files) {
                        # an error transferring any file is an SFTP error, after which the poll is retried
                        get_files = True;
                        fh.filepath = subdir == "." ? fh.name : (subdir + "/" + fh.name);
                        if (skip_file_content_retrieval) {
                            logInfo("%y: skipping retrieval of file data based on the poller configuration", fh.name);
                        } else {
                            if (local_dir) {
                                if (atomic_transfer) {
                                    fh = retrieveTempFile(fh);
                                } else {
                                    fh = retrieveFile(fh);
                                }
                            } else {
                                fh = getRemoteFileData(fh);
                            }
                        }

                        get_files = False;

                        # an error raised by the event handler (ex: an observer that refuses the event) leaves the
                        # remote file in place, and the poll is retried after the error delay
                        # (qoretechnologies/qore#6400)
                        in_event = True;
                        singleFileEvent(fh);
                        # make sure any errors after this point cause the polling operation to stop
                        in_event = False;

                        # set the "fatal" flag if an exception is thrown in postSingleFileEvent()
                        on_error fatal = True;

                        if (delete_remote_file) {
                            removeFile(fh.name);
                            fh.remote_status = RS_DELETED;
                        } else if (move_remote_file.val()) {
                            string remote_target = sprintf(move_remote_file, fh.name);
                            rename(fh.name, remote_target);
                            fh.remote_status = RS_MOVED;
                        } else {
                            fh.remote_status = RS_NONE;
                        }

                        postSingleFileEvent(fh);
                    }
                }
                ret = True;
            }
        }
        return ret;
    }

    private bool eligibleCommittedName(string name) {
        if (!name || name == "." || name == ".." || name.startsWith(".qore-stage-")
                || name.find("/") >= 0 || name.find("\\") >= 0 || name.find(":") >= 0 || name.find("\0") >= 0) {
            return False;
        }
        return commit_profile == "hosted-immutable" || name =~ /^[a-f0-9]{64}\..+$/;
    }

    private bool pollCommitted() {
        get_files = True;
        in_event = False;
        bool emitted = False;
        foreach hash<SftpPollerFileEventInfo> event in (getFiles()) {
            if (!exists event.size) {
                throw "SFTPPOLLER-ACQUISITION-ERROR", sprintf("Endpoint omitted the byte length of %y", event.name);
            }
            bool hosted = commit_profile == "hosted-immutable";
            string remote = (path[0] == "/" ? "" : path[0]) + "/" + event.name;
            string target = local_dir + DirSep + event.name;
            date start = now_us();
            hash<SftpExchangeReceipt> receipt = sftp.acquireVerified(<SftpExchangeSpec>{
                "profile": hosted ? "hosted-immutable" : "openssh-posix",
                "collision_policy": hosted ? "no-replace" : "replace",
                "remote_path": remote, "length": event.size, "host_key_sha256": host_key_sha256,
                "sha256": hosted ? NOTHING : event.name.substr(0, 64),
            }, target, timeout);
            if (receipt.outcome != "confirmed") {
                throw "SFTPPOLLER-ACQUISITION-ERROR", receipt.detail, receipt;
            }
            event += {"filepath": remote, "local_path": target, "transfer_time": now_us() - start,
                "receipt": receipt, "remote_status": RS_NONE};
            if (fileEvent((event,))) {
                get_files = False;
                in_event = True;
                singleFileEvent(event);
                in_event = False;
                {
                    on_error fatal = True;
                    postSingleFileEvent(event);
                }
                emitted = True;
                get_files = True;
            }
        }
        return emitted;
    }

    #! Retrieves remote file data and adds it to the event data
    hash<SftpPollerFileEventInfo> getRemoteFileData(hash<SftpPollerFileEventInfo> event) {
        # get file to binary stream
        OutputStream outstream = self."binary"
            ? new BinaryOutputStream()
            : new StringOutputStream();

        logInfo("Retrieving %y (%d bytes) to memory", event.filepath, event.size);
        date start = now_us();
        sftp.get(event.name, outstream);
        event.transfer_time = now_us() - start;
        logInfo("Retrieved %y in %y", event.filepath, event.transfer_time);

        # write data to event hash
        event += {
            "data": self."binary"
                ? cast<BinaryOutputStream>(outstream).getData()
                : cast<StringOutputStream>(outstream).getData(),
        };
        return event;
    }

    #! Retrieves the remote file to local_dir using a temporary file
    private hash<SftpPollerFileEventInfo> retrieveTempFile(hash<SftpPollerFileEventInfo> event) {
        # add filename
        string tmp_name = sprintf(tempfile_template, event.name);
        string tmp_path = normalize_dir(local_dir + DirSep + tmp_name);
        string local_path = normalize_dir(local_dir + DirSep + event.name);

        logInfo("Using local dir %y to stream %y -> %y (%d bytes)", local_dir, event.filepath,
            tmp_path, event.size);
        date start = now_us();
        if (event.size) {
            # stream remote file to local file
            sftp.retrieveFile(event.name, tmp_path);
        } else {
            File f();
            f.open2(tmp_path, O_CREAT | O_WRONLY | O_TRUNC);
        }

        # move to target filename after transfer to ensure atomicity
        if (tmp_path != local_path) {
            # NOTE: uses a simple rename() which may cause problems on some OSes if moving between filesystems
            Qore::rename(tmp_path, local_path);
            logInfo("Renamed %y -> %y", tmp_path, local_path);
        }

        event += {
            "transfer_time": now_us() - start,
            "local_path": local_path,
        };
        logInfo("Streamed %d byte%s from %y -> %y in %y", event.size, event.size == 1 ? "" : "s", event.filepath,
            local_path, event.transfer_time);
        return event;
    }

    #! Retrieves the remote file to local_dir directly
    private hash<SftpPollerFileEventInfo> retrieveFile(hash<SftpPollerFileEventInfo> event) {
        # add filename
        string local_path = normalize_dir(local_dir + DirSep + event.name);

        logInfo("Using local dir %y to stream %y -> %y (%d bytes)", local_dir, event.filepath, local_path,
            event.size);
        date start = now_us();
        if (event.size) {
            # stream remote file to local file
            sftp.retrieveFile(event.name, local_path);
        } else {
            File f();
            f.open2(local_path, O_CREAT | O_WRONLY | O_TRUNC);
        }

        event += {
            "transfer_time": now_us() - start,
            "local_path": local_path,
        };
        logInfo("Streamed %d byte%s from %y -> %y in %y", event.size, event.size == 1 ? "" : "s", event.filepath,
            local_path, event.transfer_time);
        return event;
    }

    #! waits for the given number of seconds, or until polling is stopped
    /** With a \c "sleep" closure, the closure is called with one second at a time, so that a stop takes effect
        within a second; otherwise the wait is on a condition that stop() and stopNoWait() signal, so that a stop
        takes effect at once
    */
    private sftpSleep(softint secs) {
%ifdef PO_NO_PROCESS_CONTROL
        date end = now_us() + seconds(secs);
        while (runflag) {
            call_function(sleep, 1);
            if (now_us() >= end) {
                break;
            }
        }
%else
        if (sleep) {
            date end = now_us() + seconds(secs);
            while (runflag) {
                call_function(sleep, 1);
                if (now_us() >= end) {
                    break;
                }
            }
        } else {
            # a wait can end before its timeout without a signal, so the deadline is checked
            date end = now_us() + seconds(secs);
            AutoLock al(sleep_m);
            while (runflag) {
                date left = end - now_us();
                if (left <= 0s) {
                    break;
                }
                sleep_cond.wait(sleep_m, left);
            }
        }
%endif
    }

    #! Sets up a new SFTP connection
    private setup(SFTPClient sftp) {
        # connect to the remote system
        hash<auto> ih = sftp.info();
        if (!url) {
            url = sprintf("%s@%s:%d", ih.ssh2user ? ih.ssh2user : "<none>", ih.ssh2host, ih.ssh2port);
        }
        if (commit_profile) {
            self.sftp = sftp;
            return;
        }
        if (!ih.connected) {
            logDetail("%s: logging in (timeout %y)", url, timeout);
            sftp.connect(timeout);
        } else {
            logDetail("%s: already connected: %y", url, ih);
        }
        rootSftpPath = sftp.path();

        if (path && path.size() == 1 && path[0] != ".") {
            logDetail("path is %y", path);
            logInfo("%s: connected; changing directory to %s", url, path[0]);
            # change to the target directory
            sftp.chdir(path[0], timeout);
        } else {
            logInfo("%s: connected", url);
        }

        self.sftp = sftp;
        map checkRemotePath($1, writable), path;
    }

    #! starts the polling operation
    private run() {
        on_exit
            sc.dec();

        while (runflag) {
            try {
                in_event = False;
                if (new_sftp) {
                    logInfo("Continuing polling with an updated SFTP connection");
                    setup(remove new_sftp);
                }
                runOnce();
                if (runflag) {
                    sftpSleep(poll_interval);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (get_files) {
                    logInfo("SFTP error in %y: %s: %s; waiting %ds for next try", path, ex.err, ex.desc,
                        error_delay);
                    if (runflag)
                        sftpSleep(error_delay);
                } else if (in_event) {
                    # the event handler refused or failed to handle the file, which is left in place
                    in_event = False;
                    logInfo("event handler error in %y: %s: %s; the remote file is kept; waiting %ds for next try",
                        path, ex.err, ex.desc, error_delay);
                    if (runflag)
                        sftpSleep(error_delay);
                } else {
                    # error thrown in "post transfer" code
                    logInfo("error in post transfer code; polling terminated: %s: %s", ex.err, ex.desc);
                    rethrow;
                }
            }
        }

        logInfo("polling finished");
    }

    #! called for each poll with a list of all files matched before transfer; if this method returns False or @ref nothing, then the singleFileEvent method is not called
    *bool fileEvent(list<hash<SftpPollerFileEventInfo>> l) {
        return True;
    }

    #! called for each matching file individually whenever matching files are polled with the list of matching file names; if any error occurs here, the error is logged, the remote file is kept, and the poll is retried after the \c "error_delay" option's delay (see @ref sftppollererrors)
    /** @param fih a hash of file data and information with the following keys:
        - \c name: the name of the file, link, or directory
        - \c size: the size of the file in bytes
        - \c uid: the UID of the owner of the file
        - \c gid: the GID of the owner of the file
        - \c mode: the permissions / mode of the file
        - \c atime: the last accessed date/time of the file
        - \c mtime: the last modified date/time of the file
        - \c type: the type of file; one of: \c "REGULAR", \c "DIRECTORY", \c "SYMBOLIC-LINK", \c "BLOCK-DEVICE", \c "CHARACTER-DEVICE", \c "FIFO", \c "SYMBOLIC-LINK", \c "SOCKET", or \c "UNKNOWN"
        - \c perm: a string giving UNIX-style permissions for the file (ex: "-rwxr-xr-x")
        - \c data: the file's data; this will be a string unless the \a "binary" option is set to @ref Qore::True "True", in which case this key is assigned to the files binary data; this hash key is only present if \c skip_file_content_retrieval was @ref Qore::False "False" in the @ref SftpPoller::SftpPoller::constructor options
        - \c filepath: the remote filepath relative to SFTP root directory
    */
    abstract singleFileEvent(hash<SftpPollerFileEventInfo> fih);

    #! called after singleFileEvent() for each matching file individually whenever matching files are polled with the list of matching file names; if any error occurs here, the polling operation stops
    /** This method would normally delete / rename / move files processed by singleFileEvent() so that they would not be polled a second time.
        If an error occurs in this operation, then the polling event will stop since continuing after failing to delete, rename, or move a file already processed
        would cause the file to be processed more than once.

        @param fih a hash of file data and information with the following keys:
        - \c name: the name of the file, link, or directory
        - \c size: the size of the file in bytes
        - \c uid: the UID of the owner of the file
        - \c gid: the GID of the owner of the file
        - \c mode: the permissions / mode of the file
        - \c atime: the last accessed date/time of the file
        - \c mtime: the last modified date/time of the file
        - \c type: the type of file; one of: \c "REGULAR", \c "DIRECTORY", \c "SYMBOLIC-LINK", \c "BLOCK-DEVICE", \c "CHARACTER-DEVICE", \c "FIFO", \c "SYMBOLIC-LINK", \c "SOCKET", or \c "UNKNOWN"
        - \c perm: a string giving UNIX-style permissions for the file (ex: "-rwxr-xr-x")
        - \c data: the file's data; this will be a string unless the \a "binary" option is set to @ref Qore::True "True", in which case this key is assigned to the files binary data; this hash key is only present if \c skip_file_content_retrieval was @ref Qore::False "False" in the @ref SftpPoller::SftpPoller::constructor options
        - \c filepath: the remote filepath relative to SFTP root directory
    */
    abstract postSingleFileEvent(hash<SftpPollerFileEventInfo> fih);

    #! checks a path on the local file system
    /**
        @throw DIR-ERROR this exception is thrown if the local path does not exist, is not readable, is not a directory, or should be writable and is not
    */
    static checkPath(string path, string type, bool write = False) {
        *hash<StatInfo> h = hstat(path);
        if (!h)
            throw "DIR-ERROR", sprintf("%y: %s path does not exist", path, type);
        if (h.type != "DIRECTORY")
            throw "DIR-ERROR", sprintf("%y: %s path is not a directory (%s)", path, type, h.type);

        # check if the directory is readable
        if (!is_readable(path))
            throw "DIR-ERROR", sprintf("%y: %s path is not readable", path, type);

        # check if the directory is writable
        if (write && !is_writable(path))
            throw "DIR-ERROR", sprintf("%y: %s path is not writable", path, type);
    }
}

#! Event-based data provider for SFTP polling events
/** When using the \c local_dir option, the local file must be removed / moved / archived by the event handler
*/
public class SftpPollerDataProviderBase inherits DataProvider::AbstractDataProvider {
    public {
        #! Constructor options
        const ConstructorOptions = {
            "commit_profile": <DataProviderOptionInfo>{
                "display_name": "Publication agreement",
                "short_desc": "Verify committed files before emitting events",
                "desc": "Use a dedicated committed directory and a writable local directory. Hosted files are immutable. "
                    "On OpenSSH the committed name starts with the producer SHA-256 and a dot.",
                "type": AbstractDataProviderTypeMap."string",
                "allowed_values": (
                    <AllowedValueInfo>{"value": "hosted-immutable", "display_name": "Hosted immutable"},
                    <AllowedValueInfo>{"value": "openssh-sha256-name", "display_name": "OpenSSH digest filename"},
                ),
            },
            "host_key_sha256": <DataProviderOptionInfo>{
                "display_name": "Host key SHA-256",
                "short_desc": "Pinned host key fingerprint",
                "desc": "Pinned SSH host key in lowercase hex, required for the hosted profile",
                "type": AbstractDataProviderTypeMap."string",
            },
            "atomic_transfer":  <DataProviderOptionInfo>{
                "display_name": "Atomic file transfer",
                "short_desc": "Use an atomic file transfer mechanism",
                "type": AbstractDataProviderTypeMap."bool",
                "desc": "Use an atomic transfer mechanism with `local_dir` where remote files are first moved to a "
                    "temporary location and then moved to the final location when they have been fully "
                    "transferred.\n\n"
                    "This ensures that files will never be read until they are fully transferred",
                "default_value": True,
            },

            "keyfile": <DataProviderOptionInfo>{
                "display_name": "SSH private key",
                "short_desc": "A path to an SSH private key file in PEM format",
                "type": AbstractDataProviderTypeMap."string",
                "desc": "A path to an SSH private key file in PEM format to use for key-based authentication",
            },

            "known_hosts": <DataProviderOptionInfo>{
                "display_name": "Known hosts file",
                "short_desc": "A path to an OpenSSH known_hosts file for host key verification",
                "type": AbstractDataProviderTypeMap."string",
                "desc": "A path to an OpenSSH known_hosts file for host key verification; environment variables "
                    "can be prefixed with '$' in the path; if set to an empty string, no known_hosts file is "
                    "configured; if not set, the ssh2 module default applies (normally the local user's "
                    "~/.ssh/known_hosts file, unless the embedding application has changed or disabled the "
                    "module default)",
            },

            "host_key_policy": <DataProviderOptionInfo>{
                "display_name": "Host key policy",
                "short_desc": "Policy for unknown host keys",
                "type": AbstractDataProviderTypeMap."string",
                "desc": "Policy for unknown host keys when host-key verification is enabled: `reject` rejects "
                    "unknown keys, `tofu` persists first-use keys to the configured known_hosts file, and "
                    "`tofu-session` trusts unknown keys for the current connection only if no known_hosts file is "
                    "configured",
                "allowed_values": (
                    <AllowedValueInfo>{
                        "display_name": "Reject",
                        "short_desc": "Reject unknown host keys",
                        "desc": "Reject unknown host keys",
                        "value": "reject",
                    },
                    <AllowedValueInfo>{
                        "display_name": "Trust on first use",
                        "short_desc": "Trust unknown host keys on first use and persist them",
                        "desc": "Trust unknown host keys on first use and persist them to the configured known_hosts "
                            "file",
                        "value": "tofu",
                    },
                    <AllowedValueInfo>{
                        "display_name": "Session trust on first use",
                        "short_desc": "Trust unknown host keys for the current connection only when needed",
                        "desc": "Trust unknown host keys for the current connection only if no known_hosts file is "
                            "configured",
                        "value": "tofu-session",
                    },
                ),
                "default_value": "tofu",
            },

            "verify_host_key": <DataProviderOptionInfo>{
                "display_name": "Verify host key",
                "short_desc": "Enable host key verification against the known_hosts file",
                "type": AbstractDataProviderTypeMap."bool",
                "desc": "Enable host key verification against the known_hosts file",
                "default_value": True,
            },

            "use_agent": <DataProviderOptionInfo>{
                "display_name": "Use SSH agent",
                "short_desc": "Enable SSH agent authentication",
                "type": AbstractDataProviderTypeMap."bool",
                "desc": "Enable SSH agent authentication; when enabled, the client will attempt to authenticate "
                    "using keys from the running SSH agent before other methods",
                "default_value": True,
            },

            "keepalive_interval": <DataProviderOptionInfo>{
                "display_name": "Keepalive interval",
                "short_desc": "Keepalive interval in seconds",
                "type": AbstractDataProviderTypeMap."int",
                "desc": "Keepalive interval in seconds; 0 disables keepalive; default: 60",
                "default_value": 60,
            },

            "local_dir": <DataProviderOptionInfo>{
                "display_name": "Local directory",
                "short_desc": "A local directory that will be used to retrieve files",
                "type": AbstractDataProviderType::get(StringType, NOTHING, {
                    DTT_FromFile: True,
                    DTT_FromLocation: True,
                }),
                "desc": "A local directory that will be used to retrieve files",
            },

            "mask": <DataProviderOptionInfo>{
                "display_name": "Glob mask",
                "short_desc": "The glob mask to use to match files to poll",
                "type": AbstractDataProviderTypeMap."string",
                "desc": "The glob mask to use to match files to poll; will be treated as a regex if `regex` is "
                    "`true`",
                "default_value": "*",
            },

            "minage": <DataProviderOptionInfo>{
                "display_name": "Minimum polling age",
                "short_desc": "The minimum age of files to poll in seconds",
                "type": AbstractDataProviderTypeMap."int",
                "desc": "An integer giving the minimum file age in seconds before the file will be polled; this is "
                    "meant to work around non-atomic file transfer operations.\n\n"
                    "If this option is necessary, set it to a value that is larger than the longest time it should "
                    "take to transfer a file",
            },

            "poll_interval": <DataProviderOptionInfo>{
                "display_name": "Poll interval",
                "short_desc": "The poll interval in seconds",
                "type": AbstractDataProviderTypeMap."int",
                "desc": "The interval in seconds between polling for files",
                "default_value": 10,
            },

            "regex": <DataProviderOptionInfo>{
                "display_name": "Regular expression match",
                "short_desc": "If true then the 'mask' argument is treated as a regular expression",
                "type": AbstractDataProviderTypeMap."bool",
                "desc": "If `true` then `mask` is treated as a regular expression instead of a glob pattern",
            },

            "remote_file_disposition": <DataProviderOptionInfo>{
                "display_name": "Remote file disposition",
                "short_desc": "Delete or move remote file after processing?",
                "desc": "Delete or move remote file after processing? If `MOVE`, `remote_file_move_target` must also "
                    "be set",
                "type": AbstractDataProviderTypeMap."string",
                "allowed_values": (
                    <AllowedValueInfo>{
                        "display_name": "DELETE",
                        "short_desc": "Delete the remote file after processing",
                        "desc": "Delete the remote file after processing",
                        "value": "DELETE",
                    },
                    <AllowedValueInfo>{
                        "display_name": "MOVE",
                        "short_desc": "Move the remote file after processing",
                        "desc": "Move the remote file after processing; in this case `remote_file_move_target` must "
                            "be set",
                        "value": "MOVE",
                    },
                    <AllowedValueInfo>{
                        "display_name": "NONE",
                        "short_desc": "Leave the file untouched after processing",
                        "desc": "Leave the file untouched after processing; the file must be moved or deleted "
                            "manually during post-processing, or the file will appear in subsequent polls as well",
                        "value": "NONE",
                    },
                ),
                "default_value": "DELETE",
            },

            "remote_file_move_target": <DataProviderOptionInfo>{
                "display_name": "Remote file move target",
                "short_desc": "The target template for the remote file after processing",
                "desc": "The target template for the remote file after processing; use `%s` for the original file "
                    "name. This option is only used when `remote_file_disposition` is `MOVE`, otherwise it is "
                    "ignored",
                "type": AbstractDataProviderTypeMap."*string",
            },

            "reopt": <DataProviderOptionInfo>{
                "display_name": "Regular expression options",
                "short_desc": "A bitfield of regular expression options",
                "type": AbstractDataProviderTypeMap."int",
                "desc": "A bitfield of regular expression options (`1` = ignore case, `2` = treat EOL as a regular "
                    "character); ignored if `regex` is not `true`",
            },

            "sort_desc": <DataProviderOptionInfo>{
                "display_name": "Sort descending",
                "short_desc": "Sort files in descending order",
                "type": AbstractDataProviderTypeMap."bool",
                "desc": "Sort descending; if not given then an ascending sort is assumed if a `sort_type` is given",
            },

            "sort_type": <DataProviderOptionInfo>{
                "display_name": "Sort type",
                "short_desc": "Field to sort files on",
                "type": AbstractDataProviderTypeMap."string",
                "desc": "Either `name` or `date` for the data to use for sorting",
            },

            "tempfile_template":  <DataProviderOptionInfo>{
                "display_name": "Temporary filename template",
                "short_desc": "The template for temporary filenames",
                "desc": "The template for temporary filenames; use `%s` for the original filename",
                "type": AbstractDataProviderTypeMap."string",
                "default_value": ".tmp.%s.part",
            },

            "url": <DataProviderOptionInfo>{
                "display_name": "SFTP URL",
                "short_desc": "The URL for the SFTP connection",
                "type": AbstractDataProviderTypeMap."string",
                "desc": "A URL for an SFTP connection",
                "required": True,
            },
        };
    }

    private {
        #! The file poller itself
        EmbeddedSftpPoller poller;
    }

    #! Creates the object from constructor options
    constructor(*hash<auto> options) {
        hash<auto> copts = checkOptions("CONSTRUCTOR-ERROR", ConstructorOptions, options);
        string url = remove copts.url;
        hash<UrlInfo> url_info = parse_url(url);

        copts += url_info;
        if (copts.username) {
            copts.user = remove copts.username;
        }
        if (copts.password) {
            copts.pass = remove copts.password;
        }

        bool regex = remove copts.regex ?? False;
        if (!copts.mask) {
            copts.mask = regex ? ".*" : ConstructorOptions.mask.default_value;
        }
        if (*string sort_type = remove copts.sort_type) {
            if (sort_type == "name") {
                copts.sort_type = SftpPoller::SortName;
            #} else if (sort_type == "date") {
            #    copts.sort_type = SftpPoller::SortDate;
            } else {
                throw "CONSTRUCTOR-ERROR", sprintf("expecting \"name\" or \"date\" for the \"sort_type\" option "
                    "value; got %y instead", sort_type);
            }
            if (remove copts.sort_desc) {
                copts.sort_order = SftpPoller::OrderDesc;
            }
        } else {
            remove copts.sort_desc;
        }

        *string move_target = remove copts.remote_file_move_target;
        switch (remove copts.remote_file_disposition) {
            case "DELETE":
                copts.delete_remote_file = True;
                break;
            case "MOVE":
                if (!move_target.val()) {
                    throw "CONSTRUCTOR-ERROR", "If \"remote_file_disposition\" is \"MOVE\", "
                        "\"remote_file_move_target\" must be set as well";
                }
                copts.move_remote_file = move_target;
                break;
        }

        if (regex) {
            copts.regex_mask = remove copts.mask;
        }

        copts.log_info = sub (string msg) {
            info("%s", msg);
        };
        copts.log_detail = sub (string msg) {
            info("%s", msg);
        };
        copts.log_debug = sub (string msg) {
            debug("%s", msg);
        };

        poller = new EmbeddedSftpPoller(self, copts);
    }

    destructor() {
        delete poller;
    }

    string getName() {
        return "sftppoller";
    }

    #! Returns the data provider description
    *string getDesc() {
        return "Provides an event-based SFTP polling source";
    }

    #! Update any connection used by the data provider
    /** @param conn the new AbstractConnection object
        @param connobj the new connection object itself (ex: RestClient for a "rest" connection)
    */
    updateConnectionObjects(object conn, object connobj) {
        if (!(connobj instanceof SFTPClient)) {
            throw "UPDATE-CONNECTION-ERROR", sprintf("Data provider %y requires an \"SFTPClient\" object; got "
                "%y instead", self.className(), connobj.className());
        }
        poller.updateOptions(cast<SFTPClient>(connobj));
    }

    #! Returns a hash of all supported event types
    /** @return a hash of all supported event types

        @note only called if the provider supports the observer pattern / event API
    */
    private hash<string, hash<DataProviderMessageInfo>> getEventTypesImpl() {
        return {
            EVENT_SFTP_FILE: <DataProviderMessageInfo>{
                "desc": "Set remote_file_disposition to DELETE or MOVE to remove the remote file after processing. With NONE, "
                    "the handler must move, rename or delete the file, or it will be delivered again on the next poll.",
                "type": SftpPollerFileEventInfoDataType,
            },
        };
    }
}

#! Event-based data provider for SFTP polling events
/** When using the \c local_dir option, the local file must be removed / moved / archived by the event handler

    The event ID raised for SFTP file events is \c "sftp-file-event" (see @ref EVENT_SFTP_FILE)
*/
public class SftpPollerDataProvider inherits SftpPollerDataProviderBase, DataProvider::Observable {
    public {
        #! Provider info
        const ProviderInfo = <DataProviderInfo>{
            "type": "SftpPollerDataProvider",
            "supports_observable": True,
            "supports_refusal_redelivery": True,
            "constructor_options": ConstructorOptions,
        };
    }

    #! Creates the object from constructor options
    constructor(*hash<auto> options) : SftpPollerDataProviderBase(options) {
        poller.start();
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }
}

#! Event-based data provider for SFTP polling events
/** When using the \c local_dir option, the local file must be removed / moved / archived by the event handler

    The event ID raised for SFTP file events is \c "ftp-file-event" (see @ref EVENT_SFTP_FILE)
*/
public class SftpDelayedPollerDataProvider inherits SftpPollerDataProviderBase, DataProvider::DelayedObservable {
    public {
        #! Provider info
        const ProviderInfo = <DataProviderInfo>{
            "type": "SftpDelayedPollerDataProvider",
            "supports_observable": True,
            "supports_refusal_redelivery": True,
            "constructor_options": ConstructorOptions,
        };
    }

    #! Creates the object from constructor options
    constructor(*hash<auto> options) : SftpPollerDataProviderBase(options) {
    }

    #! Called when all observers have been added to the object
    /** This method is meant to trigger event generation
    */
    observersReady() {
        poller.start();
    }

    #! Called to stop generating events
    /** Disconnects from the server and stops polling
    */
    stopEvents() {
        poller.stop();
    }

    private hash<DataProviderInfo> getStaticInfoImpl() {
        return ProviderInfo;
    }
}

#! The SFTP poller data provider factory
public class SftpPollerDataProviderFactory inherits AbstractDataProviderFactory {
    private {
        #! Data provider type info
        static Class cls = new Class("SftpDelayedPollerDataProvider");

        #! Factory info
        const FactoryInfo = <DataProviderFactoryInfo>{
            "name": "sftppoller",
            "desc": "SFTP poller data provider factory",
            "children_can_support_observers": True,
        };
    }

    #! Returns static factory information without \a provider_info
    /** @return static factory information without \a provider_info which is provided by
        @ref DataProvider::AbstractDataProviderFactory::getProviderInfo()
    */
    private hash<DataProviderFactoryInfo> getInfoImpl() {
        return FactoryInfo;
    }

    #! Returns static provider information
    /** @note the \c name and \c children attributes are not returned as they are dynamic attributes
    */
    private hash<DataProviderInfo> getProviderInfoImpl() {
        return SftpPollerDataProvider::ProviderInfo;
    }

    #! Returns the class for the data provider object
    private Class getClassImpl() {
        return cls;
    }
}
}

# private namespace; not exported
namespace Priv {
class EmbeddedSftpPoller inherits SftpPoller {
    private {
        #! The parent observer object
        Observable observable;
    }

    constructor(SftpPollerDataProviderBase provider, hash<auto> options) : SftpPoller(options) {
        observable := cast<Observable>(provider);
    }

    singleFileEvent(hash<SftpPollerFileEventInfo> event) {
        observable.notifyObservers("sftp-file-event", event);
    }

    postSingleFileEvent(hash<SftpPollerFileEventInfo> event) {
    }
}

