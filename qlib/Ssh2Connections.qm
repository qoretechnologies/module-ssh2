# minimum required Qore version
%requires qore >= 3.0

%modern

%requires(reexport) ssh2 >= 2.0
%requires(reexport) ConnectionProvider >= 1.4

module Ssh2Connections {
    version = "2.0";
    desc = "user module for providing SSH2 connections";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        ConnectionSchemeCache::registerScheme("ssh", Ssh2ClientConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("sftp", SftpConnection::ConnectionScheme);
    };
    # PROCESS_CONTROL: its init registers connection scheme (process-wide registrations)
    # (a Program restricted like a Qorus interface can load the module only when it declares them; Qore #5803)
    domains = "PROCESS_CONTROL";
}

/** @mainpage Ssh2Connections Module

    @tableofcontents

    @section ssh2connectionsintro Ssh2Connections Module Introduction

    The %Ssh2Connections module provides connection definitions for classes
    provided by the \c ssh2 module for the @ref connectionproviderintro "ConnectionProvider"
    module in %Qore.

    To use this module, use \c "%requires Ssh2Connections" in your code.

    This module automatically uses the @ref ssh2intro "ssh2" binary module.

    All the public symbols in the module are defined in the Ssh2Connections namespace.

    Currently the module provides the following classes:
    - @ref Ssh2Connections::AbstractSsh2Connection "AbstractSsh2Connection"
    - @ref Ssh2Connections::SftpConnection "SftpConnection"
    - @ref Ssh2Connections::Ssh2ClientConnection "Ssh2ClientConnection"

    @section ssh2connectionshostkeys Host Key Verification

    The <tt>verify_host_key</tt> connection option inherits the process-wide SSH2 setting, which enables
    verification by default. An explicit value overrides the default for that connection.
    Set <tt>host_key_policy</tt> to <tt>reject</tt>, <tt>tofu</tt>, or <tt>tofu-session</tt>.
    An omitted <tt>known_hosts</tt> inherits the configured path, normally the local user's
    <tt>~/.ssh/known_hosts</tt>. An empty string disables the path for this connection.
    See @ref host_key_verification_bp for policy behavior and @ref embedding_multitenant for process defaults.

    @section ssh2connectionssubtypetarget Data Provider Subtypes Use the Connection's Target and Checks

    The \c "sftppoller" data provider of an @ref Ssh2Connections::SftpConnection "SftpConnection" polls the
    connection's server and directory with its login, key and host key checks for any caller, also for code that the
    connection is lent to.  These constructor options are accepted only if they give the connection's own value:
    - \c url: the connection's scheme, host, port and directory, where scheme and host names are compared without
      regard to case, a missing port is the default SSH port 22, empty and \c "." path segments and a trailing
      \c "/" are ignored, and a user name or password, if given, must be the connection's
    - \c keyfile, \c known_hosts, \c host_key_policy, \c verify_host_key and \c use_agent: the connection's
      setting, with the same base type; an empty \c keyfile is accepted if the connection has no key file

    Any other value raises \c DATA-PROVIDER-ERROR, which names the connection with its URL without the password and
    the option, but not the option's value; the data provider is always created with the connection's values.  The
    options that only tune the poller, such as \c keepalive_interval, \c mask, \c poll_interval and
    \c host_key_sha256 (a host key pin, which only adds a check), are taken from the caller.  Code restricted from the
    \c FILESYSTEM domain that is lent the connection still gets \c PERMISSION-DENIED for the \c keyfile,
    \c known_hosts and \c local_dir options.

    @anchor ssh2connections_relnotes

    @subpage ssh2connectionsreleasenotes
*/

/** @page ssh2connectionsreleasenotes Ssh2Connections Release Notes

    @section ssh2connections_v2_0 Ssh2Connections v2.0
    - the connection option names are in sentence case
      (<a href="https://github.com/qoretechnologies/qore/issues/7749">issue 7749</a>)
    - the \c "sftppoller" data provider of an @ref Ssh2Connections::SftpConnection "SftpConnection" uses the
      connection's server, directory, login, key and host key checks: a \c url, \c keyfile, \c known_hosts,
      \c host_key_policy, \c verify_host_key or \c use_agent constructor option with another value raises
      \c DATA-PROVIDER-ERROR (see @ref ssh2connectionssubtypetarget;
      <a href="https://github.com/qoretechnologies/module-ssh2/issues/133">issue 133</a>)
    - the \c "sftppoller" data provider of an @ref Ssh2Connections::SftpConnection "SftpConnection" takes the
      connection's \c keyfile with environment variables substituted, as the connection's client does
    - the connection classes declare the functional domains of their clients (\c NETWORK and \c FILESYSTEM), so
      code restricted only from other domains, such as \c DATABASE, can create them
      (<a href="https://github.com/qoretechnologies/qore/issues/7099">issue 7099</a>)
    - added source-owned connection option catalogs in all twelve standard locales; unchanged inherited
      presentation keeps its original producer identity, including HTTP/REST options and allowed values
    - added the \c host_key_policy connection option with readable values \c reject, \c tofu, and
      \c tofu-session
    - the \c verify_host_key connection option now defaults to @ref Qore::True "True" (secure by
      default) and an explicit @ref Qore::False "False" is honored, consistent with the ssh2
      client classes
    - See @ref ssh2connectionshostkeys for option inheritance and embedding defaults.

    @section ssh2connections_v1_4 Ssh2Connections v1.4
    - implemented support for a data provider scheme cache and rich option information for connections
      (<a href="https://github.com/qoretechnologies/qore/issues/4025">issue 4025</a>)

    @section ssh2connections_v1_3 Ssh2Connections v1.3
    - removed the obsolete \c Ssh2ClientConnection::getConstructorInfo() and \c SftpConnection::getConstructorInfo()
      methods as connection serialization is a much more elegant and maintainable solution
      (<a href="https://github.com/qoretechnologies/qore/issues/3696">issue 3696</a>)

    @section ssh2connections_v1_2 Ssh2Connections v1.2
    - new AbstractConnection infrastructure

    @section ssh2connections_v1_1 Ssh2Connections v1.1
    - the \c Ssh2ClientConnection::getConstructorInfo()
      and \c SftpConnection::getConstructorInfo()
      methods were added to allow connections to be created dynamically, potentially in another process from a network
      call (<a href="https://github.com/qoretechnologies/qore/issues/2628">issue 2628</a>)

    @section ssh2connections_v1_0 Ssh2Connections v1.0
    - initial release
*/

#! the Ssh2Connections namespace contains all the definitions in the Ssh2Connections module
public namespace Ssh2Connections {
#! Readable host-key policy option values
public enum Ssh2HostKeyPolicyOption : string {
    #! Reject unknown host keys
    Reject = "reject",
    #! Trust unknown host keys on first use and persist them
    TrustOnFirstUse = "tofu",
    #! Trust unknown host keys for the current connection only when needed
    TrustOnFirstUseSession = "tofu-session",
}

const HostKeyPolicyOptionValues = (
    Ssh2HostKeyPolicyOption::Reject,
    Ssh2HostKeyPolicyOption::TrustOnFirstUse,
    Ssh2HostKeyPolicyOption::TrustOnFirstUseSession,
);

const HostKeyPolicyAllowedValues = (
    <AllowedValueInfo>{
        "display_name": "Reject",
        "short_desc": "Reject unknown host keys",
        "desc": "Reject unknown host keys",
        "value": Ssh2HostKeyPolicyOption::Reject,
    },
    <AllowedValueInfo>{
        "display_name": "Trust on first use",
        "short_desc": "Trust unknown host keys on first use and persist them",
        "desc": "Trust unknown host keys on first use and persist them to the configured known_hosts file",
        "value": Ssh2HostKeyPolicyOption::TrustOnFirstUse,
    },
    <AllowedValueInfo>{
        "display_name": "Session trust on first use",
        "short_desc": "Trust unknown host keys for the current connection only when needed",
        "desc": "Trust unknown host keys for the current connection only if no known_hosts file is configured",
        "value": Ssh2HostKeyPolicyOption::TrustOnFirstUseSession,
    },
);

enum<Ssh2HostKeyPolicyOption> sub getHostKeyPolicyOption(enum<Ssh2HostKeyPolicy> policy) {
    if (policy == Ssh2HostKeyPolicy::Reject) {
        return Ssh2HostKeyPolicyOption::Reject;
    }
    if (policy == Ssh2HostKeyPolicy::TrustOnFirstUse) {
        return Ssh2HostKeyPolicyOption::TrustOnFirstUse;
    }
    if (policy == Ssh2HostKeyPolicy::TrustOnFirstUseSession) {
        return Ssh2HostKeyPolicyOption::TrustOnFirstUseSession;
    }

    throw "SSH2-HOSTKEY-POLICY-ERROR", sprintf("invalid host key policy %y", policy);
}

enum<Ssh2HostKeyPolicyOption> sub getHostKeyPolicyOption(int policy) {
    if (policy == SSH2_HOSTKEY_REJECT) {
        return Ssh2HostKeyPolicyOption::Reject;
    }
    if (policy == SSH2_HOSTKEY_TOFU) {
        return Ssh2HostKeyPolicyOption::TrustOnFirstUse;
    }
    if (policy == SSH2_HOSTKEY_TOFU_SESSION) {
        return Ssh2HostKeyPolicyOption::TrustOnFirstUseSession;
    }

    throw "SSH2-HOSTKEY-POLICY-ERROR", sprintf("invalid host key policy %d", policy);
}

enum<Ssh2HostKeyPolicy> sub getHostKeyPolicyFromOption(string policy) {
    if (policy == Ssh2HostKeyPolicyOption::Reject) {
        return Ssh2HostKeyPolicy::Reject;
    }
    if (policy == Ssh2HostKeyPolicyOption::TrustOnFirstUse) {
        return Ssh2HostKeyPolicy::TrustOnFirstUse;
    }
    if (policy == Ssh2HostKeyPolicyOption::TrustOnFirstUseSession) {
        return Ssh2HostKeyPolicy::TrustOnFirstUseSession;
    }

    throw "CONNECTION-OPTION-ERROR", sprintf("invalid host_key_policy option value %y; expected one of %y",
        policy, HostKeyPolicyOptionValues);
}

#! abstract base class for \c ssh module connections
/** supports the following option:
    - \c "keyfile": a path to a private key file in PEM format to use for key-based authentication
*/
public class AbstractSsh2Connection inherits ConnectionProvider::AbstractConnectionWithInfo {
    #! Returns the functional domains of the connection's clients (qoretechnologies/qore#7099)
    /** The clients connect to an SSH server and read the \c keyfile and \c known_hosts files, which trust-on-first-use
        host key verification also writes
    */
    private final int getConnectionDomainsImpl() {
        return DOM_NETWORK | DOM_FILESYSTEM;
    }

    #! creates the AbstractSsh2Connection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.
    */
    constructor(string name, string description, string url, hash<auto> attributes = {}, hash<auto> options = {})
            : AbstractConnectionWithInfo(name, description, url, attributes, options) {
    }

    #! Creates the AbstractSsh2Connection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : AbstractConnectionWithInfo(config, attr) {
    }
}

#! class for SSH2 client session connections; returns an object of class @ref Qore::SSH2::SSH2Client
/** supports the following option:
    - \c "keyfile": a path to a private key file in PEM format to use for key-based authentication (environment variables can be prefixed with \c "$" in the path (or optionally enclosed in curly brackets as in \c "${var}") and will be substituted with the value of the environment variable)
*/
public class Ssh2ClientConnection inherits AbstractSsh2Connection {
    public {
        #! Connection entry info
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("Ssh2Connections",
            "Ssh2ClientConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "SSH Connection",
            "short_desc": "A connection to a server with SSH",
            "desc": "A connection to a server with SSH",
            "cls": Class::forName("Ssh2ClientConnection"),
            "options": {
                "keyfile": <ConnectionOptionInfo>{
                    "display_name": "SSH private key",
                    "short_desc": "A path to an SSH private key file in PEM format",
                    "type": "string",
                    "desc": "A path to an SSH private key file in PEM format to use for key-based authentication",
                },
                "known_hosts": <ConnectionOptionInfo>{
                    "display_name": "Known hosts file",
                    "short_desc": "A path to an OpenSSH known_hosts file for host key verification",
                    "type": "string",
                    "desc": "A path to an OpenSSH known_hosts file for host key verification; "
                        "environment variables can be prefixed with '$' in the path; if set to an "
                        "empty string, no known_hosts file is configured; if not set, "
                        "the ssh2 module default applies (normally the local user's "
                        "~/.ssh/known_hosts file, unless the embedding application has changed or "
                        "disabled the module default)",
                },
                "host_key_policy": <ConnectionOptionInfo>{
                    "display_name": "Host key policy",
                    "short_desc": "Policy for unknown host keys",
                    "type": "string",
                    "desc": "Policy for unknown host keys when host-key verification is enabled: "
                        "`reject` rejects unknown keys, `tofu` persists first-use keys to the "
                        "configured known_hosts file, and `tofu-session` trusts unknown keys for "
                        "the current connection only if no known_hosts file is configured",
                    "allowed_values": HostKeyPolicyAllowedValues,
                    "default_value": Ssh2HostKeyPolicyOption::TrustOnFirstUse,
                },
                "verify_host_key": <ConnectionOptionInfo>{
                    "display_name": "Verify host key",
                    "short_desc": "Enable host key verification against the known_hosts file",
                    "type": "bool",
                    "desc": "Enable host key verification against the known_hosts file; enabled by "
                        "default; the effective default follows the ssh2 module's process-global "
                        "default, which an embedding application may change via "
                        "SSH2Base::setDefaultVerifyHostKey() or the "
                        "QORE_SSH2_DEFAULT_VERIFY_HOST_KEY environment variable",
                    "default_value": True,
                },
                "use_agent": <ConnectionOptionInfo>{
                    "display_name": "Use SSH agent",
                    "short_desc": "Enable SSH agent authentication",
                    "type": "bool",
                    "desc": "Enable SSH agent authentication; when enabled, the client will attempt to "
                        "authenticate using keys from the running SSH agent before other methods",
                    "default_value": True,
                },
                "keepalive_interval": <ConnectionOptionInfo>{
                    "display_name": "Keepalive interval",
                    "short_desc": "Keepalive interval in seconds",
                    "type": "int",
                    "desc": "Keepalive interval in seconds; 0 disables keepalive; default: 60",
                    "default_value": 60,
                },
            },
            "schemes": {
                "ssh2": True,
            },
        });
    }

    #! creates the Ssh2ClientConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.
    */
    constructor(string name, string description, string url, hash<auto> attributes = {}, hash<auto> options = {})
            : AbstractSsh2Connection(name, description, url, attributes, options) {
    }

    #! Creates the Ssh2ClientConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : AbstractSsh2Connection(config, attr) {
    }

    #! returns \c "ssh2"
    string getType() {
        return "ssh2";
    }

    #! returns a @ref Qore::SSH2::SSH2Client object
    /** @param connect if @ref Qore::True "True", then @ref Qore::SSH2::SSH2Client::connect() is called
        @param rtopts this connection type does not accept any runtime options, so this parameter is ignored

        @return a @ref Qore::SSH2::SSH2Client object
    */
    private Qore::SSH2::SSH2Client getImpl(bool connect = True, *hash<auto> rtopts) {
        SSH2Client sc(url);
        if (opts.keyfile) {
            sc.setKeys(substitute_env_vars(opts.keyfile));
        }
        if (exists opts.known_hosts) {
            sc.setKnownHostsFile(substitute_env_vars(opts.known_hosts));
        }
        if (exists opts.host_key_policy) {
            sc.setHostKeyPolicy(getHostKeyPolicyFromOption(opts.host_key_policy));
        }
        if (exists opts.verify_host_key) {
            sc.setVerifyHostKey(opts.verify_host_key);
        }
        if (exists opts.use_agent) {
            sc.setUseAgent(opts.use_agent);
        }
        if (exists opts.keepalive_interval) {
            sc.setKeepalive(opts.keepalive_interval);
        }
        if (connect) {
            sc.connect();
        }
        return sc;
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        # reflect the ssh2 module's process-global host key verification default so that
        # connection introspection is consistent with the effective runtime default (which an
        # embedding application may have changed via SSH2Base::setDefaultVerifyHostKey() or the
        # QORE_SSH2_DEFAULT_VERIFY_HOST_KEY environment variable)
        hash<ConnectionSchemeInfo> scheme = ConnectionScheme;
        scheme.options.verify_host_key.default_value = SSH2Base::getDefaultVerifyHostKey();
        scheme.options.host_key_policy.default_value = getHostKeyPolicyOption(SSH2Base::getDefaultHostKeyPolicy());
        return scheme;
    }
}

#! class for SFTP connections; returns an object of class @ref Qore::SSH2::SFTPClient for acquiring files from or posting files to SFTP servers
/** supports the following option:
    - \c "keyfile": a path to a private key file in PEM format to use for key-based authentication (environment variables can be prefixed with \c "$" in the path (or optionally enclosed in curly brackets as in \c "${var}") and will be substituted with the value of the environment variable)

    additionally, the following runtime options are supported in getImpl():
    - \c "path": overrides the path component in the URL at runtime
    - \c "path_add": appends the given string to the path component of the URL at runtime

    The \c "sftppoller" data provider subtype polls the connection's server and directory with its login, key and
    host key checks (see @ref ssh2connectionssubtypetarget): a \c "url" constructor option is accepted only if it
    names the connection's scheme, host, port and directory (scheme and host names are compared without regard to
    case, a missing port is the default SSH port 22, and empty and \c "." path segments and a trailing \c "/" are
    ignored) and gives no user name or password other than the connection's, a \c "keyfile", \c "known_hosts",
    \c "host_key_policy", \c "verify_host_key" or \c "use_agent" constructor option only if it is the connection's
    setting, and any other value raises \c DATA-PROVIDER-ERROR; a caller that needs another server, directory, login,
    key or host key check uses a connection with it
*/
public class SftpConnection inherits AbstractSsh2Connection {
    public {
        #! Connection entry info
        const ConnectionScheme = ConnectionProvider::connection_scheme_presentation("Ssh2Connections",
            "SftpConnection", "en", <ConnectionSchemeInfo>{
            "display_name": "SFTP Connection",
            "short_desc": "A connection to a server with SFTP",
            "desc": "A connection to a server with SFTP",
            "cls": Class::forName("SftpConnection"),
            "options": Ssh2ClientConnection::ConnectionScheme.options,
            "schemes": {
                "sftp": True,
            },
        });

        #! Data provider subtypes supported
        const DataProviderSubtypeMap = {
            "sftppoller": {
                "module": "SftpPoller",
                "class": "SftpDelayedPollerDataProvider",
                "option_class": "SftpPollerDataProviderBase",
                "options": "ConstructorOptions",
            },
        };
    }

    private {
        #! The data provider subtype options that name the connection's server, directory, login, key and host key checks
        /** The connection's values for them always win (module-ssh2 issue 133)
        */
        const SubtypeTargetOptions = ("url", "keyfile", "known_hosts", "host_key_policy", "verify_host_key",
            "use_agent");

        #! The default SSH port
        const DefaultPort = 22;

        #! Data provider subtype info
        static hash<string, *hash<string, hash<DataProviderOptionInfo>>> subtype_info = {};

        #! Data provider subtype lock
        static Mutex subtype_lck();
    }

    #! creates the SftpConnection object
    /** @param name the name of the connection
        @param description connection description
        @param url connection URL (potentially with password info)
        @param attributes various attributes. See below
        @param options connection options

        See @ref ConnectionProvider::AbstractConnection::constructor() for \c attributes and \c options reference.
    */
    constructor(string name, string description, string url, hash<auto> attributes = {}, hash<auto> options = {})
            : AbstractSsh2Connection(name, description, url, attributes, options) {
    }

    #! Creates the SftpConnection object
    /** @param config with the following keys:
        - name (required string): the connection name
        - display_name (optional string): the display name
        - short_desc (optional string): a short description in plain text
        - desc (optional string): a long description with markdown formatting
        - url (required string): the connection URL
        - opts (optional hash): connection options
        - logger (optional LoggerInterface object): logger for the connection
        @param attr optional connection attributes
        - monitor (optional bool): should the connection be monitored? Default: True
        - enabled (optional bool): is the connection enabled? Default: True
        - locked (optional bool): is the connection locked? Default: False
        - debug_data (optional bool): debug data? Default: False
        - tags (optional hash): tags for the connection; no default value

        @throw CONNECTION-OPTION-ERROR missing or invalid connection option or attribute
    */
    constructor(hash<auto> config, *hash<auto> attr) : AbstractSsh2Connection(config, attr) {
    }

    #! returns \c "sftp"
    string getType() {
        return "sftp";
    }

    #! returns runtime options
    /** return a hash with the following keys reflecting support for the corresponding runtime options in getImpl():
        - \c "path": overrides the path component in the URL at runtime
        - \c "path_add": appends the given string to the path component of the URL at runtime
    */
    *hash<auto> getRuntimeOptions() {
        return {
            "path": True,
            "path_add": True,
        };
    }

    #! returns an FtpClientDataProvider object for this connection
    /** @param constructor_options any additional constructor options for the data provider

        @return an FtpClientDataProvider object for this connection

        @see hasDataProvider()
    */
    DataProvider::AbstractDataProvider getDataProvider(*hash<auto> constructor_options) {
        # to avoid circular dependencies, this object loads the FtpDataProvider and creates the data provider
        # object dynamically
        load_module("SftpClientDataProvider");
        return create_object("SftpClientDataProvider", get());
    }

    #! returns @ref True, as the connection returns a data provider with the @ref getDataProvider() method
    /** @return @ref True, as the connection returns a data provider with the @ref getDataProvider() method

        @see @ref getDataProvider()
    */
    bool hasDataProvider() {
        return True;
    }

    #! returns a data provider object for the connection and subtype passed as an argument
    /** @param subtype the subtype of data provider supported, in case the connection can return multiple data
        providers
        @param constructor_options any additional constructor options required by the data provider

        @return a data provider object for the connection and subtype passed as an argument, which uses the
        connection's URL, key and host key checks

        @throw DATA-PROVIDER-ERROR this object does not support the data provider API or the given subtype is not
        valid; the \c "url", \c "keyfile", \c "known_hosts", \c "host_key_policy", \c "verify_host_key" or
        \c "use_agent" constructor option names another server, directory, login, key or host key check than the
        connection's
        @throw PERMISSION-DENIED a \c "keyfile", \c "known_hosts" or \c "local_dir" constructor option is given by
        code restricted from the \c FILESYSTEM functional domain that the connection was lent to

        @see
        - hasDataProvider()
        - getDataProviderSubtypes()

        @since ConnectionProvider 2.0
    */
    private AbstractDataProvider getDataProviderImpl(string subtype, *hash<auto> constructor_options) {
        *hash<auto> conf = DataProviderSubtypeMap{subtype};
        if (!conf) {
            throw "DATA-PROVIDER-ERROR", sprintf("sftp connections do not support data provider subtype %y; supported "
                "subtypes: %y", subtype, keys getDataProviderSubtypes());
        }
        checkSubtypeInfo();
        # the local paths in the constructor options are the caller's input, also for the code that the connection was
        # lent to: refused before the data provider is created
        foreach string opt in (("keyfile", "known_hosts", "local_dir")) {
            if (constructor_options{opt}.val() && SandboxManager::isLentToRestricted(DOM_FILESYSTEM)) {
                throw "PERMISSION-DENIED", sprintf("the %y data provider option cannot be used: the calling code is "
                    "restricted from the FILESYSTEM functional domain", opt);
            }
        }
        # the connection's server, directory, login, key and host key checks are the subtype's: a caller cannot
        # point it at another target or weaken its checks, and is told so rather than having its option replaced, as
        # the poller deletes or moves the files that it finds (module-ssh2 issue 133)
        hash<auto> target = getSubtypeTargetOptions();
        checkSubtypeTarget(subtype, constructor_options, target);
        # the connection's options are the members of this object (self.opts); a local variable named opts would
        # shadow them in its own initialization expression
        hash<auto> dp_opts = {
            "keepalive_interval": self.opts.keepalive_interval,
        } + getSubtypeOptions(subtype_info{subtype}, constructor_options - SubtypeTargetOptions) + target;
        # the connection's client takes the key file with environment variables substituted, as the poller does
        # with the known_hosts file; the poller takes the key file as it is given
        if (dp_opts.keyfile) {
            dp_opts.keyfile = substitute_env_vars(dp_opts.keyfile);
        }
        return create_object(conf."class", dp_opts);
    }

    #! Returns the connection's values of the data provider subtype options that name its target and checks
    private:internal hash<auto> getSubtypeTargetOptions() {
        return {
            "url": url,
            "keyfile": self.opts.keyfile,
            "known_hosts": self.opts.known_hosts,
            "host_key_policy": self.opts.host_key_policy,
            "verify_host_key": self.opts.verify_host_key,
            "use_agent": self.opts.use_agent,
        };
    }

    #! Refuses data provider subtype options that name another target or check than the connection's
    private:internal checkSubtypeTarget(string subtype, *hash<auto> constructor_options, hash<auto> target) {
        foreach string key in (SubtypeTargetOptions) {
            if (key == "url" || !constructor_options.hasKey(key)) {
                continue;
            }
            auto v = constructor_options{key};
            if (!exists v) {
                continue;
            }
            auto conn_value = target{key};
            # the base type of the value must be the connection's, so that no conversion can make another value
            # equal; an option's default value can be an enum value, which has the base type string
            if (exists conn_value ? (v.typeCode() == conn_value.typeCode() && v == conn_value)
                # with no key file of the connection, an empty key file is no key file either
                : (key == "keyfile" && v === "")) {
                continue;
            }
            throwSubtypeTargetError(subtype, key);
        }

        auto v = constructor_options.url;
        if (!exists v || v === "") {
            return;
        }
        if (v.typeCode() != NT_STRING) {
            throwSubtypeTargetError(subtype, "url");
        }
        hash<UrlInfo> u;
        try {
            u = parse_url(cast<string>(v));
        } catch (hash<ExceptionInfo> ex) {
            throwSubtypeTargetError(subtype, "url");
        }
        # the scheme, host and port are compared as the poller connects: scheme and host names without regard to
        # case, and with the default port of SSH; the user name and password must be the connection's if given
        if ((u.protocol ?? "sftp").lwr() != (urlh.protocol ?? "sftp").lwr()
            || (u.host ?? "").lwr() != (urlh.host ?? "").lwr()
            || (u.port ?? DefaultPort) != (urlh.port ?? DefaultPort)
            || normalizeSubtypePath(u.path) != normalizeSubtypePath(urlh.path)
            || (exists u.username && u.username !== urlh.username)
            || (exists u.password && u.password !== urlh.password)) {
            throwSubtypeTargetError(subtype, "url");
        }
    }

    #! Returns the given URL path as the poller uses it: without empty and \c "." segments and a trailing \c "/"
    /** No path (the login directory) differs from \c "/" (the root directory); \c ".." segments are kept, so that a
        path with them names another directory than the connection's
    */
    private:internal static string normalizeSubtypePath(*string path) {
        if (!path.val()) {
            return "";
        }
        list<string> segments = select path.split("/"), $1 != "" && $1 != ".";
        return "/" + segments.join("/");
    }

    #! Throws the exception for a data provider subtype option that names another target or check
    private:internal throwSubtypeTargetError(string subtype, string option) {
        # the value of the option is not given, as it can hold a password
        throw "DATA-PROVIDER-ERROR", sprintf("sftp connection %y: the %y data provider uses the connection's server, "
            "directory, login, key and host key checks (%s); the %y option names another value; use a connection "
            "with that setting instead", name, subtype, safe_url, option);
    }

    #! Sets child data provider capabilities
    private setChildCapabilities() {
        children_can_support_apis = True;
    }

    #! Verifies that subtype info has been loaded from external modules
    /** @since ConnectionProvider 2.0
    */
    private checkSubtypeInfo() {
        if (!subtype_info) {
            loadSubtypeInfo();
        }
    }

    #! Returns a hash of supported data provider subtypes
    /** @return a hash of supported data provider subtypes

        @since ConnectionProvider 2.0
    */
    private *hash<string, *hash<string, hash<DataProviderOptionInfo>>> getDataProviderSubtypesImpl() {
        if (subtype_info) {
            return subtype_info;
        }
        loadSubtypeInfo();
        return subtype_info;
    }

    #! Loads subtype info from external modules
    private loadSubtypeInfo() {
        subtype_lck.lock();
        on_exit subtype_lck.unlock();
        # check again inside the lock
        if (subtype_info) {
            return;
        }
        foreach hash<auto> i in (DataProviderSubtypeMap.pairIterator()) {
            load_module(i.value."module");
            Class cls = Class::forName(i.value."option_class" ?? i.value."class");
            subtype_info{i.key} = cls.getConstant(i.value."options").getValue();
        }
    }

    #! returns a @ref Qore::SSH2::SFTPClient object
    /** @param connect if @ref Qore::True "True", then @ref Qore::SSH2::SFTPClient::connect() is called and also if there is any path in the URL then @ref Qore::SSH2::SFTPClient::chdir() is called on that path
        @param rtopts this object takes the following runtime options:
        - \c "path": overrides the path component in the URL at runtime
        - \c "path_add": appends the given string to the path component of the URL at runtime

        @return a @ref Qore::SSH2::SFTPClient object
    */
    private Qore::SSH2::SFTPClient getImpl(bool connect = True, *hash<auto> rtopts) {
        *string rtpath = getRuntimePath(rtopts);
        SFTPClient sc(url);
        if (opts.keyfile) {
            sc.setKeys(substitute_env_vars(opts.keyfile));
        }
        if (exists opts.known_hosts) {
            sc.setKnownHostsFile(substitute_env_vars(opts.known_hosts));
        }
        if (exists opts.host_key_policy) {
            sc.setHostKeyPolicy(getHostKeyPolicyFromOption(opts.host_key_policy));
        }
        if (exists opts.verify_host_key) {
            sc.setVerifyHostKey(opts.verify_host_key);
        }
        if (exists opts.use_agent) {
            sc.setUseAgent(opts.use_agent);
        }
        if (exists opts.keepalive_interval) {
            sc.setKeepalive(opts.keepalive_interval);
        }
        if (connect) {
            sc.connect();
            if (rtpath.val()) {
                sc.chdir(rtpath);
            }
        }
        return sc;
    }

    private *string getRuntimePath(*hash<auto> rtopts) {
        *string rtpath = rtopts.path ?* urlh.path;
        if (rtopts.path_add.val()) {
            if (rtpath !~ /\/$/ && rtopts.path_add !~ /^\//)
                rtpath += "/";
            rtpath += rtopts.path_add;
        }
        return rtpath;
    }

    #! Returns the ConnectionSchemeInfo hash for this object
    private hash<ConnectionSchemeInfo> getConnectionSchemeInfoImpl() {
        # reflect the ssh2 module's process-global host key verification default so that
        # connection introspection is consistent with the effective runtime default (which an
        # embedding application may have changed via SSH2Base::setDefaultVerifyHostKey() or the
        # QORE_SSH2_DEFAULT_VERIFY_HOST_KEY environment variable)
        hash<ConnectionSchemeInfo> scheme = ConnectionScheme;
        scheme.options.verify_host_key.default_value = SSH2Base::getDefaultVerifyHostKey();
        scheme.options.host_key_policy.default_value = getHostKeyPolicyOption(SSH2Base::getDefaultHostKeyPolicy());
        return scheme;
    }
}
}
