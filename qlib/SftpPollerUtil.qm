# make sure we have the required qore version
%requires qore >= 2.0

# requires ssh2 functionality
%requires (reexport) ssh2

%modern

%requires DataProvider

module SftpPollerUtil {
    version = "1.4.1";
    desc = "SftpPollerUtil module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
    init = sub () {
        # register the event data type
        DataProvider::registerType("qore/sftp/event", SftpPollerFileEventInfoDataType);
    };
}

/** @mainpage SftpPollerUtil Module

    @section sftppollerutuilintro Introduction to the SftpPollerUtil Module

    The SftpPollerUtil module defines types for the <a href="../../SftpPoller/html/index.html">SftpPoller</a> module.

    @section sftppollerutilrelnotes SftpPollerUtil Module Release Notes

    @section sftppollerv1_4_1 Version 1.4.1
    - fixed a bug registering the sftp event type
      (<a href="https://github.com/qorelanguage/qore/issues/4389">issue 4389</a>)

    @section sftppollerv1_3_0 Version 1.3.0
    - added support for data provider APIs

    @section sftppollerutilv1_0 Version 1.0
    - initial release
*/

#! main SftpPoller namespace
public namespace SftpPoller {
#! Single file event data description
public class SftpPollerFileEventInfoDataType inherits HashDataType {
    public {
        #! Markdown descriptions for hashdecl members
        const Fields = {
            "name": {
                "display_name": "Name",
                "short_desc": "The name of the file, link, or directory",
                "desc": "The name of the file, link, or directory",
                "example_value": "example-file.txt",
            },
            "size": {
                "display_name": "Size",
                "short_desc": "The size of the file in bytes",
                "desc": "The size of the file in bytes",
                "example_value": 903,
            },
            "uid": {
                "display_name": "User ID",
                "short_desc": "The UID of the owner of the file",
                "desc": "The UID of the owner of the file",
                "example_value": 1000,
            },
            "gid": {
                "display_name": "Group ID",
                "short_desc": "The GID of the owner of the file",
                "desc": "The GID of the owner of the file",
                "example_value": 20,
            },
            "mode": {
                "display_name": "File Mode",
                "short_desc": "The permissions / mode of the file",
                "desc": "The permissions / mode of the file",
                "example_value": 33261,
            },
            "atime": {
                "display_name": "Last Access Time",
                "short_desc": "The last accessed date/time of the file",
                "desc": "The last accessed date/time of the file",
            },
            "mtime": {
                "display_name": "Last Modified Time",
                "short_desc": "The last modified date/time of the file",
                "desc": "The last modified date/time of the file",
            },
            "type": {
                "display_name": "Type",
                "short_desc": "The type of file",
                "desc": "The type of file",
                "allowed_values": (
                    <AllowedValueInfo>{
                        "display_name": "REGULAR",
                        "short_desc": "Regular file",
                        "desc": "Regular file",
                        "value": "REGULAR",
                    },
                    <AllowedValueInfo>{
                        "display_name": "DIRECTORY",
                        "short_desc": "Directory",
                        "desc": "Directory",
                        "value": "DIRECTORY",
                    },
                    <AllowedValueInfo>{
                        "display_name": "SYMBOLIC-LINK",
                        "short_desc": "Symbolic link",
                        "desc": "Symbolic link",
                        "value": "SYMBOLIC-LINK",
                    },
                    <AllowedValueInfo>{
                        "display_name": "BLOCK-DEVICE",
                        "short_desc": "Block device file",
                        "desc": "Block device file",
                        "value": "BLOCK-DEVICE",
                    },
                    <AllowedValueInfo>{
                        "display_name": "CHARACTER-DEVICE",
                        "short_desc": "Character device file",
                        "desc": "Character device file",
                        "value": "CHARACTER-DEVICE",
                    },
                    <AllowedValueInfo>{
                        "display_name": "FIFO",
                        "short_desc": "FIFO file",
                        "desc": "FIFO file",
                        "value": "FIFO",
                    },
                    <AllowedValueInfo>{
                        "display_name": "SOCKET",
                        "short_desc": "UNIX socket file",
                        "desc": "UNIX socket file",
                        "value": "SOCKET",
                    },
                    <AllowedValueInfo>{
                        "display_name": "UNKNOWN",
                        "short_desc": "Unknown file type",
                        "desc": "Unknown file type",
                        "value": "UNKNOWN",
                    },
                ),
                "example_value": "REGULAR",
            },
            "perm": {
                "display_name": "Permissions",
                "short_desc": "A string giving UNIX-style permissions for the file",
                "desc": "A string giving UNIX-style permissions for the file (ex: `-rwxr-xr-x`)",
                "example_value": "-rwxr-x-r-x",
            },
            "data": {
                "display_name": "File Data",
                "short_desc": "The file's data",
                "desc": "The file's data; this will be a string unless the `binary` option is set to `True`, in "
                    "which case this key is assigned to the files binary data; this hash key is only present if "
                    "`skip_file_content_retrieval` was `False` in the `SftpPoller::constructor()` option hash",
            },
            "filepath": {
                "display_name": "Remote Path",
                "short_desc": "The remote filepath relative to the remote root directory",
                "desc": "The remote filepath relative to the remote root directory",
                "example_value": "./example-file.txt",
            },
            "transfer_time":  {
                "display_name": "Transfer Time",
                "short_desc": "The relative date/time value giving the time taken to transfer the file",
                "desc": "The relative date/time value giving the time taken to transfer the file",
                "example_value": 0.154947s,
            },
            "local_path":  {
                "display_name": "Local Path",
                "short_desc": "The target path for the file if applicable",
                "desc": "Only included when `local_dir` is set; the target path for the file where the file will "
                    "be moved to in the post event action",
            },
            "remote_status":  {
                "display_name": "Remote Status",
                "short_desc": "The status of the remote file after processing",
                "desc": "The status of the remote file after processing",
                "allowed_values": (
                    <AllowedValueInfo>{
                        "display_name": RS_DELETED,
                        "short_desc": "The remote file was deleted",
                        "desc": "The remote file was deleted",
                        "value": RS_DELETED,
                    },
                    <AllowedValueInfo>{
                        "display_name": RS_MOVED,
                        "short_desc": "The remote file was moved",
                        "desc": "The remote file was moved",
                        "value": RS_MOVED,
                    },
                    <AllowedValueInfo>{
                        "display_name": RS_NONE,
                        "short_desc": "The remote file was not moved or deleted",
                        "desc": "The remote file was not moved or deleted",
                        "value": RS_NONE,
                    },
                ),
            },
        };
    }

    #! Creates the type
    constructor() {
        addQoreFields(map {$1.getName(): Fields{$1.getName()} + {
            "type": $1.getType(),
        }}, TypedHash::forName("SftpPoller::SftpPollerFileEventInfo").getMembers());
    }
}

/** @defgroup sftp_remote_status_constants SFTP Remote Status Constants
*/
#/@{
#! remote status: deleted
public const RS_DELETED = "DELETED";

#! remote status: moved
public const RS_MOVED = "MOVED";

#! remote status: none
public const RS_NONE = "NONE";
#/@}

#! FTP poller event type constant
public const SftpPollerFileEventInfoDataType = new SftpPollerFileEventInfoDataType();

#! SftpPoller file event hash
public hashdecl SftpPollerFileEventInfo {
    #! the name of the file, link, or directory
    string name;

    #! the size of the file in bytes
    int size;

    #! the UID of the owner of the file
    int uid;

    #! the GID of the owner of the file
    int gid;

    #! the permissions / mode of the file
    int mode;

    #! the last accessed date/time of the file
    date atime;

    #! the last modified date/time of the file
    date mtime;

    #! the type of file
    /** one of:
        - \c "REGULAR"
        - \c "DIRECTORY"
        - \c "SYMBOLIC-LINK"
        - \c "BLOCK-DEVICE"
        - \c "CHARACTER-DEVICE"
        - \c "FIFO"
        - \c "SYMBOLIC-LINK"
        - \c "SOCKET"
        - \c "UNKNOWN"
    */
    string type;

    #! a string giving UNIX-style permissions for the file (ex: "-rwxr-xr-x")
    string perm;

    #! the file's data
    /** @note This will be a string unless the \a "binary" option is set to @ref Qore::True "True", in which case this
        key is assigned to the files binary data; this hash key is only present if \c skip_file_content_retrieval was
        @ref False in the options to \c SftpPoller::constructor()
    */
    data data;

    #! the remote filepath relative to SFTP root directory
    string filepath;

    #! The relative date/time value giving the time taken to transfer the file
    date transfer_time;

    #! Only included when `local_dir` is set; the target path for the file
    *string local_path;

    #! Remote status; one of @ref sftp_remote_status_constants
    string remote_status;
}
}
