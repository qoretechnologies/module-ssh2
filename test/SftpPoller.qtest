#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires ssh2 >= 1.2
%requires SftpPoller
%requires QUnit
%requires Util

%exec-class SftpPollerTest

class MySftpPoller inherits SftpPoller {
    public {}

    private {
        list<hash<SftpPollerFileEventInfo>> l = ();
        bool verbose;
    }

    constructor(SFTPClient sc, hash opts, bool n_verbose) : SftpPoller(sc, opts) {
        verbose = n_verbose;
    }

    nothing singleFileEvent(hash<SftpPollerFileEventInfo> fh) {
        if (verbose)
            printf("GOT FILE: %y\n", fh - "data" + ("data_type": fh.data.type(), "data_size": fh.data.size()));
        # in this case, the polling stop operation will take effect after all the singleFileEvent() calls are made for the polling operation
        stopNoWait();
    }

    nothing postSingleFileEvent(hash<SftpPollerFileEventInfo> fh) {
        l += fh;
    }

    list<hash<SftpPollerFileEventInfo>> getFileList() {
        return l;
    }
}

#! collects the names of the files that one poll finds
class NameSftpPoller inherits SftpPoller {
    public {
        list<string> names = ();
    }

    constructor(SFTPClient sc, hash<auto> opts) : SftpPoller(sc, opts) {
    }

    constructor(hash<auto> opts) : SftpPoller(opts) {
    }

    nothing singleFileEvent(hash<SftpPollerFileEventInfo> fh) {
        names += fh.name;
    }

    nothing postSingleFileEvent(hash<SftpPollerFileEventInfo> fh) {
    }
}

class SftpPollerTest inherits QUnit::Test {
    public {}

    private {
        const Timeout = 10s;

        const MyOpts = Opts + (
            "uri": "uri=s",
            "privkey": "k,private-key=s",
            "mask": "m,mask=s",
            "dir": "d,dir=s"
        );

        SFTPClient sc;

        const ColumnOffset = 25;

        const Files = (
            "a.txt": "abc",
            "b.txt": "bcd",
            "c.txt": "cde",
            "d.php": "def",
        );

        const Result = (
            ("name": "a.txt",
             "size": 3,
             "type": "REGULAR",
             "data": "abc",
            ),
            ("name": "b.txt",
             "size": 3,
             "type": "REGULAR",
             "data": "bcd",
            ),
            ("name": "c.txt",
             "size": 3,
             "type": "REGULAR",
             "data": "cde",
            ),
        );

        const NoRetrievalFiles = (
            "x.txt": "abc",
        );

        const NoRetrievalResult = (
            ("name": "x.txt",
             "size": 3,
             "type": "REGULAR",
            ),
        );
    }

    private {
        #! the known_hosts file of the test: no test writes the keys of the test server to the user's known_hosts
        string known_hosts = sprintf("%s%sssh2-test-known-hosts-%s", tmp_location(), DirSep, get_random_string(10));

        #! the URI of the test server
        string uri;

        #! the private key file used for authentication, if any
        *string keyfile;
    }

    constructor() : Test("SftpPollerTest", "1.2", \ARGV, MyOpts) {
        # objects use the known_hosts file of the test unless a case sets one of its own
        SSH2Base::setDefaultKnownHostsFile(known_hosts);
        on_exit if (is_file(known_hosts)) {
            unlink(known_hosts);
        }
        addTestCase("SftpPollerTests", \sftpPollerTests());
        addTestCase("SftpPolerRemotePathNegTest", \sftpPollerRemotePathNegTest());
        addTestCase("SftpPollerRegexMaskTest", \sftpPollerRegexMaskTest());

        uri = m_options.uri ?? shift ARGV ?? sprintf("%s@localhost", getusername());

        printf("Connecting to %y\n", uri);

        if (m_options.privkey) {
            keyfile = m_options.privkey;
        } else {
            if (PlatformOS == "Windows")
                exit(0);

            string sshdir = `echo -n ~/.ssh`;
            if (is_file(sshdir + "/id_rsa"))
                keyfile = sshdir + "/id_rsa";
            else if (is_file(sshdir + "/id_dsa"))
                keyfile = sshdir + "/id_dsa";
        }
        sc = getClient();

        set_return_value(main());
    }

    #! returns a new client for the test server, which starts in the login directory
    private SFTPClient getClient() {
        SFTPClient client(uri);
        if (keyfile) {
            client.setKeys(keyfile);
        }
        return client;
    }

    #! issue #3377: an empty "regex_mask" matches every file with both constructors
    sftpPollerRegexMaskTest() {
        # a client of its own, so that the directory is relative to the login directory
        SFTPClient setup = getClient();
        string nd = sprintf("%s/", get_random_string());
        if (m_options.dir) {
            nd = sprintf("%s/%s/", m_options.dir, get_random_string());
        }
        setup.mkdir(nd);
        map setup.putFile($1.value, nd + $1.key), Files.pairIterator();
        on_exit {
            map setup.removeFile(nd + $1), Files.keyIterator();
            setup.rmdir(nd);
        }

        list<string> all = sort(keys Files);

        # runs one poll with the SFTPClient constructor and returns the names of the files found
        code poll_client = list<string> sub (hash<auto> opts) {
            NameSftpPoller poller(getClient(), {"path": nd, "skip_file_content_retrieval": True} + opts);
            poller.runOnce();
            return sort(poller.names);
        };

        # runs one poll with the hash-only constructor and returns the names of the files found
        hash<auto> info = sc.info();
        code poll_host = list<string> sub (hash<auto> opts) {
            hash<auto> conf = {
                "host": info.ssh2host,
                "path": nd,
                "skip_file_content_retrieval": True,
            };
            if (info.ssh2port) {
                conf.port = info.ssh2port;
            }
            if (info.ssh2user) {
                conf.user = info.ssh2user;
            }
            if (keyfile) {
                conf.keyfile = keyfile;
            }
            NameSftpPoller poller(conf + opts);
            poller.runOnce();
            return sort(poller.names);
        };

        foreach code poll in ((poll_client, poll_host)) {
            # an empty regex mask matches every file, also when it overrides a glob mask
            assertEq(all, poll({"regex_mask": ""}));
            assertEq(all, poll({"regex_mask": "", "mask": "*.txt"}));
            # a regex mask overrides the glob mask
            assertEq(("d.php",), poll({"regex_mask": "\\.php$", "mask": "*.txt"}));
            # without a regex mask, the glob mask is used
            assertEq(("d.php",), poll({"regex_mask": NOTHING, "mask": "*.php"}));
            assertEq(all, poll({}));
        }
    }

    private usageIntern() {
        TestReporter::usageIntern(ColumnOffset);
        printOption("-k,--private-key=ARG", "set private key to use for authentication", ColumnOffset);
    }

    sftpPollerTests() {
        code info = sub (string msg) {
            if (m_options.verbose)
                printf("INFO: %s\n", msg);
        };
        code detail = sub (string msg) {
            if (m_options.verbose > 1)
                printf("DETAIL: %s\n", msg);
        };
        code debug = sub (string msg) {
            if (m_options.verbose > 2)
                printf("DEBUG: %s\n", msg);
        };

        hash<auto> opts = (
            "log_info": info,
            "log_detail": detail,
            "log_debug": debug,
            "mask": "*.txt",
            "writable": True,
        );

        string nd = sprintf("%s/", get_random_string());
        # setup directory
        if (m_options.dir) {
            nd = sprintf("%s/%s/",  m_options.dir, get_random_string());
        }

        try {
            sc.mkdir(nd);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.desc =~ /LIBSSH2_FX_PERMISSION_DENIED/) {
                stdout.print("Root is not writable, specify writable directory using --dir(-d).\n");
            }
            rethrow;
        }

        map sc.putFile($1.value, nd + $1.key), Files.pairIterator();
        on_exit {
            map sc.removeFile($1), Files.keyIterator();
            sc.chdir("..");
            sc.rmdir(nd);
        }

        opts.path = nd;

        MySftpPoller poller(sc, opts, m_options.verbose > 2);
        poller.start();
        poller.waitStop();
        list fl = poller.getFileList();
        # sort by file name
        fl = map $1.(Result[0].keys()), sort(fl, int sub (hash l, hash r) { return l.name <=> r.name; });
        assertEq(fl, Result);

        # testing the data retrieval skipping (one file is enough)
        string nd2 = sprintf("%s/", get_random_string());
        sc.mkdir(nd2);
        map sc.putFile($1.value, nd2 + $1.key), NoRetrievalFiles.pairIterator();
        on_exit {
            map sc.removeFile($1), NoRetrievalFiles.keyIterator();
            sc.chdir("..");
            sc.rmdir(nd2);
        }

        opts.path = nd2;
        opts.skip_file_content_retrieval = True;

        MySftpPoller poller2(sc, opts, m_options.verbose > 2);
        poller2.start();
        poller2.waitStop();
        fl = poller2.getFileList();
        map assertEq(False, exists $1.data), fl;
        # sort by file name
        fl = map $1.(NoRetrievalResult[0].keys()), sort(fl, int sub (hash l, hash r) { return l.name <=> r.name; });
        assertEq(fl, NoRetrievalResult);
    }

    sftpPollerRemotePathNegTest() {
        code info = sub (string msg) {
            if (m_options.verbose)
                printf("INFO: %s\n", msg);
        };
        code detail = sub (string msg) {
            if (m_options.verbose > 1)
                printf("DETAIL: %s\n", msg);
        };
        code debug = sub (string msg) {
            if (m_options.verbose > 2)
                printf("DEBUG: %s\n", msg);
        };

        hash<auto> opts = (
            "log_info": info,
            "log_detail": detail,
            "log_debug": debug,
            "mask": "*.txt",
            "writable": True,
        );

        string tmp = "/tmp/";

        # setup directory
        string nd = sprintf("%s/%s/", tmp, get_random_string());
        sc.mkdir(nd);
        map sc.putFile($1.value, nd + $1.key), Files.pairIterator();
        on_exit {
            map sc.removeFile(nd + $1), Files.keyIterator();
            sc.rmdir(nd);
        }

        opts.path = nd;

        {
            sc.chmod(nd, 0555);
            on_exit sc.chmod(nd, 0777);
            assertThrows("REMOTE-DIR-ERROR", sub () {MySftpPoller poller(sc, opts, m_options.verbose > 2);});
        }
    }
}
