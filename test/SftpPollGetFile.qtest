#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%prepend-module-path "${SCRIPT_DIR}/../build"

%requires ssh2 >= 2.0

%requires Util
%requires QUnit

%exec-class SftpPollGetFileTest

#! A DNS server for the tests on 127.0.0.1: it answers A queries with 127.0.0.1 and AAAA queries with no address
/** The tests make the resolver ask it with the debug hook dbg_cares_set_servers(), so that host names are resolved
    over the network, asynchronously.  It can drop the first queries it receives, so that only the resolver's
    retransmission timer sends them again, and hold its answers until the test releases them.
*/
class TestDnsServer {
    public {
        #! the port of the server
        int port;

        #! the queries received, as hashes with \c qtype and \c dropped
        Queue queries();
    }

    private {
        Socket sock();
        int drop;
        bool held;
        Queue release_q();
        Counter running(1);
    }

    #! Starts the server
    /** @param drop the number of queries to drop
        @param hold hold the answers until release() is called
    */
    constructor(int drop = 0, bool hold = False) {
        self.drop = drop;
        held = hold;
        sock.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
        port = sock.getSocketInfo().port;
        background serve();
    }

    #! Answers the held queries and every query from now on
    release() {
        release_q.push(True);
    }

    #! Stops the server: a datagram that is not a query ends it; held answers are sent first
    stop() {
        release_q.push(True);
        Socket s();
        s.bindINET("127.0.0.1", "0", False, AF_INET, SOCK_DGRAM);
        TestDnsServer::drive(s.startPollSendTo("127.0.0.1", port, binary("stop")));
        running.waitForZero();
    }

    #! Drives a poll operation of a UDP socket to completion
    static drive(AbstractPollOperation op) {
        while (!op.goalReached()) {
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (pi) {
                Socket::poll((pi,), 60s);
            }
        }
    }

    private serve() {
        on_exit running.dec();
        while (True) {
            AbstractPollOperation op = sock.startPollRecvFrom();
            TestDnsServer::drive(op);
            hash<auto> d = op.getOutput();
            binary query = d.data;
            if (query.size() < 17) {
                # the stop datagram
                break;
            }
            # skip the name of the question
            int pos = 12;
            while (int len = get_byte(query, pos)) {
                pos += len + 1;
            }
            ++pos;
            int qtype = get_word_16(query, pos);
            pos += 4;
            if (drop) {
                --drop;
                queries.push({"qtype": qtype, "dropped": True});
                continue;
            }
            queries.push({"qtype": qtype, "dropped": False});
            if (held) {
                release_q.get();
                held = False;
            }
            # the answer: the query's ID and question, and for an A query the address 127.0.0.1
            bool a = qtype == 1;
            binary answer = query.substr(0, 2) + parse_hex_string(sprintf("81800001%s00000000", a ? "0001" : "0000"))
                + query.substr(12, pos - 12);
            if (a) {
                answer += parse_hex_string("c00c000100010000003c00047f000001");
            }
            TestDnsServer::drive(sock.startPollSendTo(d.address, d.port, answer));
        }
    }
}

#! Tests non-blocking SFTP file retrieval with SFTPClient::startPollGetFile()
class SftpPollGetFileTest inherits QUnit::Test {
    private {
        timeout timeout = 10s;

        #! the URI used to connect to the test server
        string uri;

        #! the private key to use, if any
        *string privkey;

        #! the directory where test files are created
        string tmp_dir;

        #! a file large enough to require many libssh2_sftp_read() calls
        const LargeContents = strmul("0123456789abcdef", 64 * 1024);

        #! a small file with multi-byte characters
        const SmallContents = "hi there ýčšěáýžšěčéář\n";

        const MyOpts = Opts + {
            "uri": "uri=s",
            "privkey": "k,private-key=s",
            "timeout": "t,timeout=i",
            "dir": "d,dir=s",
        };
    }

    private {
        #! the known_hosts file of the test: no test writes the keys of the test server to the user's known_hosts
        string known_hosts = sprintf("%s%sssh2-test-known-hosts-%s", tmp_location(), DirSep, get_random_string(10));
    }

    constructor() : Test("SftpPollGetFileTest", "1.0", \ARGV, MyOpts) {
        # objects use the known_hosts file of the test unless a case sets one of its own
        SSH2Base::setDefaultKnownHostsFile(known_hosts);
        on_exit if (is_file(known_hosts)) {
            unlink(known_hosts);
        }
        if (m_options.timeout) {
            timeout = m_options.timeout * 1000;
        }
        uri = m_options.uri ?? shift ARGV ?? sprintf("%s@localhost", getusername());
        tmp_dir = m_options.dir ?? tmp_location();

        if (m_options.privkey) {
            privkey = m_options.privkey;
        } else {
            if (PlatformOS == "Windows") {
                exit(0);
            }
            string sshdir = ENV.HOME + DirSep + ".ssh";
            if (is_file(sshdir + "/id_rsa")) {
                privkey = sshdir + "/id_rsa";
            } else if (is_file(sshdir + "/id_dsa")) {
                privkey = sshdir + "/id_dsa";
            }
        }

        addTestCase("polled read matches the blocking read", \pollGetFileTest());
        addTestCase("large file read loop", \largeFileTest());
        addTestCase("empty file", \emptyFileTest());
        addTestCase("missing file", \missingFileTest());
        addTestCase("permission denied", \permissionDeniedTest());
        addTestCase("abort mid-flight", \abortTest());
        addTestCase("authentication failure", \authFailureTest());
        addTestCase("client reuse and exclusivity", \reuseTest());
        addTestCase("a host name resolved asynchronously is waited for with the resolver's descriptors",
            \asyncResolutionTest());
        addTestCase("a lost DNS query is sent again at the resolver's timer", \lostQueryTest());

        set_return_value(main());
    }

    #! Returns a new client for the test server
    private SFTPClient getClient() {
        SFTPClient sc(uri);
        if (privkey) {
            sc.setKeys(privkey);
        }
        return sc;
    }

    #! Creates a local file with the given contents and returns its path
    /** the test server runs on the same host, so files created locally are visible over SFTP
    */
    private string makeFile(data contents, *softint mode) {
        string fn = sprintf("%s%s%s-%s", tmp_dir, DirSep, "ssh2-poll", get_random_string(20));
        File f();
        f.open2(fn, O_CREAT | O_TRUNC | O_WRONLY, 0600);
        if (contents.size()) {
            f.write(contents);
        }
        f.close();
        if (exists mode) {
            chmod(fn, mode);
        }
        return fn;
    }

    #! Drives a poll operation to completion and returns its output
    private auto runPoller(AbstractPollOperation op, *reference<int> polls) {
        date start = now_us();
        while (!op.goalReached()) {
            if ((now_us() - start) > timeout) {
                throw "POLL-TIMEOUT", sprintf("poll operation timed out in state %y", op.getState());
            }
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (!pi) {
                break;
            }
            if (exists polls) {
                ++polls;
            }
            # the operation waits on its client object; the descriptor must be valid whenever the
            # operation asks the caller to wait for events of it
            if (pi.events) {
                assertGt(0, pi.socket.getPollableDescriptor());
            }
            Socket::poll((pi,), timeout);
        }
        return op.getOutput();
    }

    #! the host name that the test DNS server resolves (RFC 6761); the system's resolver does not know it
    const TestHost = "ssh2-poll-resolve.test";

    #! Returns a client for the test server under TestHost, with its own known_hosts file
    /** The host name is only resolved with the test DNS server; the user and port are the test URI's
    */
    private SFTPClient getResolvedClient(string known_hosts) {
        hash<UrlInfo> url = parse_url(uri =~ /:\/\// ? uri : "sftp://" + uri);
        string ruri = sprintf("%s@%s:%d", url.username ?? getusername(), TestHost, url.port ?? 22);
        SFTPClient sc(ruri);
        if (privkey) {
            sc.setKeys(privkey);
        }
        sc.setKnownHostsFile(known_hosts);
        sc.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
        return sc;
    }

    #! Makes the resolver ask the given DNS server, and returns a closure that restores the system's servers
    private code<nothing()> setDnsServer(TestDnsServer dns) {
        call_function("dbg_cares_set_servers", "127.0.0.1:" + dns.port);
        return sub () {
            call_function("dbg_cares_set_servers", "");
            dns.stop();
        };
    }

    #! Runs the operation with the async I/O controller and returns its output
    private auto runWithController(SFTPClient sc, AbstractPollOperation op) {
        hash<SocketPollResultInfo> result = AsyncIoController::exec(<SocketPollOperationInfo>{
            "sock": sc,
            "spop": op,
            "owner": "ssh2-poll-resolve-test",
            # a hang guard only: the operation ends when it is done
            "to": 10m,
        });
        if (result.ex) {
            throw result.ex.err, result.ex.desc;
        }
        return op.getOutput();
    }

    #! While the host name is resolved, the operation reports no events of its client and waits for the resolver
    /** The DNS server holds its answers until the operation has reported what it waits for; the operation is then
        completed by the async I/O controller
    */
    asyncResolutionTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the debug hook that sets the DNS server is only in debug builds of Qore");
        }
        string fn = makeFile(SmallContents);
        on_exit unlink(fn);
        string known_hosts = sprintf("%s%sssh2-poll-known-hosts-%s", tmp_dir, DirSep, get_random_string(10));
        on_exit if (is_file(known_hosts)) { unlink(known_hosts); }

        TestDnsServer dns(0, True);
        code<nothing()> restore = setDnsServer(dns);
        on_exit restore();

        SFTPClient sc = getResolvedClient(known_hosts);
        AbstractPollOperation op = sc.startPollGetFile(fn);
        *hash<SocketPollInfo> pi = op.continuePoll();
        # the resolver has asked the DNS server, which holds its answer
        # (a hang guard only)
        assertFalse(dns.queries.get(1m).dropped);
        assertTrue(exists pi, "the operation waits while the host name is resolved");
        assertEq(0, pi.events, "no events of the client, which has no descriptor yet, are waited for");
        assertTrue(pi.socket == sc, "the client is the object waited on");
        assertEq(-1, sc.getPollableDescriptor());
        assertGt(0, pi.extra_fds.size(), "the resolver's descriptors are waited for");
        assertGt(0, pi.poll_timeout_ms, "the resolver's timer is reported");

        dns.release();
        assertEq(binary(SmallContents), runWithController(sc, op));
        assertTrue(op.goalReached());
    }

    #! A DNS query that the server drops is sent again by the resolver's timer, which the operation reports
    lostQueryTest() {
        if (!Option::HAVE_LIBRARY_DEBUGGING) {
            testSkip("the debug hook that sets the DNS server is only in debug builds of Qore");
        }
        string fn = makeFile(SmallContents);
        on_exit unlink(fn);
        string known_hosts = sprintf("%s%sssh2-poll-known-hosts-%s", tmp_dir, DirSep, get_random_string(10));
        on_exit if (is_file(known_hosts)) { unlink(known_hosts); }

        # the first queries (of the A and the AAAA lookup) are dropped
        TestDnsServer dns(2);
        code<nothing()> restore = setDnsServer(dns);
        on_exit restore();

        SFTPClient sc = getResolvedClient(known_hosts);
        AbstractPollOperation op = sc.startPollGetFile(fn);
        assertEq(binary(SmallContents), runWithController(sc, op), "the operation completes");
        # the dropped queries and the queries sent again
        list<hash<auto>> queries;
        while (dns.queries.size()) {
            queries += dns.queries.get();
        }
        assertEq(2, (select queries, $1.dropped).size(), "two queries were dropped");
        assertGt(0, (select queries, !$1.dropped).size(), "the resolver sent the dropped queries again");
    }

    #! The polled read must return exactly what the blocking read returns
    pollGetFileTest() {
        string fn = makeFile(SmallContents);
        on_exit unlink(fn);

        SFTPClient sc = getClient();

        AbstractPollOperation op = sc.startPollGetFile(fn);
        assertEq("start", op.getState());
        assertEq(sprintf("sftp-get-file %s", fn), op.getGoal());
        assertFalse(op.goalReached());
        assertNothing(op.getOutput());

        int polls = 0;
        auto rv = runPoller(op, \polls);
        assertTrue(op.goalReached());
        assertEq("done", op.getState());
        assertEq(Type::Binary, rv.type());
        assertEq(binary(SmallContents), rv);
        # the operation cannot complete without waiting for the server at least once
        assertGt(0, polls);

        # the same client is usable for blocking operations after the poll operation completes
        assertEq(binary(SmallContents), sc.getFile(fn, timeout));
        assertTrue(boolean(sc.connected()));

        # the two paths must return the same data for the same file
        SFTPClient blocking_client = getClient();
        assertEq(blocking_client.getFile(fn, timeout), rv);
    }

    #! A file larger than the SFTP block size exercises the read loop and its EAGAIN handling
    largeFileTest() {
        string fn = makeFile(LargeContents);
        on_exit unlink(fn);

        SFTPClient sc = getClient();
        int polls = 0;
        auto rv = runPoller(sc.startPollGetFile(fn), \polls);
        assertEq(LargeContents.size(), rv.size());
        assertEq(binary(LargeContents), rv);
        # a file of this size cannot be read in a single pass
        assertGt(2, polls);

        assertEq(sc.getFile(fn, timeout), rv);
    }

    #! An empty file must be returned as an empty binary value, not as NOTHING
    emptyFileTest() {
        string fn = makeFile("");
        on_exit unlink(fn);

        SFTPClient sc = getClient();
        auto rv = runPoller(sc.startPollGetFile(fn));
        assertEq(Type::Binary, rv.type());
        assertEq(0, rv.size());
        assertEq(binary(), rv);
        assertEq(sc.getFile(fn, timeout), rv);
    }

    #! A missing file must be reported with the same error the blocking API reports
    missingFileTest() {
        string fn = sprintf("%s%sssh2-poll-missing-%s", tmp_dir, DirSep, get_random_string(20));

        SFTPClient sc = getClient();
        AbstractPollOperation op = sc.startPollGetFile(fn);

        hash<ExceptionInfo> poll_ex;
        try {
            runPoller(op);
            fail("retrieving a missing file must fail");
        } catch (hash<ExceptionInfo> ex) {
            poll_ex = ex;
        }

        hash<ExceptionInfo> blocking_ex;
        try {
            getClient().getFile(fn, timeout);
            fail("retrieving a missing file must fail");
        } catch (hash<ExceptionInfo> ex) {
            blocking_ex = ex;
        }

        assertEq(blocking_ex.err, poll_ex.err);
        assertEq(blocking_ex.desc, poll_ex.desc);
        assertRegex("LIBSSH2_FX_NO_SUCH_FILE", poll_ex.desc);

        # the failed operation must not be left in a state where it reports success
        assertFalse(op.goalReached());
        assertEq("closed", op.getState());
        assertNothing(op.getOutput());

        # a poll operation that adopts an established session reconnects if the session turns out
        # to be dead; a file error is not a dead session, so it must be reported as it is rather
        # than causing a reconnect and a retry
        SFTPClient connected = getClient();
        connected.connect(timeout);
        assertTrue(boolean(connected.connected()));
        AbstractPollOperation op2 = connected.startPollGetFile(fn);
        try {
            runPoller(op2);
            fail("retrieving a missing file over an established session must fail");
        } catch (hash<ExceptionInfo> ex) {
            assertEq(poll_ex.err, ex.err);
            assertRegex("LIBSSH2_FX_NO_SUCH_FILE", ex.desc);
        }
        # the session is still usable: it was never treated as lost
        assertTrue(boolean(connected.connected()));
        string good = makeFile(SmallContents);
        on_exit unlink(good);
        assertEq(binary(SmallContents), runPoller(connected.startPollGetFile(good)));
    }

    #! A file that cannot be read must be reported with the same error the blocking API reports
    permissionDeniedTest() {
        if (!getuid()) {
            testSkip("cannot test permission errors as the superuser");
        }

        string fn = makeFile(SmallContents, 0);
        on_exit unlink(fn);

        hash<ExceptionInfo> poll_ex;
        try {
            runPoller(getClient().startPollGetFile(fn));
            fail("retrieving an unreadable file must fail");
        } catch (hash<ExceptionInfo> ex) {
            poll_ex = ex;
        }

        hash<ExceptionInfo> blocking_ex;
        try {
            getClient().getFile(fn, timeout);
            fail("retrieving an unreadable file must fail");
        } catch (hash<ExceptionInfo> ex) {
            blocking_ex = ex;
        }

        assertEq(blocking_ex.err, poll_ex.err);
        assertEq(blocking_ex.desc, poll_ex.desc);
        assertRegex("LIBSSH2_FX_PERMISSION_DENIED", poll_ex.desc);
    }

    #! Aborting an operation mid-flight releases the remote file handle and the connection
    abortTest() {
        string fn = makeFile(LargeContents);
        on_exit unlink(fn);

        SFTPClient sc = getClient();
        AbstractPollOperation op = sc.startPollGetFile(fn);

        # advance the operation into the transfer, then abort it
        date start = now_us();
        while (op.getState() != "sftp-read") {
            if ((now_us() - start) > timeout) {
                throw "POLL-TIMEOUT", sprintf("the transfer did not start; state: %y", op.getState());
            }
            *hash<SocketPollInfo> pi = op.continuePoll();
            if (!pi) {
                break;
            }
            Socket::poll((pi,), timeout);
        }
        assertEq("sftp-read", op.getState());
        assertTrue(boolean(sc.connected()));

        op.abort();

        # the remote handle and the session are released by the abort
        assertEq("closed", op.getState());
        assertFalse(op.goalReached());
        assertNothing(op.getOutput());
        assertFalse(boolean(sc.connected()));
        # further polling on an aborted operation does nothing
        assertNothing(op.continuePoll());

        # the client is usable again after the abort; the poll reservation was released
        assertEq(binary(LargeContents), sc.getFile(fn, timeout));

        # aborting a completed operation is a no-op
        SFTPClient sc2 = getClient();
        AbstractPollOperation op2 = sc2.startPollGetFile(fn);
        assertEq(binary(LargeContents), runPoller(op2));
        op2.abort();
        assertTrue(op2.goalReached());
        assertEq(binary(LargeContents), op2.getOutput());
    }

    #! Authentication failures are reported from the poll operation
    authFailureTest() {
        string user = "qore-ssh2-no-such-user-" + get_random_string(10);
        SFTPClient sc(uri);
        sc.setUser(user);
        sc.setPassword("");
        # the local user's agent and key files must not be used for this user
        sc.setUseAgent(False);

        AbstractPollOperation op = sc.startPollGetFile("/etc/hostname");
        assertThrows("SSH2CLIENT-AUTH-ERROR", "No proper authentication method found",
            sub () { runPoller(op); });
        assertEq("closed", op.getState());
        assertFalse(op.goalReached());
        # the connection is closed after an authentication failure
        assertFalse(boolean(sc.connected()));

        # the blocking API reports the same error
        SFTPClient sc2(uri);
        sc2.setUser(user);
        sc2.setPassword("");
        sc2.setUseAgent(False);
        assertThrows("SSH2CLIENT-AUTH-ERROR", "No proper authentication method found",
            sub () { sc2.getFile("/etc/hostname", timeout); });
    }

    #! A client can only run one poll operation at a time, and can be reused afterwards
    reuseTest() {
        string fn = makeFile(SmallContents);
        on_exit unlink(fn);

        SFTPClient sc = getClient();

        AbstractPollOperation op = sc.startPollGetFile(fn);
        # no other operation may use the client while the poll operation is in progress
        assertThrows("SSH2-POLL-IN-PROGRESS", sub () { sc.startPollGetFile(fn); });
        assertThrows("SSH2-POLL-IN-PROGRESS", sub () { sc.getFile(fn, timeout); });
        assertThrows("SSH2-POLL-IN-PROGRESS", sub () { sc.connect(timeout); });
        assertThrows("SSH2-POLL-IN-PROGRESS", sub () { sc.disconnect(timeout); });

        assertEq(binary(SmallContents), runPoller(op));

        # the reservation is released when the operation completes: the established session is
        # reused by the next operation
        assertTrue(boolean(sc.connected()));
        AbstractPollOperation op2 = sc.startPollGetFile(fn);
        assertEq(binary(SmallContents), runPoller(op2));

        # the operation object can be destroyed without completing it
        {
            AbstractPollOperation op3 = sc.startPollGetFile(fn);
            assertEq("start", op3.getState());
            delete op3;
        }
        # the client is usable again after the abandoned operation
        assertEq(binary(SmallContents), runPoller(sc.startPollGetFile(fn)));
    }
}
