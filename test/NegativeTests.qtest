#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

# Negative and corner case tests for the SSH2 module

%modern

%requires ssh2 >= 2.0
%requires QUnit

%exec-class NegativeTests

class NegativeTests inherits QUnit::Test {
    public {}

    private {
        timeout timeout = 5s;

        const MyOpts = Opts + {
            "timeout": "T,timeout=i",
        };

        const ColumnOffset = 25;
    }

    constructor() : Test("NegativeTests", "2.0", \ARGV, MyOpts) {
        if (m_options.timeout)
            timeout = m_options.timeout * 1000;

        addTestCase("Constructor error tests", \constructorErrorTests());
        addTestCase("Connection error tests", \connectionErrorTests());
        addTestCase("Invalid parameter tests", \invalidParameterTests());
        addTestCase("State error tests", \stateErrorTests());
        addTestCase("Corner case tests", \cornerCaseTests());
        addTestCase("Sandbox key file tests", \sandboxKeyFileTests());
        addTestCase("Keepalive tests", \keepaliveTests());
        addTestCase("SSH agent option tests", \agentOptionTests());
        addTestCase("Known hosts option tests", \knownHostsOptionTests());
        addTestCase("Algorithm preference tests", \algorithmPreferenceTests());
        addTestCase("Banner tests", \bannerTests());
        addTestCase("Host key policy tests", \hostKeyPolicyTests());
        addTestCase("Keys from data tests", \keysFromDataTests());
        addTestCase("SSH2Listener constructor tests", \listenerConstructorTests());
        addTestCase("Module constant tests", \moduleConstantTests());

        set_return_value(main());
    }

    constructorErrorTests() {
        # Test SSH2Client with empty URL
        assertThrows("SSH2CLIENT-PARAMETER-ERROR", sub () {
            new SSH2Client("");
        });

        # Test SSH2Client with invalid protocol
        assertThrows("SSH2CLIENT-PARAMETER-ERROR", sub () {
            new SSH2Client("http://localhost");
        });

        # Test SSH2Client with invalid protocol (ftp)
        assertThrows("SSH2CLIENT-PARAMETER-ERROR", sub () {
            new SSH2Client("ftp://user@localhost");
        });

        # Test SFTPClient with empty URL
        assertThrows("SFTPCLIENT-PARAMETER-ERROR", sub () {
            new SFTPClient("");
        });

        # Test SFTPClient with invalid protocol
        assertThrows("SFTPCLIENT-PARAMETER-ERROR", sub () {
            new SFTPClient("http://localhost");
        });

        # Valid constructor should work
        {
            SSH2Client sc("ssh://test@localhost:22");
            assertEq("localhost", sc.getHost());
            assertEq(22, sc.getPort());
            assertEq("test", sc.getUser());
        }

        # SSH2 protocol should be accepted
        {
            SSH2Client sc("ssh2://test@localhost:22");
            assertEq("localhost", sc.getHost());
        }
    }

    connectionErrorTests() {
        # Test connection to non-existent host
        # May throw QOREADDRINFO-GETINFO-ERROR or SOCKET-CONNECT-ERROR depending on DNS resolution
        {
            SSH2Client sc("ssh://user@nonexistent.invalid.host.12345:22");
            try {
                sc.connect(timeout);
                fail("Expected connection error");
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(ex.err =~ /SOCKET-CONNECT-ERROR|QOREADDRINFO-GETINFO-ERROR/,
                    sprintf("Expected connection error, got: %s", ex.err));
            }
        }

        # Test connection to localhost on a port that's likely not running SSH
        {
            SSH2Client sc("ssh://user@localhost:59999");
            try {
                sc.connect(timeout);
                fail("Expected connection error");
            } catch (hash<ExceptionInfo> ex) {
                assertTrue(ex.err =~ /SOCKET-CONNECT-ERROR|SSH2/,
                    sprintf("Expected connection error, got: %s", ex.err));
            }
        }

        # Test connection with very short timeout (likely to timeout)
        {
            SSH2Client sc("ssh://user@localhost:22");
            # Even if SSH is running, 1ms is too short
            try {
                sc.connect(1);
                # If we get here, SSH is running and very fast, so disconnect
                sc.disconnect();
            } catch (hash<ExceptionInfo> ex) {
                # Expected: either timeout or connection error
                assertTrue(ex.err =~ /SOCKET-CONNECT-ERROR|SSH2CLIENT-TIMEOUT|SSH2-ERROR/);
            }
        }
    }

    invalidParameterTests() {
        # Test setKeys with non-existent file
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2-SETKEYS-ERROR", sub () {
                sc.setKeys("/nonexistent/path/to/key");
            });
        }

        # Test SFTPClient chmod with invalid mode (sticky bits)
        {
            SFTPClient sc("sftp://user@localhost");
            # Note: This test only validates parameter checking before connection
            # The actual chmod operation would require a connection
            assertThrows("SFTPCLIENT-PARAMETER-ERROR", sub () {
                # Mode with sticky bit (01755) should be rejected
                sc.chmod("/tmp/test", 01755, timeout);
            });
        }

        # Test SSH2Client::scpPut with invalid size
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2CLIENT-SCPPUT-ERROR", sub () {
                sc.scpPut("/tmp/test", 0);  # size cannot be 0
            });

            assertThrows("SSH2CLIENT-SCPPUT-ERROR", sub () {
                sc.scpPut("/tmp/test", -1);  # size cannot be negative
            });
        }

        # Test SSH2Client::openDirectTcpipChannel with invalid port
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2CLIENT-OPENDIRECTTCPIPCHANNEL-ERROR", sub () {
                sc.openDirectTcpipChannel("host", 0);  # port cannot be 0
            });

            assertThrows("SSH2CLIENT-OPENDIRECTTCPIPCHANNEL-ERROR", sub () {
                sc.openDirectTcpipChannel("host", 80, "127.0.0.1", 0);  # source port cannot be 0
            });
        }
    }

    stateErrorTests() {
        # Test setUser when connected (should fail)
        # Note: This requires an actual connection, so we skip if SSH not available
        {
            SSH2Client sc("ssh://test@localhost:22");
            # Before connection, setUser should work
            assertNothing(sc.setUser("newuser"));
            assertEq("newuser", sc.getUser());
        }

        # Test disconnect when not connected
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
                sc.disconnect();
            });
        }

        # Test SFTPClient disconnect when not connected
        {
            SFTPClient sc("sftp://user@localhost");
            assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
                sc.disconnect();
            });
        }
    }

    cornerCaseTests() {
        # Test with special characters in username
        # Note: URL encoding is preserved (not decoded) by the client
        {
            SSH2Client sc("ssh://user%40domain@localhost:22");
            # The URL-encoded value is preserved as-is
            assertEq("user%40domain", sc.getUser());
        }

        # Test with password containing special characters
        # Note: URL encoding is preserved (not decoded) by the client
        {
            SFTPClient sc("sftp://user:p%40ss%3Aword@localhost:22");
            # The URL-encoded value is preserved as-is
            assertEq("p%40ss%3Aword", sc.getPassword());
        }

        # Test connection info before connecting
        {
            SSH2Client sc("ssh://testuser@localhost:2222");
            hash<auto> info = sc.info();
            assertEq("localhost", info.ssh2host);
            assertEq(2222, info.ssh2port);
            assertEq("testuser", info.ssh2user);
            assertFalse(info.connected);
            assertNothing(info.fingerprint);
            assertNothing(info.authenticated);
        }

        # Test connected() before and after connect attempt
        {
            SSH2Client sc("ssh://user@localhost:22");
            # connected() returns 0 (not bool False) when not connected
            assertTrue(!sc.connected());
        }

        # Test getter methods
        {
            SSH2Client sc("ssh://user:pass@localhost:22");
            assertEq("localhost", sc.getHost());
            assertEq(22, sc.getPort());
            assertEq("user", sc.getUser());
            assertEq("pass", sc.getPassword());
            assertNothing(sc.getKeyPriv());  # No keys set
            assertNothing(sc.getKeyPub());   # No keys set
            assertNothing(sc.getAuthenticatedWith());  # Not connected
        }

        # Test with default port
        {
            SSH2Client sc("ssh://user@localhost");
            assertEq(22, sc.getPort());
        }

        # Test URL with path (for SFTP)
        {
            SFTPClient sc("sftp://user@localhost/home/user");
            assertEq("localhost", sc.getHost());
        }
    }

    sandboxKeyFileTests() {
        # Test that filesystem sandbox blocks key file access outside allowed paths

        # Create a test key file in /tmp
        string testKeyPath = "/tmp/ssh2_sandbox_test_key_" + getpid();
        {
            File f();
            f.open2(testKeyPath, O_CREAT | O_WRONLY | O_TRUNC, 0600);
            f.write("-----BEGIN OPENSSH PRIVATE KEY-----\ntest\n-----END OPENSSH PRIVATE KEY-----\n");
        }
        on_exit unlink(testKeyPath);

        string testKeyPubPath = testKeyPath + ".pub";
        {
            File f();
            f.open2(testKeyPubPath, O_CREAT | O_WRONLY | O_TRUNC, 0644);
            f.write("ssh-rsa AAAAB test\n");
        }
        on_exit unlink(testKeyPubPath);

        # Create a sandboxed program with /var as root (so /tmp is outside)
        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.loadModule("ssh2");

        p.parse(sprintf("
            sub test_setkeys() {
                SSH2Client sc('ssh://user@localhost');
                sc.setKeys('%s');
            }
        ", testKeyPath), "sandbox_key_test");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        # Test that setKeys is blocked when key file is outside sandbox
        bool caught = False;
        try {
            p.callFunction("test_setkeys");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err, "Key file access blocked with correct error");
        }
        assertTrue(caught, "Key file access outside sandbox was blocked");

        # Test that key file access works when in allowed path
        SandboxManager sm2();
        sm2.setFilesystemSandboxRoot("/tmp");
        Program p2(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p2.loadModule("ssh2");

        p2.parse(sprintf("
            int sub test_setkeys_allowed() {
                SSH2Client sc('ssh://user@localhost');
                sc.setKeys('%s');
                return 1;
            }
        ", testKeyPath), "sandbox_key_allowed_test");
        p2.setSandboxManager(sm2);

        int result = p2.callFunction("test_setkeys_allowed");
        assertEq(1, result, "Key file access inside sandbox works");
    }

    keepaliveTests() {
        # Test default keepalive
        {
            SSH2Client sc("ssh://user@localhost");
            assertEq(60, sc.getKeepalive());
        }

        # Test set/get roundtrip
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setKeepalive(30);
            assertEq(30, sc.getKeepalive());
        }

        # Test disable keepalive
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setKeepalive(0);
            assertEq(0, sc.getKeepalive());
        }

        # Test SFTPClient inherits keepalive
        {
            SFTPClient sc("sftp://user@localhost");
            assertEq(60, sc.getKeepalive());
            sc.setKeepalive(120);
            assertEq(120, sc.getKeepalive());
        }
    }

    agentOptionTests() {
        # Test default is enabled
        {
            SSH2Client sc("ssh://user@localhost");
            assertTrue(sc.getUseAgent());
        }

        # Test set/get roundtrip
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setUseAgent(False);
            assertFalse(sc.getUseAgent());
            sc.setUseAgent(True);
            assertTrue(sc.getUseAgent());
        }

        # Test SFTPClient inherits agent option
        {
            SFTPClient sc("sftp://user@localhost");
            assertTrue(sc.getUseAgent());
            sc.setUseAgent(False);
            assertFalse(sc.getUseAgent());
        }
    }

    knownHostsOptionTests() {
        # Test default: no known hosts file
        {
            SSH2Client sc("ssh://user@localhost");
            assertNothing(sc.getKnownHostsFile());
        }

        # Test set/get roundtrip
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setKnownHostsFile("/tmp/known_hosts");
            assertEq("/tmp/known_hosts", sc.getKnownHostsFile());
        }

        # Test default verification disabled
        {
            SSH2Client sc("ssh://user@localhost");
            assertFalse(sc.getVerifyHostKey());
        }

        # Test set/get verify roundtrip
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setVerifyHostKey(True);
            assertTrue(sc.getVerifyHostKey());
            sc.setVerifyHostKey(False);
            assertFalse(sc.getVerifyHostKey());
        }

        # Test SFTPClient inherits known hosts options
        {
            SFTPClient sc("sftp://user@localhost");
            assertNothing(sc.getKnownHostsFile());
            assertFalse(sc.getVerifyHostKey());
            sc.setKnownHostsFile("/tmp/kh");
            sc.setVerifyHostKey(True);
            assertEq("/tmp/kh", sc.getKnownHostsFile());
            assertTrue(sc.getVerifyHostKey());
        }

        # Test getHostKey when not connected throws
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
                sc.getHostKey();
            });
        }

        # Test addKnownHost when not connected throws
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setKnownHostsFile("/tmp/test_kh");
            assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
                sc.addKnownHost();
            });
        }
    }

    algorithmPreferenceTests() {
        # Test invalid method type
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2-METHOD-ERROR", sub () {
                sc.setMethodPreference("INVALID", "aes256-ctr");
            });
        }

        # Test valid method types don't throw
        {
            SSH2Client sc("ssh://user@localhost");
            assertNothing(sc.setMethodPreference("KEX", "curve25519-sha256"));
            assertNothing(sc.setMethodPreference("HOSTKEY", "ssh-ed25519"));
            assertNothing(sc.setMethodPreference("CRYPT_CS", "aes256-ctr"));
            assertNothing(sc.setMethodPreference("CRYPT_SC", "aes256-ctr"));
            assertNothing(sc.setMethodPreference("MAC_CS", "hmac-sha2-256"));
            assertNothing(sc.setMethodPreference("MAC_SC", "hmac-sha2-256"));
            assertNothing(sc.setMethodPreference("COMP_CS", "none"));
            assertNothing(sc.setMethodPreference("COMP_SC", "none"));
        }

        # Test getSupportedAlgorithms with invalid type
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2-METHOD-ERROR", sub () {
                sc.getSupportedAlgorithms("INVALID");
            });
        }

        # Test getSupportedAlgorithms returns non-empty list
        {
            SSH2Client sc("ssh://user@localhost");
            list<string> algs = sc.getSupportedAlgorithms("KEX");
            assertGt(0, algs.size());

            algs = sc.getSupportedAlgorithms("HOSTKEY");
            assertGt(0, algs.size());

            algs = sc.getSupportedAlgorithms("CRYPT_CS");
            assertGt(0, algs.size());
        }
    }

    bannerTests() {
        # Test default: no banner
        {
            SSH2Client sc("ssh://user@localhost");
            assertNothing(sc.getBanner());
        }

        # Test set banner
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setBanner("SSH-2.0-TestClient");
            assertEq("SSH-2.0-TestClient", sc.getBanner());
        }
    }

    hostKeyPolicyTests() {
        # Test default policy is REJECT
        {
            SSH2Client sc("ssh://user@localhost");
            assertEq(SSH2_HOSTKEY_REJECT, sc.getHostKeyPolicy());
        }

        # Test set/get roundtrip
        {
            SSH2Client sc("ssh://user@localhost");
            sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
            assertEq(SSH2_HOSTKEY_TOFU, sc.getHostKeyPolicy());
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            assertEq(SSH2_HOSTKEY_REJECT, sc.getHostKeyPolicy());
        }

        # Test invalid policy value
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2-HOSTKEY-POLICY-ERROR", sub () {
                sc.setHostKeyPolicy(99);
            });
        }

        # Test constant values
        {
            assertEq(0, SSH2_HOSTKEY_REJECT);
            assertEq(1, SSH2_HOSTKEY_TOFU);
        }
    }

    keysFromDataTests() {
        # Test setKeysFromData with valid binary data (won't authenticate, but should not throw)
        {
            SSH2Client sc("ssh://user@localhost");
            binary priv = binary("-----BEGIN OPENSSH PRIVATE KEY-----\ntest\n-----END OPENSSH PRIVATE KEY-----\n");
            binary pub = binary("ssh-rsa AAAAB test\n");
            assertNothing(sc.setKeysFromData(priv, pub));
        }

        # Test setKeysFromData with only private key
        {
            SSH2Client sc("ssh://user@localhost");
            binary priv = binary("-----BEGIN OPENSSH PRIVATE KEY-----\ntest\n-----END OPENSSH PRIVATE KEY-----\n");
            assertNothing(sc.setKeysFromData(priv));
        }

        # Test setKeysFromData with passphrase
        {
            SFTPClient sc("sftp://user@localhost");
            binary priv = binary("-----BEGIN OPENSSH PRIVATE KEY-----\ntest\n-----END OPENSSH PRIVATE KEY-----\n");
            assertNothing(sc.setKeysFromData(priv, NOTHING, "passphrase"));
        }
    }

    listenerConstructorTests() {
        # Test SSH2Listener cannot be constructed directly
        assertThrows("SSH2LISTENER-CONSTRUCTOR-ERROR", sub () {
            new SSH2Listener();
        });

        # Test forwardListen when not connected
        {
            SSH2Client sc("ssh://user@localhost");
            assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
                sc.forwardListen("0.0.0.0", 8080);
            });
        }
    }

    moduleConstantTests() {
        # Verify host key policy constants exist
        assertEq(Type::Int, SSH2_HOSTKEY_REJECT.type());
        assertEq(Type::Int, SSH2_HOSTKEY_TOFU.type());

        # Verify trace constants exist
        assertEq(Type::Int, SSH2_TRACE_TRANS.type());
        assertEq(Type::Int, SSH2_TRACE_KEX.type());
        assertEq(Type::Int, SSH2_TRACE_AUTH.type());
        assertEq(Type::Int, SSH2_TRACE_CONN.type());
        assertEq(Type::Int, SSH2_TRACE_SCP.type());
        assertEq(Type::Int, SSH2_TRACE_SFTP.type());
        assertEq(Type::Int, SSH2_TRACE_ERROR.type());
        assertEq(Type::Int, SSH2_TRACE_PUBLICKEY.type());
        assertEq(Type::Int, SSH2_TRACE_SOCKET.type());

        # Verify version string exists
        assertEq(Type::String, Qore::SSH2::Version.type());
    }

    private usageIntern() {
        TestReporter::usageIntern(ColumnOffset);
        printOption("-T,--timeout=ARG", sprintf("set timeout in seconds (def: %ds)", timeout / 1000), ColumnOffset);
    }
}
