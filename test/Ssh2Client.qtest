#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires qore >= 2.3
%requires ssh2 >= 2.0
%requires sshutil

%requires Util
%requires QUnit

%exec-class Ssh2ClientTest

class TestMemoryIdentityProvider inherits SshUtil::AbstractSshClientIdentityProvider {
    private {
        string private_key;
        *string public_key;
        int candidate_calls;
        int material_calls;
    }

    constructor(string private_key, *string public_key) {
        self.private_key = private_key;
        self.public_key = public_key;
        self.candidate_calls = 0;
        self.material_calls = 0;
    }

    list<hash<SshUtil::SshClientIdentityCandidate>> getClientIdentityCandidates(hash<auto> ctxt) {
        ++candidate_calls;
        return (<SshUtil::SshClientIdentityCandidate>{"kind": SshUtil::SshClientIdentityCandidateKind::InMemory},);
    }

    hash<SshUtil::SshPrivateKeyMaterial> getPrivateKeyMaterial(hash<auto> ctxt,
            hash<SshUtil::SshClientIdentityCandidate> candidate) {
        ++material_calls;
        return <SshUtil::SshPrivateKeyMaterial>{
            "kind": SshUtil::SshPrivateKeyMaterialKind::Text,
            "private_key_text": private_key,
            "public_key_text": public_key,
        };
    }

    int getCandidateCalls() {
        return candidate_calls;
    }

    int getMaterialCalls() {
        return material_calls;
    }
}

class RejectingHostKeyStore inherits SshUtil::AbstractSshHostKeyStore {
    hash<SshUtil::SshHostKeyDecisionInfo> verifyHostKey(hash<auto> ctxt, hash<auto> observed_key) {
        return <SshUtil::SshHostKeyDecisionInfo>{
            "decision": SshUtil::SshHostKeyDecision::Unknown,
            "observed_key": cast<hash<SshUtil::SshPublicKeyInfo>>(observed_key),
        };
    }

    hash<SshUtil::SshHostKeyDecisionInfo> acceptHostKeyIfAbsent(hash<auto> ctxt, hash<auto> observed_key) {
        return <SshUtil::SshHostKeyDecisionInfo>{
            "decision": SshUtil::SshHostKeyDecision::Unknown,
            "observed_key": cast<hash<SshUtil::SshPublicKeyInfo>>(observed_key),
        };
    }

    hash<SshUtil::SshHostKeyDecisionInfo> approveHostKey(hash<auto> ctxt, hash<auto> expected_observed_key,
            hash<auto> record) {
        return <SshUtil::SshHostKeyDecisionInfo>{
            "decision": SshUtil::SshHostKeyDecision::Unknown,
            "observed_key": cast<hash<SshUtil::SshPublicKeyInfo>>(expected_observed_key),
        };
    }
}

class LockProbeHostKeyStore inherits SshUtil::AbstractSshHostKeyStore {
    private {
        *SSH2Client client;
        int verify_calls;
        bool connected_during_verify;
        *string callback_error;
    }

    constructor(SSH2Client client) {
        self.client = client;
    }

    hash<SshUtil::SshHostKeyDecisionInfo> verifyHostKey(hash<auto> ctxt, hash<auto> observed_key) {
        ++verify_calls;
        try {
            connected_during_verify = boolean(client.connected());
        } catch (hash<ExceptionInfo> ex) {
            callback_error = sprintf("%s: %s", ex.err, ex.desc);
        }
        return <SshUtil::SshHostKeyDecisionInfo>{
            "decision": SshUtil::SshHostKeyDecision::Unknown,
            "observed_key": cast<hash<SshUtil::SshPublicKeyInfo>>(observed_key),
        };
    }

    hash<SshUtil::SshHostKeyDecisionInfo> acceptHostKeyIfAbsent(hash<auto> ctxt, hash<auto> observed_key) {
        return <SshUtil::SshHostKeyDecisionInfo>{
            "decision": SshUtil::SshHostKeyDecision::Unknown,
            "observed_key": cast<hash<SshUtil::SshPublicKeyInfo>>(observed_key),
        };
    }

    hash<SshUtil::SshHostKeyDecisionInfo> approveHostKey(hash<auto> ctxt, hash<auto> expected_observed_key,
            hash<auto> record) {
        return <SshUtil::SshHostKeyDecisionInfo>{
            "decision": SshUtil::SshHostKeyDecision::Unknown,
            "observed_key": cast<hash<SshUtil::SshPublicKeyInfo>>(expected_observed_key),
        };
    }

    int getVerifyCalls() {
        return verify_calls;
    }

    bool getConnectedDuringVerify() {
        return connected_during_verify;
    }

    *string getCallbackError() {
        return callback_error;
    }

    clearClient() {
        client = NOTHING;
    }
}

class LockProbeIdentityProvider inherits SshUtil::AbstractSshClientIdentityProvider {
    private {
        *SSH2Client client;
        string private_key;
        *string public_key;
        int candidate_calls;
        int material_calls;
        bool connected_during_candidates;
        bool connected_during_material;
        *string callback_error;
    }

    constructor(SSH2Client client, string private_key, *string public_key) {
        self.client = client;
        self.private_key = private_key;
        self.public_key = public_key;
    }

    list<hash<SshUtil::SshClientIdentityCandidate>> getClientIdentityCandidates(hash<auto> ctxt) {
        ++candidate_calls;
        try {
            connected_during_candidates = boolean(client.connected());
        } catch (hash<ExceptionInfo> ex) {
            callback_error = sprintf("%s: %s", ex.err, ex.desc);
        }
        return (<SshUtil::SshClientIdentityCandidate>{"kind": SshUtil::SshClientIdentityCandidateKind::InMemory},);
    }

    hash<SshUtil::SshPrivateKeyMaterial> getPrivateKeyMaterial(hash<auto> ctxt,
            hash<SshUtil::SshClientIdentityCandidate> candidate) {
        ++material_calls;
        try {
            connected_during_material = boolean(client.connected());
        } catch (hash<ExceptionInfo> ex) {
            callback_error = sprintf("%s: %s", ex.err, ex.desc);
        }
        return <SshUtil::SshPrivateKeyMaterial>{
            "kind": SshUtil::SshPrivateKeyMaterialKind::Text,
            "private_key_text": private_key,
            "public_key_text": public_key,
        };
    }

    int getCandidateCalls() {
        return candidate_calls;
    }

    int getMaterialCalls() {
        return material_calls;
    }

    bool getConnectedDuringCandidates() {
        return connected_during_candidates;
    }

    bool getConnectedDuringMaterial() {
        return connected_during_material;
    }

    *string getCallbackError() {
        return callback_error;
    }

    clearClient() {
        client = NOTHING;
    }
}

class Ssh2ClientTest inherits QUnit::Test {
    public {
    }

    private {
        string uri;

        timeout timeout = 10s;

        const MyOpts = Opts + {
            "privkey": "k,private-key=s",
            "timeout": "t,timeout=i",
        };

        const ColumnOffset = 25;

        const FileContents = "hi there ýčšěáýžšěčéářčě";
        const BinContents = binary(FileContents);
        const FileLen = strlen(FileContents);
        const FileMode = 0755;
        const FileNameLen = 40;
    }

    constructor() : Test("Ssh2ClientTest", "1.0", \ARGV, MyOpts) {
        if (m_options.timeout)
            timeout = m_options.timeout * 1000;
        uri = shift ARGV ?? sprintf("%s@localhost", getusername());

        addTestCase("Ssh2Client test", \ssh2ClientTest());
        addTestCase("Host key info test", \hostKeyInfoTest());
        addTestCase("Known hosts TOFU test", \knownHostsTofuTest());
        addTestCase("Known hosts reject test", \knownHostsRejectTest());
        addTestCase("Disabled default known_hosts policy test", \disabledDefaultKnownHostsPolicyTest());
        addTestCase("Secure defaults and fail-closed test", \secureDefaultsAndFailClosedTest());
        addTestCase("Known hosts TOFU creates parent dir test", \knownHostsTofuCreatesParentDirTest());
        addTestCase("Known hosts stat error fail-closed test", \knownHostsStatErrorFailClosedTest());
        addTestCase("Known hosts filesystem sandbox test", \knownHostsFilesystemSandboxTest());
        addTestCase("Client identity provider test", \clientIdentityProviderTest());
        addTestCase("Virtual host-key store no-filesystem test", \virtualHostKeyStoreNoFilesystemTest());
        addTestCase("Host key store callback lock test", \hostKeyStoreCallbackLockTest());
        addTestCase("Client identity provider callback lock test", \clientIdentityProviderCallbackLockTest());
        addTestCase("Channel PTY resize test", \channelPtyResizeTest());
        addTestCase("Channel exit signal test", \channelExitSignalTest());
        addTestCase("Algorithm query test", \algorithmQueryTest());
        addTestCase("Trace level test", \traceLevelTest());
        # Note: Parameter validation and edge case tests are in test/NegativeTests.qtest

        set_return_value(main());
    }

    ssh2ClientTest() {
        string file = get_random_string();
        string fn = tmp_location() + DirSep + file;

        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        hash info = sc.info();
        if (m_options.verbose)
            stdout.printf("SSH %s@%s:%d auth: %s, hostkey: %n, crypt_cs: %n, tmp: %s\n", info.ssh2user, info.ssh2host, info.ssh2port, info.authenticated, info.methods.HOSTKEY, info.methods.CRYPT_CS, fn);

        # test SSHClient::scpPut()
        SSH2Channel chan = sc.scpPut(fn, FileLen, 0622, 1982-01-05, 2010-02-01);
        chan.write(FileContents);
        chan.close();

        # test readBlock() from SSH2Client::scpGet()
        delete info;
        chan = sc.scpGet(fn, -1, \info);
        assertEq(FileLen, info.size);
        any str = chan.readBlock(info.size);
        assertEq(FileContents, str);

        # test readBinaryBlock() from SSH2Client::scpGet()
        delete info;
        chan = sc.scpGet(fn, -1, \info);
        binary b = chan.readBinaryBlock(info.size);
        assertEq(BinContents, b);

        chan = sc.openSessionChannel();

        chan.exec("ls -l | head -5");
        str = chan.read();
        assertEq(Type::String, str.type());

        chan.sendEof();
        chan.close();
        any rc = chan.getExitStatus();
        assertEq(Type::Int, rc.type());

        # clean up the test file via exec (deterministic, no prompt detection needed)
        {
            SSH2Channel rm_chan = sc.openSessionChannel(timeout);
            rm_chan.exec(sprintf("/bin/rm -f %s", fn));
            rm_chan.sendEof();
            rm_chan.waitEof();
            rm_chan.close();
            rm_chan.waitClosed();
        }

        # test exec with output
        {
            SSH2Channel ls_chan = sc.openSessionChannel(timeout);
            ls_chan.exec("ls -l | head -5");
            string ls_out = ls_chan.read(0, timeout);
            if (m_options.verbose > 1) {
                stdout.printf("ls output: %s\n", ls_out);
            }
            assertEq(Type::String, ls_out.type());
            ls_chan.sendEof();
            ls_chan.waitEof();
            ls_chan.close();
            ls_chan.waitClosed();
        }

        # test interactive shell session (PTY + shell)
        chan = sc.openSessionChannel(timeout);
        chan.requestPty("vt100");
        chan.shell();

        if (m_options.verbose > 1) {
            stdout.printf("=======================================\n");
            stdout.printf("---------- start SSH session ----------\n");
            stdout.printf("=======================================\n");
        }

        readUntilPrompt(chan);
        chan.write("echo hello\n");
        readUntilPrompt(chan);

        chan.sendEof();
        chan.close();
        if (m_options.verbose > 1) {
            stdout.printf("exit\n");
            stdout.printf("=======================================\n");
            stdout.printf("----------- end SSH session -----------\n");
            stdout.printf("=======================================\n");
            stdout.printf("exit status: %d\n", chan.getExitStatus());
        }
    }

    hostKeyInfoTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        hash<Ssh2HostKeyInfo> hk = sc.getHostKey();
        assertEq(Type::String, hk.hash_md5.type());
        assertTrue(hk.hash_md5 =~ /^[0-9A-F]{2}(:[0-9A-F]{2}){15}$/,
            sprintf("MD5 fingerprint format: %s", hk.hash_md5));
        assertEq(Type::String, hk.key_type.type());
        assertTrue(hk.key_type.size() > 0, "key type should not be empty");
        assertEq(Type::Binary, hk.key_data.type());
        assertTrue(hk.key_data.size() > 0, "key data should not be empty");

        if (m_options.verbose) {
            stdout.printf("Host key: type=%s md5=%s sha1=%y sha256=%y\n",
                hk.key_type, hk.hash_md5, hk.hash_sha1, hk.hash_sha256);
        }
    }

    knownHostsTofuTest() {
        string kh_file = sprintf("%s/ssh2_test_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
        }

        # Connect with TOFU policy - should auto-add host key
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
            sc.connect();

            assertEq(True, boolean(sc.connected()), "should be connected after TOFU accept");
            assertEq(True, is_file(kh_file), "known_hosts file should be created");
            sc.disconnect();
        }

        # Connect again with REJECT policy - should succeed (host key now known)
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            sc.connect();
            assertEq(True, boolean(sc.connected()), "should connect with known host key");
            sc.disconnect();
        }
    }

    knownHostsRejectTest() {
        string kh_file = sprintf("%s/ssh2_test_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
        }

        # Create empty known_hosts file
        {
            File f();
            f.open2(kh_file, O_CREAT | O_WRONLY | O_TRUNC, 0644);
        }

        # Connect with REJECT policy and empty known_hosts - should fail
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            assertThrows("SSH2-HOSTKEY-UNKNOWN", sub () {
                sc.connect();
            });
        }

        # Connect with verification disabled - should succeed regardless
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(False);
            sc.connect();
            assertEq(True, boolean(sc.connected()));
            sc.disconnect();
        }
    }

    disabledDefaultKnownHostsPolicyTest() {
        on_exit {
            SSH2Base::setDefaultKnownHostsFile();
            SSH2Base::setDefaultHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
        }

        SSH2Base::setDefaultKnownHostsFile("");

        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            assertNothing(sc.getKnownHostsFile(), "disabled default must not configure an implicit known_hosts file");
            assertTrue(sc.getVerifyHostKey(), "host key verification stays enabled when only implicit known_hosts is disabled");
            assertEq(Ssh2HostKeyPolicy::TrustOnFirstUse, sc.getHostKeyPolicy(), "persistent TOFU remains the default host key policy");
            assertThrows("SSH2-HOSTKEY-ERROR", "no known_hosts file", sub () {
                sc.connect();
            });
            assertEq(False, boolean(sc.connected()), "persistent TOFU must fail closed without a known host source");
        }

        SSH2Base::setDefaultHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUseSession);
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            assertNothing(sc.getKnownHostsFile(), "session TOFU must not re-enable an implicit known_hosts file");
            assertEq(Ssh2HostKeyPolicy::TrustOnFirstUseSession, sc.getHostKeyPolicy(),
                "new objects inherit the explicit session-only TOFU default");
            sc.connect();
            assertEq(True, boolean(sc.connected()),
                "session-only TOFU accepts the host key for this connection without an implicit known_hosts file");
            sc.disconnect();
        }

        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setHostKeyPolicy(Ssh2HostKeyPolicy::Reject);
            assertThrows("SSH2-HOSTKEY-UNKNOWN", sub () {
                sc.connect();
            });
            assertEq(False, boolean(sc.connected()), "REJECT still fails without a known host source");
        }

        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setVerifyHostKey(False);
            sc.connect();
            assertEq(True, boolean(sc.connected()), "explicitly disabled verification is the unverified bypass");
            sc.disconnect();
        }
    }

    secureDefaultsAndFailClosedTest() {
        string kh_file = sprintf("%s/ssh2_test_known_hosts_%s", tmp_location(), get_random_string(10));
        string bad_kh = sprintf("%s/ssh2_test_unreadable_kh_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
            unlink(bad_kh);
        }

        # a client with no explicit host key configuration must be secure by default:
        # verification enabled, TOFU policy; only the known_hosts path is overridden so the test
        # does not pollute the real ~/.ssh/known_hosts file
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            assertTrue(sc.getVerifyHostKey(), "host key verification must be enabled by default");
            assertEq(SSH2_HOSTKEY_TOFU, sc.getHostKeyPolicy(), "default host key policy must be TOFU");

            sc.setKnownHostsFile(kh_file);
            assertFalse(is_file(kh_file), "known_hosts file must not exist before first connect");
            sc.connect();
            assertEq(True, boolean(sc.connected()), "secure defaults must allow first connect (TOFU)");
            assertEq(True, is_file(kh_file), "TOFU on a non-existent known_hosts path must create the file");
            sc.disconnect();
        }

        # an existing known_hosts file that cannot be read must fail closed (SSH2-HOSTKEY-ERROR)
        # rather than silently connecting without host key verification; running as root bypasses
        # filesystem permission checks, so only assert this when not root
        if (getuid() != 0) {
            # create the file with mode 0000 so it exists but cannot be read
            {
                File f();
                f.open2(bad_kh, O_CREAT | O_WRONLY | O_TRUNC, 0000);
                f.write("# unreadable\n");
            }
            assertFalse(is_readable(bad_kh), "known_hosts file must be unreadable for this check");

            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(bad_kh);
            assertThrows("SSH2-HOSTKEY-ERROR", "could not be read or parsed", sub () {
                sc.connect();
            });
            assertEq(False, boolean(sc.connected()), "must not be connected after fail-closed");
        }
    }

    knownHostsTofuCreatesParentDirTest() {
        # F3: under TOFU the accepted host key MUST be persisted; on a fresh account the parent
        # directory of the known_hosts file (typically ~/.ssh) may not exist yet. The module must
        # create it (mode 0700) so the key is written - otherwise every subsequent connection is
        # again a first-use and vulnerable to a man-in-the-middle attack.
        string kh_dir = sprintf("%s/ssh2_test_khdir_%s", tmp_location(), get_random_string(10));
        string kh_file = kh_dir + "/known_hosts";
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
            if (is_dir(kh_dir)) {
                rmdir(kh_dir);
            }
        }

        assertFalse(is_dir(kh_dir), "the known_hosts parent directory must not exist before connect");

        # first connection: TOFU must create the missing parent directory and persist the key
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
            sc.connect();
            assertEq(True, boolean(sc.connected()), "TOFU must connect on first use");
            sc.disconnect();
        }

        assertEq(True, is_dir(kh_dir), "TOFU must create the missing known_hosts parent directory");
        assertEq(0700, hstat(kh_dir).mode & 0777, "the created known_hosts directory must be mode 0700");
        assertEq(True, is_file(kh_file), "TOFU must persist the host key to the known_hosts file");

        # second connection with REJECT policy: succeeds only if the key was actually persisted
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            sc.connect();
            assertEq(True, boolean(sc.connected()),
                "persisted key must satisfy a later REJECT-policy connect");
            sc.disconnect();
        }
    }

    knownHostsStatErrorFailClosedTest() {
        # F1: only ENOENT (the file genuinely does not exist) is the legitimate TOFU first-use
        # case. If stat() on the configured known_hosts file fails for any other reason - here a
        # parent directory with no search permission yields EACCES - the file may exist but be
        # inaccessible, so the module must fail closed instead of silently connecting unverified.
        # Running as root bypasses filesystem permission checks, so skip the assertion as root.
        if (getuid() == 0) {
            testSkip("cannot test EACCES fail-closed as root");
        }

        string kh_dir = sprintf("%s/ssh2_test_noexec_%s", tmp_location(), get_random_string(10));
        string kh_file = kh_dir + "/known_hosts";
        mkdir(kh_dir, 0700);
        # drop search (execute) permission so stat() on a path inside it fails with EACCES (not
        # ENOENT) - this is distinct from the unreadable-file case, which fails in readfile()
        chmod(kh_dir, 0000);
        on_exit {
            chmod(kh_dir, 0700);
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
            rmdir(kh_dir);
        }

        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.setKnownHostsFile(kh_file);
        sc.setVerifyHostKey(True);
        sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
        assertThrows("SSH2-HOSTKEY-ERROR", "could not be accessed", sub () {
            sc.connect();
        });
        assertEq(False, boolean(sc.connected()), "must not be connected after stat() fail-closed");
    }

    knownHostsFilesystemSandboxTest() {
        *string priv_key_path = getPrivateKeyPath();
        if (!priv_key_path) {
            testSkip("no private key file available for known_hosts sandbox test");
        }

        binary private_key = binary(ReadOnlyFile::readTextFile(priv_key_path));
        *binary public_key = is_file(priv_key_path + ".pub")
            ? binary(ReadOnlyFile::readTextFile(priv_key_path + ".pub"))
            : NOTHING;
        string denied_kh = sprintf("%s/ssh2_test_sandbox_denied_known_hosts_%s", tmp_location(),
            get_random_string(10));
        string allowed_kh = sprintf("%s/ssh2_test_sandbox_allowed_known_hosts_%s", tmp_location(),
            get_random_string(10));
        string nofs_kh = sprintf("%s/ssh2_test_nofs_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(denied_kh)) {
                unlink(denied_kh);
            }
            if (is_file(allowed_kh)) {
                unlink(allowed_kh);
            }
            if (is_file(nofs_kh)) {
                unlink(nofs_kh);
            }
            SSH2Base::setDefaultKnownHostsFile();
        }

        Program p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.loadModule("ssh2");
        p.parse("
            sub connect_with_known_hosts(string uri, string kh, binary priv, *binary pub) {
                SSH2Client sc(uri);
                sc.setKeysFromData(priv, pub);
                sc.setKnownHostsFile(kh);
                sc.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
                sc.connect();
                sc.disconnect();
            }

            sub add_known_host(string uri, string kh, binary priv, *binary pub) {
                SSH2Client sc(uri);
                sc.setKeysFromData(priv, pub);
                sc.setKnownHostsFile(kh);
                sc.setVerifyHostKey(False);
                sc.connect();
                sc.addKnownHost();
                sc.disconnect();
            }
        ", "known_hosts_sandbox_test");

        SandboxManager denied_sm();
        denied_sm.setFilesystemSandboxRoot("/var");
        denied_sm.setNetworkDefaultPolicy(allow: True);
        p.setSandboxManager(denied_sm);
        assertThrows("FILESYSTEM-ACCESS-DENIED", sub () {
            p.callFunction("connect_with_known_hosts", uri, denied_kh, private_key, public_key);
        });
        assertFalse(is_file(denied_kh), "denied known_hosts write must not create the file");

        assertThrows("FILESYSTEM-ACCESS-DENIED", sub () {
            p.callFunction("add_known_host", uri, denied_kh, private_key, public_key);
        });
        assertFalse(is_file(denied_kh), "denied addKnownHost() must not create the file");

        Program allowed_p(PO_NEW_STYLE | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        allowed_p.loadModule("ssh2");
        allowed_p.parse("
            sub connect_with_known_hosts(string uri, string kh, binary priv, *binary pub) {
                SSH2Client sc(uri);
                sc.setKeysFromData(priv, pub);
                sc.setKnownHostsFile(kh);
                sc.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
                sc.connect();
                sc.disconnect();
            }
        ", "known_hosts_sandbox_allowed_test");
        SandboxManager allowed_sm();
        allowed_sm.setFilesystemSandboxRoot(tmp_location());
        allowed_sm.setNetworkDefaultPolicy(allow: True);
        allowed_p.setSandboxManager(allowed_sm);
        allowed_p.callFunction("connect_with_known_hosts", uri, allowed_kh, private_key, public_key);
        assertTrue(is_file(allowed_kh), "allowed known_hosts path must be created");

        SSH2Base::setDefaultKnownHostsFile(nofs_kh);
        Program nofs_p(PO_NEW_STYLE | PO_NO_FILESYSTEM | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        nofs_p.loadModule("ssh2");
        nofs_p.parse("
            sub connect_with_default_known_hosts(string uri, binary priv, *binary pub) {
                SSH2Client sc(uri);
                sc.setKeysFromData(priv, pub);
                sc.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
                sc.connect();
                sc.disconnect();
            }
        ", "known_hosts_nofs_test");
        assertThrows("ILLEGAL-FILESYSTEM-ACCESS", "PO_NO_FILESYSTEM", sub () {
            nofs_p.callFunction("connect_with_default_known_hosts", uri, private_key, public_key);
        });
        assertFalse(is_file(nofs_kh), "PO_NO_FILESYSTEM known_hosts write must not create the file");
    }

    clientIdentityProviderTest() {
        *string priv_key_path = getPrivateKeyPath();
        if (!priv_key_path) {
            testSkip("no private key file available for client identity provider test");
        }

        string private_key = ReadOnlyFile::readTextFile(priv_key_path);
        *string public_key = is_file(priv_key_path + ".pub")
            ? ReadOnlyFile::readTextFile(priv_key_path + ".pub")
            : NOTHING;
        string kh_file = sprintf("%s/ssh2_test_provider_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
        }

        # Host-key verification must fail before the identity provider is consulted for secrets.
        {
            TestMemoryIdentityProvider provider(private_key, public_key);
            RejectingHostKeyStore store();
            SSH2Client sc(uri);
            sc.setClientIdentityProvider(provider);
            sc.setHostKeyStore(store);
            sc.setHostKeyPolicy(Ssh2HostKeyPolicy::Reject);
            assertThrows("SSH2-HOSTKEY-UNKNOWN", sub () {
                sc.connect();
            });
            assertEq(0, provider.getCandidateCalls(),
                "client identity provider must not be called before host-key verification succeeds");
            assertEq(0, provider.getMaterialCalls(),
                "private key material must not be requested before host-key verification succeeds");
        }

        # With a provider configured and fallback disabled, authentication must use the provider
        # candidate and not the constructor's auto-discovered default key path.
        {
            TestMemoryIdentityProvider provider(private_key, public_key);
            SSH2Client sc(uri);
            sc.setClientIdentityProvider(provider);
            sc.setClientIdentityFallbackPolicy(Ssh2ClientIdentityFallbackPolicy::Disabled);
            sc.setKnownHostsFile(kh_file);
            sc.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
            sc.connect();
            assertEq(True, boolean(sc.connected()), "provider-backed client identity should authenticate");
            assertEq("publickey", sc.getAuthenticatedWith());
            assertEq(1, provider.getCandidateCalls(), "provider should be consulted once for the connection");
            assertEq(1, provider.getMaterialCalls(), "private key material should be requested at point of use");
            sc.disconnect();
        }
    }

    virtualHostKeyStoreNoFilesystemTest() {
        *string priv_key_path = getPrivateKeyPath();
        if (!priv_key_path) {
            testSkip("no private key file available for virtual host-key store no-filesystem test");
        }

        string private_key = ReadOnlyFile::readTextFile(priv_key_path);
        *string public_key = is_file(priv_key_path + ".pub")
            ? ReadOnlyFile::readTextFile(priv_key_path + ".pub")
            : NOTHING;

        Program p(PO_NEW_STYLE | PO_NO_FILESYSTEM | PO_STRICT_ARGS | PO_REQUIRE_TYPES);
        p.loadModule("ssh2");
        p.loadModule("sshutil");
        p.parse("
            class MemoryIdentityProvider inherits SshUtil::AbstractSshClientIdentityProvider {
                private {
                    string private_key;
                    *string public_key;
                    int candidate_calls;
                    int material_calls;
                }

                constructor(string private_key, *string public_key) {
                    self.private_key = private_key;
                    self.public_key = public_key;
                    candidate_calls = 0;
                    material_calls = 0;
                }

                list<hash<SshUtil::SshClientIdentityCandidate>> getClientIdentityCandidates(hash<auto> ctxt) {
                    ++candidate_calls;
                    return (<SshUtil::SshClientIdentityCandidate>{
                        \"kind\": SshUtil::SshClientIdentityCandidateKind::InMemory,
                    },);
                }

                hash<SshUtil::SshPrivateKeyMaterial> getPrivateKeyMaterial(hash<auto> ctxt,
                        hash<SshUtil::SshClientIdentityCandidate> candidate) {
                    ++material_calls;
                    return <SshUtil::SshPrivateKeyMaterial>{
                        \"kind\": SshUtil::SshPrivateKeyMaterialKind::Text,
                        \"private_key_text\": private_key,
                        \"public_key_text\": public_key,
                    };
                }

                int getCandidateCalls() {
                    return candidate_calls;
                }

                int getMaterialCalls() {
                    return material_calls;
                }
            }

            class MemoryHostKeyStore inherits SshUtil::AbstractSshHostKeyStore {
                private {
                    string mode;
                    *hash<SshUtil::SshPublicKeyInfo> stored_key;
                    int verify_calls;
                    int accept_calls;
                }

                constructor(string mode = \"stateful\") {
                    self.mode = mode;
                    verify_calls = 0;
                    accept_calls = 0;
                }

                private bool keysMatch(hash<auto> left, hash<auto> right) {
                    return left.algorithm == right.algorithm && left.public_key_blob == right.public_key_blob;
                }

                private hash<SshUtil::SshHostKeyDecisionInfo> makeDecision(
                        enum<SshUtil::SshHostKeyDecision> decision, hash<auto> observed_key) {
                    return <SshUtil::SshHostKeyDecisionInfo>{
                        \"decision\": decision,
                        \"observed_key\": cast<hash<SshUtil::SshPublicKeyInfo>>(observed_key),
                    };
                }

                hash<SshUtil::SshHostKeyDecisionInfo> verifyHostKey(hash<auto> ctxt, hash<auto> observed_key) {
                    ++verify_calls;
                    if (mode == \"throw\") {
                        throw \"TEST-HOSTKEY-STORE-ERROR\", \"host-key store failure\";
                    }
                    if (mode == \"revoked\") {
                        return makeDecision(SshUtil::SshHostKeyDecision::Revoked, observed_key);
                    }
                    if (mode == \"accepted-session\") {
                        return makeDecision(SshUtil::SshHostKeyDecision::AcceptedSession, observed_key);
                    }
                    if (stored_key && keysMatch(stored_key, observed_key)) {
                        return makeDecision(SshUtil::SshHostKeyDecision::Matched, observed_key);
                    }
                    return makeDecision(SshUtil::SshHostKeyDecision::Unknown, observed_key);
                }

                hash<SshUtil::SshHostKeyDecisionInfo> acceptHostKeyIfAbsent(hash<auto> ctxt,
                        hash<auto> observed_key) {
                    ++accept_calls;
                    if (mode == \"stateful\") {
                        stored_key = cast<hash<SshUtil::SshPublicKeyInfo>>(observed_key);
                        return makeDecision(SshUtil::SshHostKeyDecision::Added, observed_key);
                    }
                    return makeDecision(SshUtil::SshHostKeyDecision::Unknown, observed_key);
                }

                hash<SshUtil::SshHostKeyDecisionInfo> approveHostKey(hash<auto> ctxt,
                        hash<auto> expected_observed_key, hash<auto> record) {
                    return makeDecision(SshUtil::SshHostKeyDecision::AcceptedSession, expected_observed_key);
                }

                int getVerifyCalls() {
                    return verify_calls;
                }

                int getAcceptCalls() {
                    return accept_calls;
                }

                bool hasStoredKey() {
                    return boolean(stored_key);
                }
            }

            hash<auto> sub connect_with_virtual_store(string uri, string priv, *string pub) {
                MemoryIdentityProvider provider(priv, pub);
                MemoryHostKeyStore store();

                SSH2Client first(uri);
                first.setHostKeyStore(store);
                first.setClientIdentityProvider(provider);
                first.setClientIdentityFallbackPolicy(Ssh2ClientIdentityFallbackPolicy::Disabled);
                first.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
                *string first_kh = first.getKnownHostsFile();
                first.connect();
                bool first_connected = boolean(first.connected());
                first.disconnect();

                SSH2Client second(uri);
                second.setHostKeyStore(store);
                second.setClientIdentityProvider(provider);
                second.setClientIdentityFallbackPolicy(Ssh2ClientIdentityFallbackPolicy::Disabled);
                second.setHostKeyPolicy(Ssh2HostKeyPolicy::Reject);
                *string second_kh = second.getKnownHostsFile();
                second.connect();
                bool second_connected = boolean(second.connected());
                second.disconnect();

                return {
                    \"first_connected\": first_connected,
                    \"second_connected\": second_connected,
                    \"first_known_hosts\": first_kh,
                    \"second_known_hosts\": second_kh,
                    \"stored\": store.hasStoredKey(),
                    \"verify_calls\": store.getVerifyCalls(),
                    \"accept_calls\": store.getAcceptCalls(),
                    \"candidate_calls\": provider.getCandidateCalls(),
                    \"material_calls\": provider.getMaterialCalls(),
                };
            }

            hash<auto> sub fail_before_identity(string uri, string priv, *string pub, string mode) {
                MemoryIdentityProvider provider(priv, pub);
                MemoryHostKeyStore store(mode);
                SSH2Client sc(uri);
                sc.setHostKeyStore(store);
                sc.setClientIdentityProvider(provider);
                sc.setClientIdentityFallbackPolicy(Ssh2ClientIdentityFallbackPolicy::Disabled);
                sc.setHostKeyPolicy(Ssh2HostKeyPolicy::Reject);
                try {
                    sc.connect();
                } catch (hash<ExceptionInfo> ex) {
                    return {
                        \"err\": ex.err,
                        \"known_hosts\": sc.getKnownHostsFile(),
                        \"verify_calls\": store.getVerifyCalls(),
                        \"accept_calls\": store.getAcceptCalls(),
                        \"candidate_calls\": provider.getCandidateCalls(),
                        \"material_calls\": provider.getMaterialCalls(),
                    };
                }
                throw \"TEST-ERROR\", \"expected host-key store failure\";
            }
        ", "virtual_hostkey_store_nofs_test");

        hash<auto> result = p.callFunction("connect_with_virtual_store", uri, private_key, public_key);
        assertTrue(result.first_connected, "first virtual-store TOFU connection must succeed");
        assertTrue(result.second_connected, "second virtual-store match connection must succeed");
        assertNothing(result.first_known_hosts, "PO_NO_FILESYSTEM virtual store must not use known_hosts");
        assertNothing(result.second_known_hosts, "PO_NO_FILESYSTEM virtual store must not use known_hosts");
        assertTrue(result.stored, "virtual store must retain the accepted host key");
        assertEq(2, result.verify_calls, "virtual store must verify both connections");
        assertEq(1, result.accept_calls, "virtual store must accept only the first unknown host key");
        assertEq(2, result.candidate_calls, "identity provider must be consulted once per connection");
        assertEq(2, result.material_calls, "identity provider must supply key material once per connection");

        hash<auto> unknown = p.callFunction("fail_before_identity", uri, private_key, public_key, "stateful");
        assertEq("SSH2-HOSTKEY-UNKNOWN", unknown.err);
        assertNothing(unknown.known_hosts);
        assertEq(1, unknown.verify_calls);
        assertEq(0, unknown.accept_calls);
        assertEq(0, unknown.candidate_calls);
        assertEq(0, unknown.material_calls);

        hash<auto> revoked = p.callFunction("fail_before_identity", uri, private_key, public_key, "revoked");
        assertEq("SSH2-HOSTKEY-REVOKED", revoked.err);
        assertEq(1, revoked.verify_calls);
        assertEq(0, revoked.accept_calls);
        assertEq(0, revoked.candidate_calls);
        assertEq(0, revoked.material_calls);

        hash<auto> thrown = p.callFunction("fail_before_identity", uri, private_key, public_key, "throw");
        assertEq("SSH2-HOSTKEY-PROVIDER-ERROR", thrown.err);
        assertEq(1, thrown.verify_calls);
        assertEq(0, thrown.accept_calls);
        assertEq(0, thrown.candidate_calls);
        assertEq(0, thrown.material_calls);
    }

    hostKeyStoreCallbackLockTest() {
        SSH2Client sc(uri);
        LockProbeHostKeyStore store(sc);
        sc.setHostKeyStore(store);
        sc.setHostKeyPolicy(Ssh2HostKeyPolicy::Reject);
        on_exit {
            sc.setHostKeyStore(NOTHING);
            store.clearClient();
        }

        assertThrows("SSH2-HOSTKEY-UNKNOWN", sub () {
            sc.connect();
        });
        assertEq(1, store.getVerifyCalls(), "host-key store must be called exactly once");
        assertNothing(store.getCallbackError(), "host-key store callback same-client call must not throw");
        assertFalse(store.getConnectedDuringVerify(),
            "same-client connected() call from a host-key store callback must not see a completed connection");
    }

    clientIdentityProviderCallbackLockTest() {
        *string priv_key_path = getPrivateKeyPath();
        if (!priv_key_path) {
            testSkip("no private key file available for client identity provider callback lock test");
        }

        string private_key = ReadOnlyFile::readTextFile(priv_key_path);
        *string public_key = is_file(priv_key_path + ".pub")
            ? ReadOnlyFile::readTextFile(priv_key_path + ".pub")
            : NOTHING;
        string kh_file = sprintf("%s/ssh2_test_provider_lock_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
        }

        SSH2Client sc(uri);
        LockProbeIdentityProvider provider(sc, private_key, public_key);
        sc.setClientIdentityProvider(provider);
        sc.setClientIdentityFallbackPolicy(Ssh2ClientIdentityFallbackPolicy::Disabled);
        sc.setKnownHostsFile(kh_file);
        sc.setHostKeyPolicy(Ssh2HostKeyPolicy::TrustOnFirstUse);
        sc.connect();
        sc.disconnect();
        sc.setClientIdentityProvider(NOTHING);
        provider.clearClient();

        assertEq(1, provider.getCandidateCalls(), "identity provider must be called exactly once");
        assertEq(1, provider.getMaterialCalls(), "identity provider material lookup must be called exactly once");
        assertNothing(provider.getCallbackError(), "identity provider callback same-client calls must not throw");
        assertFalse(provider.getConnectedDuringCandidates(),
            "same-client connected() call from candidate callback must not see a completed connection");
        assertFalse(provider.getConnectedDuringMaterial(),
            "same-client connected() call from material callback must not see a completed connection");
    }

    channelPtyResizeTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        SSH2Channel chan = sc.openSessionChannel(timeout);
        chan.requestPty("xterm", "", 80, 24);
        chan.shell();

        readUntilPrompt(chan);

        # resize PTY - should not throw
        chan.requestPtySize(120, 40);

        chan.write("echo resized\n");
        readUntilPrompt(chan);

        chan.sendEof();
        chan.close();
    }

    channelExitSignalTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        # run a command that exits normally
        SSH2Channel chan = sc.openSessionChannel(timeout);
        chan.exec("true");
        chan.sendEof();
        chan.waitEof();
        chan.close();
        chan.waitClosed();

        assertEq(0, chan.getExitStatus());

        # test getExitSignal - may or may not have signal info depending on how process exited
        try {
            hash<Ssh2ExitSignalInfo> sig = chan.getExitSignal();
            # normal exit should have no signal
            assertNothing(sig.signal);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "MISSING-FEATURE-ERROR") {
                testSkip("getExitSignal not supported by this build");
            } else {
                rethrow;
            }
        }
    }

    algorithmQueryTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);

        # query supported algorithms before connect
        list<string> kex_algs = sc.getSupportedAlgorithms("KEX");
        assertGt(0, kex_algs.size(), "KEX algorithms should be non-empty");

        list<string> hostkey_algs = sc.getSupportedAlgorithms("HOSTKEY");
        assertGt(0, hostkey_algs.size(), "HOSTKEY algorithms should be non-empty");

        # set a method preference using an algorithm we know is supported
        sc.setMethodPreference("KEX", kex_algs[0]);

        sc.connect();

        # verify connected and algorithm info is available
        hash<Ssh2ConnectionInfo> info = sc.info();
        assertEq(True, boolean(info.connected));
        assertGt(0, info.methods.size());

        if (m_options.verbose) {
            stdout.printf("Negotiated methods: %N\n", info.methods);
        }

        sc.disconnect();
    }

    traceLevelTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);

        # setTraceLevel should fail when not connected
        assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
            sc.setTraceLevel(SSH2_TRACE_AUTH);
        });

        sc.connect();

        # setTraceLevel should work when connected (output goes to stderr)
        sc.setTraceLevel(SSH2_TRACE_ERROR);

        # disable tracing
        sc.setTraceLevel(0);

        sc.disconnect();
    }

    private *string getPrivateKeyPath() {
        if (m_options.privkey) {
            return m_options.privkey;
        }
        if (PlatformOS == "Windows") {
            return NOTHING;
        }

        string sshdir = ENV.HOME + "/.ssh";
        if (is_file(sshdir + "/id_rsa")) {
            return sshdir + "/id_rsa";
        }
        if (is_file(sshdir + "/id_dsa")) {
            return sshdir + "/id_dsa";
        }
        return NOTHING;
    }

    private setPrivateKey(SSH2Client client) {
        *string priv_key_path = getPrivateKeyPath();
        if (priv_key_path) {
            client.setKeys(priv_key_path);
        }
    }

    # read channel until a prompt is recognized
    private readUntilPrompt(SSH2Channel chan) {
        string buf;
        do {
            # read with a 10 second timeout
            string str = chan.read(0, 10s);
            if (m_options.verbose > 1) {
                stdout.printf("%s", str);
                stdout.sync();
            }
            buf += str;
            # Strip ANSI escape sequences before checking for prompt;
            # PTY output includes cursor positioning, color codes, and
            # bracketed paste mode sequences that appear after the prompt
            string clean = regex_subst(buf, "\x1b\\[[0-9;?]*[a-zA-Z]", "", RE_Global);
            clean = regex_subst(clean, "\x1b\\][^\x07]*\x07", "", RE_Global);
            clean = regex_subst(clean, "\x1b[^\\[].?", "", RE_Global);
            if (clean =~ /[\#\$\%\>] */) {
                break;
            }
        } while (True);
    }

    private usageIntern() {
        TestReporter::usageIntern(ColumnOffset);
        printOption("-k,--private-key=ARG", "set private key to use for authentication", ColumnOffset);
        printOption("-t,--timeout=ARG", sprintf("set timeout in seconds (def: %ds)", timeout / 1000), ColumnOffset);
    }
}
