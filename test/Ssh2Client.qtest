#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires qore >= 0.8.12
%requires ssh2 >= 2.0

%requires Util
%requires QUnit

%exec-class Ssh2ClientTest

class Ssh2ClientTest inherits QUnit::Test {
    public {
    }

    private {
        string uri;

        timeout timeout = 10s;

        const MyOpts = Opts + {
            "privkey": "k,private-key=s",
            "timeout": "t,timeout=i",
        };

        const ColumnOffset = 25;

        const FileContents = "hi there ýčšěáýžšěčéářčě";
        const BinContents = binary(FileContents);
        const FileLen = strlen(FileContents);
        const FileMode = 0755;
        const FileNameLen = 40;
    }

    constructor() : Test("Ssh2ClientTest", "1.0", \ARGV, MyOpts) {
        if (m_options.timeout)
            timeout = m_options.timeout * 1000;
        uri = shift ARGV ?? sprintf("%s@localhost", getusername());

        addTestCase("Ssh2Client test", \ssh2ClientTest());
        addTestCase("Host key info test", \hostKeyInfoTest());
        addTestCase("Known hosts TOFU test", \knownHostsTofuTest());
        addTestCase("Known hosts reject test", \knownHostsRejectTest());
        addTestCase("Secure defaults and fail-closed test", \secureDefaultsAndFailClosedTest());
        addTestCase("Known hosts TOFU creates parent dir test", \knownHostsTofuCreatesParentDirTest());
        addTestCase("Known hosts stat error fail-closed test", \knownHostsStatErrorFailClosedTest());
        addTestCase("Channel PTY resize test", \channelPtyResizeTest());
        addTestCase("Channel exit signal test", \channelExitSignalTest());
        addTestCase("Algorithm query test", \algorithmQueryTest());
        addTestCase("Trace level test", \traceLevelTest());
        # Note: Parameter validation and edge case tests are in test/NegativeTests.qtest

        set_return_value(main());
    }

    ssh2ClientTest() {
        string file = get_random_string();
        string fn = tmp_location() + DirSep + file;

        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        hash info = sc.info();
        if (m_options.verbose)
            stdout.printf("SSH %s@%s:%d auth: %s, hostkey: %n, crypt_cs: %n, tmp: %s\n", info.ssh2user, info.ssh2host, info.ssh2port, info.authenticated, info.methods.HOSTKEY, info.methods.CRYPT_CS, fn);

        # test SSHClient::scpPut()
        SSH2Channel chan = sc.scpPut(fn, FileLen, 0622, 1982-01-05, 2010-02-01);
        chan.write(FileContents);
        chan.close();

        # test readBlock() from SSH2Client::scpGet()
        delete info;
        chan = sc.scpGet(fn, -1, \info);
        assertEq(FileLen, info.size);
        any str = chan.readBlock(info.size);
        assertEq(FileContents, str);

        # test readBinaryBlock() from SSH2Client::scpGet()
        delete info;
        chan = sc.scpGet(fn, -1, \info);
        binary b = chan.readBinaryBlock(info.size);
        assertEq(BinContents, b);

        chan = sc.openSessionChannel();

        chan.exec("ls -l | head -5");
        str = chan.read();
        assertEq(Type::String, str.type());

        chan.sendEof();
        chan.close();
        any rc = chan.getExitStatus();
        assertEq(Type::Int, rc.type());

        # clean up the test file via exec (deterministic, no prompt detection needed)
        {
            SSH2Channel rm_chan = sc.openSessionChannel(timeout);
            rm_chan.exec(sprintf("/bin/rm -f %s", fn));
            rm_chan.sendEof();
            rm_chan.waitEof();
            rm_chan.close();
            rm_chan.waitClosed();
        }

        # test exec with output
        {
            SSH2Channel ls_chan = sc.openSessionChannel(timeout);
            ls_chan.exec("ls -l | head -5");
            string ls_out = ls_chan.read(0, timeout);
            if (m_options.verbose > 1) {
                stdout.printf("ls output: %s\n", ls_out);
            }
            assertEq(Type::String, ls_out.type());
            ls_chan.sendEof();
            ls_chan.close();
            ls_chan.waitClosed();
        }

        # test interactive shell session (PTY + shell)
        chan = sc.openSessionChannel(timeout);
        chan.requestPty("vt100");
        chan.shell();

        if (m_options.verbose > 1) {
            stdout.printf("=======================================\n");
            stdout.printf("---------- start SSH session ----------\n");
            stdout.printf("=======================================\n");
        }

        readUntilPrompt(chan);
        chan.write("echo hello\n");
        readUntilPrompt(chan);

        chan.sendEof();
        chan.close();
        if (m_options.verbose > 1) {
            stdout.printf("exit\n");
            stdout.printf("=======================================\n");
            stdout.printf("----------- end SSH session -----------\n");
            stdout.printf("=======================================\n");
            stdout.printf("exit status: %d\n", chan.getExitStatus());
        }
    }

    hostKeyInfoTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        hash<Ssh2HostKeyInfo> hk = sc.getHostKey();
        assertEq(Type::String, hk.hash_md5.type());
        assertTrue(hk.hash_md5 =~ /^[0-9A-F]{2}(:[0-9A-F]{2}){15}$/,
            sprintf("MD5 fingerprint format: %s", hk.hash_md5));
        assertEq(Type::String, hk.key_type.type());
        assertTrue(hk.key_type.size() > 0, "key type should not be empty");
        assertEq(Type::Binary, hk.key_data.type());
        assertTrue(hk.key_data.size() > 0, "key data should not be empty");

        if (m_options.verbose) {
            stdout.printf("Host key: type=%s md5=%s sha1=%y sha256=%y\n",
                hk.key_type, hk.hash_md5, hk.hash_sha1, hk.hash_sha256);
        }
    }

    knownHostsTofuTest() {
        string kh_file = sprintf("%s/ssh2_test_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
        }

        # Connect with TOFU policy - should auto-add host key
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
            sc.connect();

            assertEq(True, boolean(sc.connected()), "should be connected after TOFU accept");
            assertEq(True, is_file(kh_file), "known_hosts file should be created");
            sc.disconnect();
        }

        # Connect again with REJECT policy - should succeed (host key now known)
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            sc.connect();
            assertEq(True, boolean(sc.connected()), "should connect with known host key");
            sc.disconnect();
        }
    }

    knownHostsRejectTest() {
        string kh_file = sprintf("%s/ssh2_test_known_hosts_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
        }

        # Create empty known_hosts file
        {
            File f();
            f.open2(kh_file, O_CREAT | O_WRONLY | O_TRUNC, 0644);
        }

        # Connect with REJECT policy and empty known_hosts - should fail
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            assertThrows("SSH2-HOSTKEY-UNKNOWN", sub () {
                sc.connect();
            });
        }

        # Connect with verification disabled - should succeed regardless
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(False);
            sc.connect();
            assertEq(True, boolean(sc.connected()));
            sc.disconnect();
        }
    }

    secureDefaultsAndFailClosedTest() {
        string kh_file = sprintf("%s/ssh2_test_known_hosts_%s", tmp_location(), get_random_string(10));
        string bad_kh = sprintf("%s/ssh2_test_unreadable_kh_%s", tmp_location(), get_random_string(10));
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
            unlink(bad_kh);
        }

        # a client with no explicit host key configuration must be secure by default:
        # verification enabled, TOFU policy; only the known_hosts path is overridden so the test
        # does not pollute the real ~/.ssh/known_hosts file
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            assertTrue(sc.getVerifyHostKey(), "host key verification must be enabled by default");
            assertEq(SSH2_HOSTKEY_TOFU, sc.getHostKeyPolicy(), "default host key policy must be TOFU");

            sc.setKnownHostsFile(kh_file);
            assertFalse(is_file(kh_file), "known_hosts file must not exist before first connect");
            sc.connect();
            assertEq(True, boolean(sc.connected()), "secure defaults must allow first connect (TOFU)");
            assertEq(True, is_file(kh_file), "TOFU on a non-existent known_hosts path must create the file");
            sc.disconnect();
        }

        # an existing known_hosts file that cannot be read must fail closed (SSH2-HOSTKEY-ERROR)
        # rather than silently connecting without host key verification; running as root bypasses
        # filesystem permission checks, so only assert this when not root
        if (getuid() != 0) {
            # create the file with mode 0000 so it exists but cannot be read
            {
                File f();
                f.open2(bad_kh, O_CREAT | O_WRONLY | O_TRUNC, 0000);
                f.write("# unreadable\n");
            }
            assertFalse(is_readable(bad_kh), "known_hosts file must be unreadable for this check");

            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(bad_kh);
            assertThrows("SSH2-HOSTKEY-ERROR", "could not be read or parsed", sub () {
                sc.connect();
            });
            assertEq(False, boolean(sc.connected()), "must not be connected after fail-closed");
        }
    }

    knownHostsTofuCreatesParentDirTest() {
        # F3: under TOFU the accepted host key MUST be persisted; on a fresh account the parent
        # directory of the known_hosts file (typically ~/.ssh) may not exist yet. The module must
        # create it (mode 0700) so the key is written - otherwise every subsequent connection is
        # again a first-use and vulnerable to a man-in-the-middle attack.
        string kh_dir = sprintf("%s/ssh2_test_khdir_%s", tmp_location(), get_random_string(10));
        string kh_file = kh_dir + "/known_hosts";
        on_exit {
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
            if (is_dir(kh_dir)) {
                rmdir(kh_dir);
            }
        }

        assertFalse(is_dir(kh_dir), "the known_hosts parent directory must not exist before connect");

        # first connection: TOFU must create the missing parent directory and persist the key
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
            sc.connect();
            assertEq(True, boolean(sc.connected()), "TOFU must connect on first use");
            sc.disconnect();
        }

        assertEq(True, is_dir(kh_dir), "TOFU must create the missing known_hosts parent directory");
        assertEq(0700, hstat(kh_dir).mode & 0777, "the created known_hosts directory must be mode 0700");
        assertEq(True, is_file(kh_file), "TOFU must persist the host key to the known_hosts file");

        # second connection with REJECT policy: succeeds only if the key was actually persisted
        {
            SSH2Client sc(uri);
            setPrivateKey(sc);
            sc.setKnownHostsFile(kh_file);
            sc.setVerifyHostKey(True);
            sc.setHostKeyPolicy(SSH2_HOSTKEY_REJECT);
            sc.connect();
            assertEq(True, boolean(sc.connected()),
                "persisted key must satisfy a later REJECT-policy connect");
            sc.disconnect();
        }
    }

    knownHostsStatErrorFailClosedTest() {
        # F1: only ENOENT (the file genuinely does not exist) is the legitimate TOFU first-use
        # case. If stat() on the configured known_hosts file fails for any other reason - here a
        # parent directory with no search permission yields EACCES - the file may exist but be
        # inaccessible, so the module must fail closed instead of silently connecting unverified.
        # Running as root bypasses filesystem permission checks, so skip the assertion as root.
        if (getuid() == 0) {
            testSkip("cannot test EACCES fail-closed as root");
        }

        string kh_dir = sprintf("%s/ssh2_test_noexec_%s", tmp_location(), get_random_string(10));
        string kh_file = kh_dir + "/known_hosts";
        mkdir(kh_dir, 0700);
        # drop search (execute) permission so stat() on a path inside it fails with EACCES (not
        # ENOENT) - this is distinct from the unreadable-file case, which fails in readfile()
        chmod(kh_dir, 0000);
        on_exit {
            chmod(kh_dir, 0700);
            if (is_file(kh_file)) {
                unlink(kh_file);
            }
            rmdir(kh_dir);
        }

        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.setKnownHostsFile(kh_file);
        sc.setVerifyHostKey(True);
        sc.setHostKeyPolicy(SSH2_HOSTKEY_TOFU);
        assertThrows("SSH2-HOSTKEY-ERROR", "could not be accessed", sub () {
            sc.connect();
        });
        assertEq(False, boolean(sc.connected()), "must not be connected after stat() fail-closed");
    }

    channelPtyResizeTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        SSH2Channel chan = sc.openSessionChannel(timeout);
        chan.requestPty("xterm", "", 80, 24);
        chan.shell();

        readUntilPrompt(chan);

        # resize PTY - should not throw
        chan.requestPtySize(120, 40);

        chan.write("echo resized\n");
        readUntilPrompt(chan);

        chan.sendEof();
        chan.close();
    }

    channelExitSignalTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);
        sc.connect();

        # run a command that exits normally
        SSH2Channel chan = sc.openSessionChannel(timeout);
        chan.exec("true");
        chan.sendEof();
        chan.waitEof();
        chan.close();
        chan.waitClosed();

        assertEq(0, chan.getExitStatus());

        # test getExitSignal - may or may not have signal info depending on how process exited
        try {
            hash<Ssh2ExitSignalInfo> sig = chan.getExitSignal();
            # normal exit should have no signal
            assertNothing(sig.signal);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "MISSING-FEATURE-ERROR") {
                testSkip("getExitSignal not supported by this build");
            } else {
                rethrow;
            }
        }
    }

    algorithmQueryTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);

        # query supported algorithms before connect
        list<string> kex_algs = sc.getSupportedAlgorithms("KEX");
        assertGt(0, kex_algs.size(), "KEX algorithms should be non-empty");

        list<string> hostkey_algs = sc.getSupportedAlgorithms("HOSTKEY");
        assertGt(0, hostkey_algs.size(), "HOSTKEY algorithms should be non-empty");

        # set a method preference using an algorithm we know is supported
        sc.setMethodPreference("KEX", kex_algs[0]);

        sc.connect();

        # verify connected and algorithm info is available
        hash<Ssh2ConnectionInfo> info = sc.info();
        assertEq(True, boolean(info.connected));
        assertGt(0, info.methods.size());

        if (m_options.verbose) {
            stdout.printf("Negotiated methods: %N\n", info.methods);
        }

        sc.disconnect();
    }

    traceLevelTest() {
        SSH2Client sc(uri);
        setPrivateKey(sc);

        # setTraceLevel should fail when not connected
        assertThrows("SSH2CLIENT-NOT-CONNECTED", sub () {
            sc.setTraceLevel(SSH2_TRACE_AUTH);
        });

        sc.connect();

        # setTraceLevel should work when connected (output goes to stderr)
        sc.setTraceLevel(SSH2_TRACE_ERROR);

        # disable tracing
        sc.setTraceLevel(0);

        sc.disconnect();
    }

    private setPrivateKey(SSH2Client client) {
        if (m_options.privkey) {
            client.setKeys(m_options.privkey);
            return;
        }
        if (PlatformOS == "Windows")
            exit(0);

        string sshdir = ENV.HOME + "/.ssh";
        if (is_file(sshdir + "/id_rsa"))
            client.setKeys(sshdir + "/id_rsa");
        else if (is_file(sshdir + "/id_dsa"))
            client.setKeys(sshdir + "/id_dsa");
    }

    # read channel until a prompt is recognized
    private readUntilPrompt(SSH2Channel chan) {
        string buf;
        do {
            # read with a 10 second timeout
            string str = chan.read(0, 10s);
            if (m_options.verbose > 1) {
                stdout.printf("%s", str);
                stdout.sync();
            }
            buf += str;
            # Strip ANSI escape sequences before checking for prompt;
            # PTY output includes cursor positioning, color codes, and
            # bracketed paste mode sequences that appear after the prompt
            string clean = regex_subst(buf, "\x1b\\[[0-9;?]*[a-zA-Z]", "", RE_Global);
            clean = regex_subst(clean, "\x1b\\][^\x07]*\x07", "", RE_Global);
            clean = regex_subst(clean, "\x1b[^\\[].?", "", RE_Global);
            if (clean =~ /[\#\$\%\>] */) {
                break;
            }
        } while (True);
    }

    private usageIntern() {
        TestReporter::usageIntern(ColumnOffset);
        printOption("-k,--private-key=ARG", "set private key to use for authentication", ColumnOffset);
        printOption("-t,--timeout=ARG", sprintf("set timeout in seconds (def: %ds)", timeout / 1000), ColumnOffset);
    }
}
